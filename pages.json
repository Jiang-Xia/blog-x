				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/notify/notify",
			"style": {
				"navigationBarTitleText": "消息中心",
				"disableScroll": true
			}
		},
		{
			"path": "pages-dev/icons/index",
			"style": {
				"navigationBarTitleText": "图标库",
				"disableScroll": true
			}
		}
