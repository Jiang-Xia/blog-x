{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^x-(.*)": "@/components/x-$1/x-$1.uvue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"navigationStyle": "custom",
				"disableScroll": true
			}
		},
		{
			"path": "pages/discover/discover",
			"style": {
				"navigationBarTitleText": "发现",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/rpg/entry",
			"style": {
				"navigationBarTitleText": "冒险",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/me/me",
			"style": {
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/search/search",
			"style": {
				"navigationBarTitleText": "搜索"
			}
		},
		{
			"path": "pages/detail/detail",
			"style": {
				"navigationBarTitleText": "文章"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			"path": "pages/notify/notify",
			"style": {
				"navigationBarTitleText": "消息中心"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages-blog",
			"pages": [
				{
					"path": "index/index",
					"style": {
						"navigationBarTitleText": "博客分包"
					}
				},
				{
					"path": "archives/index",
					"style": {
						"navigationBarTitleText": "归档"
					}
				},
				{
					"path": "guestbook/index",
					"style": {
						"navigationBarTitleText": "留言板"
					}
				},
				{
					"path": "links/index",
					"style": {
						"navigationBarTitleText": "友情链接"
					}
				},
				{
					"path": "favorites/index",
					"style": {
						"navigationBarTitleText": "我的收藏"
					}
				},
				{
					"path": "inbox/index",
					"style": {
						"navigationBarTitleText": "评论收件箱"
					}
				},
				{
					"path": "profile/index",
					"style": {
						"navigationBarTitleText": "公开主页"
					}
				},
				{
					"path": "audit/index",
					"style": {
						"navigationBarTitleText": "审核台"
					}
				},
				{
					"path": "ai/index",
					"style": {
						"navigationBarTitleText": "AI 助手"
					}
				},
				{
					"path": "tags/index",
					"style": {
						"navigationBarTitleText": "标签墙"
					}
				}
			]
		},
		{
			"root": "pages-rpg",
			"pages": [
				{
					"path": "index/index",
					"style": {
						"navigationBarTitleText": "冒险中心",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "lottery/index",
					"style": {
						"navigationBarTitleText": "幸运抽奖"
					}
				},
				{
					"path": "rank/index",
					"style": {
						"navigationBarTitleText": "排行榜"
					}
				},
				{
					"path": "calendar/index",
					"style": {
						"navigationBarTitleText": "签到日历"
					}
				},
				{
					"path": "recharge/index",
					"style": {
						"navigationBarTitleText": "钻石充值"
					}
				}
			]
		},
		{
			"root": "pages-tool",
			"pages": [
				{
					"path": "index/index",
					"style": {
						"navigationBarTitleText": "工具箱"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["pages-blog", "pages-rpg"]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "blog-x",
		"navigationBarBackgroundColor": "#f4f1ec",
		"backgroundColor": "#f4f1ec"
	},
	"uniIdRouter": {}
}
