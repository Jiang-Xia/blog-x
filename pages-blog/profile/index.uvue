<template>
	<!-- 公开主页：资料 + RPG 公开信息 + 文章 -->
	<view class="x-page">
		<x-navbar title="主页"></x-navbar>
		<view class="top">
			<view class="big-avatar">
				<text class="em">🦊</text>
			</view>
			<text class="name">{{ nickname }}</text>
			<text class="bio">{{ bio }}</text>
		</view>
		<view class="x-card">
			<text class="sec">公开 RPG</text>
			<text class="line">称号「{{ rpg.titleName }}」</text>
			<text class="line">公会 {{ rpg.guildName }}</text>
			<text class="line">{{ rpg.rankLabel }}</text>
			<text class="line">宠物 {{ rpg.petLabel }}</text>
			<text class="line">连续签到 {{ rpg.streakDays }} 天</text>
		</view>
		<view class="x-section-head">
			<text class="x-section-title">TA 的文章</text>
		</view>
		<view
			v-for="art in articleList"
			:key="art.id"
			class="x-card"
			@click="goDetail(art.id)"
		>
			<text class="art-t">{{ art.title }}</text>
			<text class="x-meta">{{ art.categoryName }} · {{ art.timeLabel }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 公开主页：联调 /user/public/:uid + /rpg/public/:uid/status + 文章列表
 */
import { articles, meProfile, publicRpg } from '../../mock/data'
import type { ArticleSummary } from '../../types/article'
import type { PublicRpgCard } from '../../types/user'
import { fetchPublicProfile, fetchPublicRpg, fetchUserInfo } from '../../api/modules/auth'
import { get } from '../../api/request'
import { mapArticleSummary } from '../../api/adapters/article'
import { apiOrMock } from '../../composables/useApiOrMock'
import { getToken } from '../../utils/storage'

const nickname = ref(meProfile.nickname)
const bio = ref(meProfile.bio)
const rpg = ref(publicRpg as PublicRpgCard)
const articleList = ref([articles[0]] as ArticleSummary[])
const uid = ref(0)

/**
 * 解析当前用户 uid 后拉公开数据
 */
async function loadProfile(): Promise<void> {
	if (getToken().length > 0) {
		try {
			const me = await fetchUserInfo()
			nickname.value = me.nickname
			bio.value = me.bio
		} catch (_) {}
		const raw = await apiOrMock(async () => {
			const info = await get('/user/info', null, { silent: true })
			return info
		}, null)
		if (raw != null && raw.id != null) {
			uid.value = Number(raw.id)
		}
	}
	if (uid.value > 0) {
		const pub = await apiOrMock(() => fetchPublicProfile(uid.value), null)
		if (pub != null) {
			if (pub.nickname != null) nickname.value = '' + pub.nickname
			if (pub.intro != null) bio.value = '' + pub.intro
		}
		rpg.value = await apiOrMock(() => fetchPublicRpg(uid.value), publicRpg)
		articleList.value = await apiOrMock(async () => {
			const res = await get('/user/public/' + uid.value + '/articles', { page: 1, pageSize: 10 }, { silent: true })
			const arr = res != null && res.list != null ? res.list : Array.isArray(res) ? res : []
			const out: ArticleSummary[] = []
			for (let i = 0; i < arr.length; i++) {
				out.push(mapArticleSummary(arr[i]))
			}
			return out.length > 0 ? out : [articles[0]]
		}, [articles[0]])
	}
}

onMounted(() => {
	loadProfile()
})

function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
.top {
	align-items: center;
	padding: 8px 0 16px;
}

.big-avatar {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: #ffe8d6;
	align-items: center;
	justify-content: center;
	margin-bottom: 10px;
}

.em {
	font-size: 30px;
}

.name {
	font-size: 18px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 4px;
}

.bio {
	font-size: 12px;
	color: #5c574f;
}

.sec {
	font-size: 13px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 8px;
}

.line {
	font-size: 12px;
	color: #5c574f;
	margin-bottom: 4px;
}

.art-t {
	font-size: 14px;
	font-weight: 650;
	color: #1c1a17;
	margin-bottom: 4px;
}
</style>
