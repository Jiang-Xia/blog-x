<template>
	<!-- 标签墙：GET /tag 列表，点击进搜索 -->
	<view class="x-page">
		<x-navbar title="标签墙"></x-navbar>
		<text class="count">共 {{ tags.length }} 个标签</text>
		<view class="wall">
			<view
				v-for="t in tags"
				:key="t.id"
				class="tag-chip"
				@click="goSearch(t.label)"
			>
				<text class="tag-t">{{ t.label }}</text>
			</view>
		</view>
		<x-empty v-if="tags.length == 0" text="暂无标签"></x-empty>
	</view>
</template>

<script setup lang="ts">
/**
 * 标签墙：联调 GET /tag（isDelete）；点击带 title 进搜索页
 */
import { fetchTags, type TagWallItem } from '../../api/modules/article'
import { apiOrMock } from '../../composables/useApiOrMock'

const tags = ref([] as TagWallItem[])

/**
 * 拉取标签列表；失败回落空（页面 empty）
 */
async function loadTags(): Promise<void> {
	tags.value = await apiOrMock(() => fetchTags(), [] as TagWallItem[])
}

onMounted(() => {
	loadTags()
})

/**
 * 跳转搜索，用标签名作 title 参数
 */
function goSearch(label: string): void {
	uni.navigateTo({
		url: '/pages/search/search?q=' + encodeURIComponent(label),
	})
}
</script>

<style>
.count {
	font-size: 12px;
	color: #9a948a;
	margin-bottom: 12px;
}

.wall {
	flex-direction: row;
	flex-wrap: wrap;
}

.tag-chip {
	padding: 8px 14px;
	border-radius: 999px;
	background-color: #ffffff;
	border-width: 1px;
	border-style: solid;
	border-color: #ebe6df;
	margin-right: 8px;
	margin-bottom: 10px;
}

.tag-t {
	font-size: 13px;
	font-weight: 500;
	color: #2a8f76;
}
</style>
