<template>
	<!-- 标签墙：GET /tag 列表，点击进搜索 -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="标签墙"></x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<text class="count">共 {{ tags.length }} 个标签</text>
			<view class="wall">
				<view
					v-for="t in tags"
					:key="t.id"
					class="tag-chip"
					@click="goSearch(t.label)"
				>
					<text class="tag-t">{{ t.label }}</text>
				</view>
			</view>
			<x-empty v-if="tags.length == 0 && showFooter" text="暂无标签"></x-empty>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 标签墙：联调 GET /tag（isDelete）；点击带 title 进搜索页
 * 滚动：全量列表，仅下拉刷新
 */
import { fetchTags, type TagWallItem } from '../../api/modules/article'
import { useListScroll } from '../../composables/useListScroll'
import { useTheme } from '../../composables/useTheme'
const { themeCssVars, syncNativeChrome } = useTheme()

const tags = ref([] as TagWallItem[])
const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(50)

/**
 * 下拉刷新标签
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	try {
		tags.value = await fetchTags()
	} catch (_) {
		tags.value = []
	}
	endRefresh(tags.value.length, tags.value.length, tags.value.length)
}

onMounted(() => {
	onRefresh()
})

/**
 * 跳转搜索，用标签名作 title 参数
 */
function goSearch(label: string): void {
	uni.navigateTo({
		url: '/pages/search/search?q=' + encodeURIComponent(label),
	})
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.count {
	font-size: 12px;
	color: var(--x-ink-3, #9a948a);
	margin-bottom: 12px;
}

.wall {
	flex-direction: row;
	flex-wrap: wrap;
}

.tag-chip {
	padding: 8px 14px;
	border-radius: 999px;
	background-color: var(--x-surface, #ffffff);
	border-width: 1px;
	border-style: solid;
	border-color: var(--x-bg-2, #ebe6df);
	margin-right: 8px;
	margin-bottom: 10px;
}

.tag-t {
	font-size: 13px;
	font-weight: 500;
	color: var(--x-accent-deep, #2a8f76);
}
</style>
