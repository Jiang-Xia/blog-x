<template>
	<!-- 我的收藏：联调 GET /collect/list，展示真实文章卡片 -->
	<view class="x-page-flex">
		<x-navbar title="我的收藏"></x-navbar>
		<x-scroll-page
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-if="!showFooter && list.length == 0" class="state">
				<text class="x-meta">加载中…</text>
			</view>
			<view v-else-if="list.length == 0">
				<x-empty emoji="⭐" text="还没有收藏，去首页逛逛吧" action-text="去首页" @action="goHome"></x-empty>
			</view>
			<view
				v-for="item in list"
				:key="item.id"
				class="x-card article"
				@click="goDetail(item.id)"
			>
				<view class="article-body">
					<text class="article-title">{{ item.title }}</text>
					<text class="x-meta">{{ item.categoryName }} · {{ item.timeLabel }}</text>
				</view>
				<view class="cover" :style="{ backgroundColor: item.coverC1 }">
					<text class="cover-em">{{ item.coverEmoji }}</text>
				</view>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 收藏页：联调 GET /collect/list（需登录；article.category.label）
 * 滚动：x-scroll-page 下拉刷新 + 上滑加载更多
 */
import type { ArticleSummary } from '../../types/article'
import { fetchCollectList } from '../../api/modules/interact'
import { apiOrMock } from '../../composables/useApiOrMock'
import { useListScroll } from '../../composables/useListScroll'
import { goTab, TAB_HOME } from '../../utils/tabNav'
import { showXToast } from '../../utils/toast'

const list = ref([] as ArticleSummary[])
const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
} = useListScroll(20)

/**
 * 拉取一页收藏
 */
async function fetchPage(page: number): Promise<ArticleSummary[]> {
	try {
		return await apiOrMock(() => fetchCollectList(page, pageSize), [])
	} catch (_) {
		showXToast('⚠️', '加载失败', '请确认已登录')
		return []
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const rows = await fetchPage(1)
	list.value = rows
	endRefresh(rows.length, list.value.length)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const rows = await fetchPage(p)
	for (let i = 0; i < rows.length; i++) {
		list.value.push(rows[i])
	}
	endLoadMore(rows.length, list.value.length)
}

onMounted(() => {
	onRefresh()
})

function goHome(): void {
	goTab(TAB_HOME)
}

function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
@import '../../styles/x-base.css';

.state {
	align-items: center;
	padding: 24px 0;
}

.article {
	flex-direction: row;
	align-items: center;
}

.article-body {
	flex: 1;
	margin-right: 12px;
}

.article-title {
	font-size: 14px;
	font-weight: 650;
	color: #1c1a17;
	margin-bottom: 4px;
	lines: 2;
	text-overflow: ellipsis;
}

.cover {
	width: 64px;
	height: 64px;
	border-radius: 14px;
	align-items: center;
	justify-content: center;
}

.cover-em {
	font-size: 22px;
}
</style>
