<template>
	<!-- 文章归档：按年→月→文章，对齐 Nest /article/archives -->
	<view class="x-page">
		<x-navbar title="归档"></x-navbar>
		<view v-if="years.length == 0" class="empty">
			<text class="x-meta">暂无归档</text>
		</view>
		<view v-for="y in years" :key="y.year" class="year-block">
			<text class="year">{{ y.year }}</text>
			<view v-for="m in y.months" :key="y.year + m.monthLabel" class="x-card">
				<view class="month-row">
					<view class="dot"></view>
					<view class="bar-wrap">
						<view class="label-row">
							<text class="m-label">{{ m.monthLabel }}</text>
							<text class="m-count">{{ m.count }} 篇</text>
						</view>
						<view class="bar light">
							<view class="bar-i" :style="{ width: barWidth(m.count) }"></view>
						</view>
					</view>
				</view>
				<view
					v-for="art in (m.articles != null ? m.articles : [])"
					:key="art.id"
					class="art-link"
					@click="goDetail(art.id)"
				>
					<text class="art-t">{{ art.title }}</text>
					<text v-if="art.timeLabel != null && art.timeLabel.length > 0" class="art-time">{{
						art.timeLabel
					}}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 归档页：联调 GET /article/archives（年→英文月→文章列表）
 */
import { archiveMonths } from '../../mock/data'
import type { ArchiveYear } from '../../types/notify'
import { fetchArchives } from '../../api/modules/article'
import { apiOrMock } from '../../composables/useApiOrMock'

/** mock 回落：包一层假年份 */
function mockYears(): ArchiveYear[] {
	return [{ year: '2026', months: archiveMonths }]
}

const years = ref(mockYears() as ArchiveYear[])

/**
 * 进度条宽度（相对上限 12 篇封顶）
 */
function barWidth(count: number): string {
	const n = count > 12 ? 12 : count
	return n * 8 + '%'
}

onMounted(async () => {
	years.value = await apiOrMock(() => fetchArchives(), mockYears())
})

function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
.year-block {
	margin-bottom: 8px;
}

.year {
	font-size: 18px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 12px;
}

.month-row {
	flex-direction: row;
	align-items: center;
}

.dot {
	width: 8px;
	height: 8px;
	border-radius: 4px;
	background-color: #3db89a;
	margin-right: 10px;
}

.bar-wrap {
	flex: 1;
}

.label-row {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 6px;
}

.m-label {
	font-size: 13px;
	font-weight: 600;
	color: #1c1a17;
}

.m-count {
	font-size: 13px;
	color: #9a948a;
}

.bar {
	height: 8px;
	background-color: #ebe6df;
	border-radius: 999px;
	overflow: hidden;
}

.bar-i {
	height: 8px;
	background-color: #3db89a;
	border-radius: 999px;
}

.art-link {
	margin-top: 10px;
	padding-left: 18px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.art-t {
	flex: 1;
	font-size: 13px;
	color: #2a8f76;
	margin-right: 8px;
	lines: 1;
	text-overflow: ellipsis;
}

.art-time {
	font-size: 11px;
	color: #9a948a;
}

.empty {
	align-items: center;
	padding: 32px 0;
}
</style>
