<template>
	<!-- 友情链接：列表 + 申请示意 -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="友情链接">
			<template v-slot:right>
				<text class="apply" @click="onApply">申请</text>
			</template>
		</x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-for="item in links" :key="item.id" class="x-card">
				<text class="name">{{ item.name }}</text>
				<text class="url">{{ item.url }}</text>
			</view>
			<text class="hint">点击卡片可在真机用 web-view / 复制链接（示意）</text>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 友链页：联调 GET/POST /link
 * 滚动：一次全量，仅下拉刷新
 */
import type { FriendLink } from '../../types/notify'
import { createLink, fetchLinks } from '../../api/modules/interact'
import { useListScroll } from '../../composables/useListScroll'
import { showXToast } from '../../utils/toast'
import { useTheme } from '../../composables/useTheme'
const { themeCssVars, syncNativeChrome } = useTheme()

const links = ref([] as FriendLink[])
const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(20)

/**
 * 下拉刷新友链
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	try {
		links.value = await fetchLinks()
	} catch (_) {
		links.value = []
	}
	endRefresh(links.value.length, links.value.length, links.value.length)
}

onMounted(() => {
	onRefresh()
})

/**
 * 申请友链
 */
async function onApply(): Promise<void> {
	try {
		await createLink({ title: '申请友链', url: 'https://example.com', desp: '来自 blog-x' })
		showXToast('link', '已提交', '等待审核')
		await onRefresh()
	} catch (_) {}
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.apply {
	font-size: 12px;
	color: var(--x-accent, #3db89a);
	font-weight: 600;
}

.name {
	font-size: 14px;
	font-weight: 650;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 4px;
}

.url {
	font-size: 12px;
	color: var(--x-accent-deep, #2a8f76);
}

.hint {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
	margin-top: 8px;
	line-height: 1.5;
}
</style>
