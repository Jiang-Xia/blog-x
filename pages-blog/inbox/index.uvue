<template>
	<!-- 评论收件箱：列表 + 回复 -->
	<view class="x-page-flex">
		<x-navbar title="评论收件箱"></x-navbar>
		<text class="badge-line">未读 {{ badge }}</text>
		<x-scroll-page
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-for="item in items" :key="item.id" class="x-card">
				<text class="art">《{{ item.articleTitle }}》</text>
				<text class="author">{{ item.author }}</text>
				<text class="content">{{ item.content }}</text>
				<view v-if="replyingId == item.id" class="reply-box">
					<input
						class="reply-input"
						type="text"
						v-model="replyDraft"
						placeholder="回复内容…"
						placeholder-class="ph"
						confirm-type="send"
						@confirm="onSubmitReply"
					/>
					<view class="reply-actions">
						<view class="x-btn x-btn-ghost" @click="cancelReply">
							<text class="x-btn-ghost-text">取消</text>
						</view>
						<view class="x-btn" @click="onSubmitReply">
							<text class="x-btn-text">发送</text>
						</view>
					</view>
				</view>
				<view v-else class="x-btn x-btn-ghost reply" @click="onReply(item)">
					<text class="x-btn-ghost-text">回复</text>
				</view>
			</view>
			<x-empty v-if="items.length == 0 && showFooter" text="暂无评论"></x-empty>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 评论收件箱：联调 GET /comment/on-my-articles + POST /reply/create
 * 滚动：x-scroll-page 下拉刷新 + 上滑加载更多
 */
import { inboxItems } from '../../mock/data'
import type { InboxItem } from '../../types/notify'
import { addReply, fetchInbox } from '../../api/modules/interact'
import { apiOrMock } from '../../composables/useApiOrMock'
import { useListScroll } from '../../composables/useListScroll'
import { USE_MOCK } from '../../api/config'
import { useMockStore } from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { showXToast } from '../../utils/toast'

const items = ref([] as InboxItem[])
const store = useMockStore()
const userStore = useUserStore()
const badge = store.inboxBadge
const replyingId = ref('')
const replyDraft = ref('')
const submitting = ref(false)

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
} = useListScroll(20)

/**
 * 拉取一页收件箱
 */
async function fetchPage(page: number): Promise<InboxItem[]> {
	return await apiOrMock(() => fetchInbox(page, pageSize), page == 1 ? inboxItems : [])
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const rows = await fetchPage(1)
	items.value = rows
	store.inboxBadge.value = items.value.length
	endRefresh(rows.length, items.value.length)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const rows = await fetchPage(p)
	for (let i = 0; i < rows.length; i++) {
		items.value.push(rows[i])
	}
	endLoadMore(rows.length, items.value.length)
}

onMounted(() => {
	onRefresh()
})

/**
 * 展开回复输入
 */
function onReply(item: InboxItem): void {
	if (!USE_MOCK && !userStore.loggedIn) {
		showXToast('🔐', '请先登录', '')
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	replyingId.value = item.id
	replyDraft.value = ''
}

/** 取消回复 */
function cancelReply(): void {
	replyingId.value = ''
	replyDraft.value = ''
}

/**
 * 提交回复：parentId=评论 id，replyUid=评论者 uid
 */
async function onSubmitReply(): Promise<void> {
	const text = replyDraft.value.trim()
	const parentId = replyingId.value
	if (text.length == 0 || parentId.length == 0 || submitting.value) return

	let replyUid = '0'
	for (let i = 0; i < items.value.length; i++) {
		if (items.value[i].id == parentId) {
			replyUid = items.value[i].replyUid
			break
		}
	}

	if (USE_MOCK) {
		showXToast('↩️', '已回复', 'mock')
		cancelReply()
		return
	}

	submitting.value = true
	try {
		const res = await addReply({ parentId, content: text, replyUid })
		const status = res != null && res.status != null ? '' + res.status : ''
		if (status == 'pending') {
			showXToast('⏳', '已提交', '待审核后展示')
		} else {
			showXToast('↩️', '回复成功', '')
		}
		cancelReply()
	} catch (_) {
	} finally {
		submitting.value = false
	}
}
</script>

<style>
@import '../../styles/x-base.css';

.badge-line {
	font-size: 12px;
	color: #e8897a;
	font-weight: 600;
	margin-bottom: 10px;
}

.art {
	font-size: 12px;
	font-weight: 650;
	color: #1c1a17;
	margin-bottom: 4px;
}

.author {
	font-size: 11px;
	color: #9a948a;
	margin-bottom: 6px;
}

.content {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.45;
	margin-bottom: 10px;
}

.reply {
	align-self: flex-start;
}

.reply-box {
	margin-top: 4px;
}

.reply-input {
	height: 40px;
	border-radius: 12px;
	background-color: #f4f1ec;
	padding: 0 12px;
	font-size: 13px;
	color: #1c1a17;
	margin-bottom: 8px;
}

.ph {
	color: #9a948a;
}

.reply-actions {
	flex-direction: row;
	justify-content: flex-end;
}
</style>
