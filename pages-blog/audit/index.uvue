<template>
	<!-- 审核台：敏感词命中列表 + 通过/驳回 -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="审核台">
			<template v-slot:right>
				<text class="exit" @click="onExit">退出</text>
			</template>
		</x-navbar>

		<!-- 来源分段：空 / comment / msgboard / reply -->
		<view class="x-seg">
			<view
				v-for="(s, i) in segs"
				:key="s"
				:class="segIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="setSeg(i)"
			>
				<text :class="segIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>

		<!-- 状态：默认待审 -->
		<view class="status-row">
			<view
				v-for="(st, si) in statusSegs"
				:key="st.value"
				:class="statusIndex === si ? 'st-chip st-chip-on' : 'st-chip'"
				@click="setStatus(si)"
			>
				<text :class="statusIndex === si ? 'st-t st-t-on' : 'st-t'">{{ st.label }}</text>
			</view>
		</view>

		<x-scroll-page
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-for="item in items" :key="item.id" class="audit-item">
				<view class="meta-row">
					<text class="kind">{{ sourceTypeLabel(item.sourceType) }}</text>
					<text class="status">{{ statusLabel(item.status) }}</text>
				</view>
				<text class="summary">{{ item.content }}</text>
				<text v-if="item.hitWords.length > 0" class="hl">命中「{{ item.hitWords }}」</text>
				<view v-if="item.status == 'pending'" class="actions">
					<view class="x-btn" @click="onPass(item)">
						<text class="x-btn-text">通过</text>
					</view>
					<view class="x-btn warn" @click="onReject(item)">
						<text class="warn-t">驳回</text>
					</view>
				</view>
			</view>

			<x-empty v-if="items.length == 0 && showFooter" text="暂无命中记录"></x-empty>
			<text class="footer">共 {{ total }} 条</text>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 审核台：GET /sensitive-word/hit + approve/reject（对齐 blog-admin 敏感词审核）
 * 展示：sourceType / status 枚举译为中文；仅超级管理员/管理员可进
 * 滚动：x-scroll-page 下拉刷新 + 上滑加载更多
 */
import {
	approveAuditHit,
	fetchAuditHits,
	rejectAuditHit,
	type AuditHit,
} from '../../api/modules/audit'
import { useListScroll } from '../../composables/useListScroll'
import { useTheme } from '../../composables/useTheme'
import { useUserStore } from '../../store/user'
import { showXToast } from '../../utils/toast'

const { themeCssVars, syncNativeChrome } = useTheme()

const segs = ['全部', '评论', '留言', '回复']
const segTypes = ['', 'comment', 'msgboard', 'reply']
const segIndex = ref(0)

const statusSegs = [
	{ label: '待审', value: 'pending' },
	{ label: '已通过', value: 'approved' },
	{ label: '已拒绝', value: 'rejected' },
	{ label: '全部', value: '' },
]
const statusIndex = ref(0)

const items = ref([] as AuditHit[])
const total = ref(0)
const acting = ref(false)
const userStore = useUserStore()

/**
 * 来源枚举 → 中文（对齐 blog-admin 展示，勿直接刷英文）
 */
function sourceTypeLabel(raw: string): string {
	if (raw == 'comment') return '评论'
	if (raw == 'msgboard') return '留言'
	if (raw == 'reply') return '回复'
	if (raw == 'article') return '文章'
	if (raw.length == 0) return '未知'
	return raw
}

/**
 * 审核状态枚举 → 中文
 */
function statusLabel(raw: string): string {
	if (raw == 'pending') return '待审'
	if (raw == 'approved') return '已通过'
	if (raw == 'rejected') return '已拒绝'
	if (raw.length == 0) return '未知'
	return raw
}

/**
 * 是否管理员（roleId 1/2 或角色名含管理员）
 */
function isAdminUser(): boolean {
	const p = userStore.profile
	const ids = p.roleIds != null ? p.roleIds : []
	for (let i = 0; i < ids.length; i++) {
		if (ids[i] == 1 || ids[i] == 2) return true
	}
	const names = p.roleNames != null ? p.roleNames : []
	for (let i = 0; i < names.length; i++) {
		const n = names[i].toLowerCase()
		if (
			n.indexOf('超级管理员') >= 0 ||
			n.indexOf('管理员') >= 0 ||
			n.indexOf('super') >= 0 ||
			n.indexOf('admin') >= 0
		) {
			return true
		}
	}
	return false
}

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
	resetPaging,
} = useListScroll(20)

/**
 * 当前筛选：来源 + 状态
 */
function currentQuery(): { sourceType: string; status: string } {
	return {
		sourceType: segTypes[segIndex.value],
		status: statusSegs[statusIndex.value].value,
	}
}

/**
 * 拉取一页命中
 */
async function fetchPage(page: number): Promise<{ list: AuditHit[]; total: number }> {
	const q = currentQuery()
	try {
		return await fetchAuditHits({
			page,
			pageSize,
			sourceType: q.sourceType,
			status: q.status,
		})
	} catch (_) {
		return { list: [], total: 0 }
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const res = await fetchPage(1)
	items.value = res.list
	total.value = res.total
	endRefresh(res.list.length, items.value.length, res.total)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const res = await fetchPage(p)
	for (let i = 0; i < res.list.length; i++) {
		items.value.push(res.list[i])
	}
	total.value = res.total
	endLoadMore(res.list.length, items.value.length, res.total)
}

onMounted(async () => {
	if (!userStore.loggedIn) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	try {
		await userStore.refreshProfile()
	} catch (_) {}
	if (!isAdminUser()) {
		showXToast('shield', '无管理权限', '')
		uni.navigateBack({
			fail: () => {
				uni.switchTab({ url: '/pages/index/index' })
			},
		})
		return
	}
	onRefresh()
})

/**
 * 切换来源分段
 */
function setSeg(i: number): void {
	segIndex.value = i
	resetPaging()
	onRefresh()
}

/**
 * 切换审核状态筛选
 */
function setStatus(i: number): void {
	statusIndex.value = i
	resetPaging()
	onRefresh()
}

/**
 * 通过
 */
function onPass(item: AuditHit): void {
	if (acting.value) return
	uni.showModal({
		title: '确认通过？',
		content: '将标记该内容为合规并同步来源状态',
		success: (res) => {
			if (res.confirm) doApprove(item)
		},
	})
}

/**
 * 驳回
 */
function onReject(item: AuditHit): void {
	if (acting.value) return
	uni.showModal({
		title: '确认驳回？',
		content: '将标记该内容为违规并同步来源状态',
		success: (res) => {
			if (res.confirm) doReject(item)
		},
	})
}

/**
 * 执行通过
 */
async function doApprove(item: AuditHit): Promise<void> {
	acting.value = true
	try {
		await approveAuditHit(item.id)
		showXToast('circle-check', '已通过', '')
		await onRefresh()
	} catch (_) {
	} finally {
		acting.value = false
	}
}

/**
 * 执行驳回
 */
async function doReject(item: AuditHit): Promise<void> {
	acting.value = true
	try {
		await rejectAuditHit(item.id)
		showXToast('circle-x', '已驳回', '')
		await onRefresh()
	} catch (_) {
	} finally {
		acting.value = false
	}
}

/**
 * 返回上一页
 */
function onExit(): void {
	uni.navigateBack()
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.exit {
	font-size: 12px;
	color: #c2543f;
	font-weight: 600;
}

.status-row {
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 10px;
}

.st-chip {
	padding: 4px 12px;
	border-radius: 8px;
	background-color: var(--x-line, rgba(28, 26, 23, 0.06));
	margin-right: 8px;
	margin-bottom: 6px;
}

.st-chip-on {
	background-color: var(--x-accent, #3db89a);
}

.st-t {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	font-weight: 600;
}

.st-t-on {
	color: var(--x-on-ink, #ffffff);
}

.audit-item {
	background-color: var(--x-surface, #ffffff);
	border-radius: 18px;
	padding: 12px 13px;
	margin-bottom: 10px;
}

.meta-row {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 6px;
}

.kind {
	font-size: 11px;
	color: #6d5fa0;
	font-weight: 600;
}

.status {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.summary {
	font-size: 13px;
	color: var(--x-ink-2, #5c574f);
	line-height: 1.45;
	margin-bottom: 6px;
}

.hl {
	font-size: 12px;
	color: #c2543f;
	background-color: rgba(232, 137, 122, 0.22);
	margin-bottom: 10px;
	padding: 2px 6px;
	border-radius: 4px;
}

.actions {
	flex-direction: row;
	margin-top: 8px;
}

.warn {
	background-color: rgba(232, 137, 122, 0.14);
	margin-left: 8px;
}

.warn-t {
	font-size: 12px;
	font-weight: 600;
	color: #c2543f;
}

.footer {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
	margin-top: 8px;
	margin-bottom: 8px;
	text-align: center;
}
</style>
