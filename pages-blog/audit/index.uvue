<template>
	<!-- 审核台：分段 + 通过/驳回示意 -->
	<view class="x-page">
		<x-navbar title="审核台">
			<template v-slot:right>
				<text class="exit" @click="onExit">退出</text>
			</template>
		</x-navbar>

		<view class="x-seg">
			<view
				v-for="(s, i) in segs"
				:key="s"
				:class="segIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="segIndex = i"
			>
				<text :class="segIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>

		<view v-for="item in items" :key="item.id" class="audit-item">
			<text class="kind">{{ item.kind }}</text>
			<text class="summary">
				{{ item.summary }}
				<text v-if="item.highlight != null" class="hl">「{{ item.highlight }}」</text>
			</text>
			<view class="actions">
				<view class="x-btn" @click="onPass">
					<text class="x-btn-text">通过</text>
				</view>
				<view class="x-btn warn" @click="onReject">
					<text class="warn-t">驳回</text>
				</view>
			</view>
		</view>

		<text class="footer">今日访客 1.2k · 新评论 12</text>
	</view>
</template>

<script setup lang="ts">
/**
 * 审核台：mock auditItems；分段仅 UI
 */
import { auditItems } from '../../mock/data'
import { showXToast } from '../../utils/toast'

const segs = ['评论12', '留言3', '友链1', '敏感词2']
const segIndex = ref(0)
const items = auditItems

function onPass(): void {
	showXToast('✅', '已通过', '')
}

function onReject(): void {
	showXToast('❌', '已驳回', '')
}

function onExit(): void {
	uni.navigateBack()
}
</script>

