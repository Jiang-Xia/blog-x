<template>
	<!-- 留言板：头像可进公开主页（address=/user/:uid）或打开外链 -->
	<view class="x-page-flex">
		<x-navbar title="留言板">
			<template v-slot:right>
				<text class="pub" @click="onPublish">发布</text>
			</template>
		</x-navbar>
		<text class="count">{{ totalLabel }}</text>
		<x-scroll-page
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-for="item in items" :key="item.id" class="x-card">
				<view class="row">
					<view class="av" @click="onAvatar(item)">
						<image
							v-if="item.avatarUrl != null && item.avatarUrl.length > 0"
							class="av-img"
							:src="item.avatarUrl"
							mode="aspectFill"
						></image>
						<text v-else class="av-fall">{{ authorInitial(item.author) }}</text>
					</view>
					<text class="author" @click="onAvatar(item)">{{ item.author }}</text>
					<text class="floor">#{{ item.floor }}</text>
				</view>
				<text class="content">{{ item.content }}</text>
				<view v-if="item.reply != null" class="reply-nest">
					<text class="reply-t">{{ item.reply }}</text>
				</view>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 留言板：联调 GET/POST /msgboard
 * 头像跳转：有站内 uid（address=/user/:uid）→ 公开主页；否则有 http(s) address → 外链
 * 登录发布时 address 写成 /user/{uid}，便于跳公开主页
 */
import type { GuestbookItem } from '../../types/notify'
import { fetchMsgboard, postMsgboard } from '../../api/modules/interact'
import { useListScroll } from '../../composables/useListScroll'
import { useUserStore } from '../../store/user'
import { goPublicProfile } from '../../utils/nav-profile'
import { showXToast } from '../../utils/toast'

const items = ref([] as GuestbookItem[])
const totalLabel = ref('共 0 条留言')
const userStore = useUserStore()

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
} = useListScroll(20)

/**
 * 昵称首字兜底（无头像时）
 */
function authorInitial(name: string): string {
	if (name == null || name.length == 0) return '?'
	return name.substring(0, 1)
}

/**
 * 头像/昵称点击：站内 uid → 公开主页；外链 address → 打开浏览器
 */
function onAvatar(item: GuestbookItem): void {
	if (item.uid > 0) {
		goPublicProfile(item.uid)
		return
	}
	const addr = item.address != null ? item.address.trim() : ''
	if (addr.indexOf('http://') == 0 || addr.indexOf('https://') == 0) {
		// 跨端统一复制外链，避免 App/小程序 openURL 差异
		uni.setClipboardData({
			data: addr,
			success: () => {
				showXToast('link', '已复制主页链接', addr)
			},
		})
		return
	}
	showXToast('user', '暂无公开主页', '该留言未关联站内用户')
}

/**
 * 拉取一页留言
 */
async function fetchPage(page: number): Promise<GuestbookItem[]> {
	try {
		return await fetchMsgboard(page, pageSize)
	} catch (_) {
		return []
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const rows = await fetchPage(1)
	items.value = rows
	totalLabel.value = '共 ' + items.value.length + ' 条留言'
	endRefresh(rows.length, items.value.length)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const rows = await fetchPage(p)
	for (let i = 0; i < rows.length; i++) {
		items.value.push(rows[i])
	}
	totalLabel.value = '共 ' + items.value.length + ' 条留言'
	endLoadMore(rows.length, items.value.length)
}

onMounted(() => {
	onRefresh()
})

/**
 * 发布留言：登录用户写入 address=/user/{uid}，便于头像跳公开主页
 */
async function onPublish(): Promise<void> {
	if (!userStore.loggedIn) {
		showXToast('lock', '请先登录', '')
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	const uid = userStore.profile.id
	const name = userStore.profile.nickname
	try {
		await postMsgboard({
			name: name.length > 0 ? name : '访客',
			comment: '来自 blog-x 的留言',
			address: uid > 0 ? '/user/' + uid : '',
		})
		showXToast('message', '已发布', '')
		await onRefresh()
	} catch (_) {}
}
</script>

<style>
@import '../../styles/x-base.css';

.pub {
	font-size: 12px;
	color: #3db89a;
	font-weight: 600;
}

.count {
	font-size: 12px;
	color: #9a948a;
	margin-bottom: 10px;
}

.row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 6px;
}

.av {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background-color: #ffe8d6;
	align-items: center;
	justify-content: center;
	margin-right: 8px;
	overflow: hidden;
}

.av-img {
	width: 32px;
	height: 32px;
}

.av-fall {
	font-size: 13px;
	font-weight: 600;
	color: #c06a45;
}

.author {
	flex: 1;
	font-size: 13px;
	font-weight: 600;
	color: #1c1a17;
}

.floor {
	font-size: 10px;
	color: #9a948a;
}

.content {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.45;
}

.reply-nest {
	margin-top: 8px;
	margin-left: 8px;
	padding: 8px 10px;
	background-color: #ebe6df;
	border-radius: 10px;
}

.reply-t {
	font-size: 12px;
	color: #5c574f;
}
</style>
