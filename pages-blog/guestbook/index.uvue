<template>
	<!-- 留言板：列表 + 发布示意 -->
	<view class="x-page">
		<x-navbar title="留言板">
			<template v-slot:right>
				<text class="pub" @click="onPublish">发布</text>
			</template>
		</x-navbar>
		<text class="count">{{ totalLabel }}</text>
		<view v-for="item in items" :key="item.id" class="x-card">
			<view class="row">
				<text class="author">{{ item.author }}</text>
				<text class="floor">#{{ item.floor }}</text>
			</view>
			<text class="content">{{ item.content }}</text>
			<view v-if="item.reply != null" class="reply-nest">
				<text class="reply-t">{{ item.reply }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 留言板：联调 GET/POST /msgboard
 */
import { guestbookItems } from '../../mock/data'
import type { GuestbookItem } from '../../types/notify'
import { fetchMsgboard, postMsgboard } from '../../api/modules/interact'
import { apiOrMock } from '../../composables/useApiOrMock'
import { USE_MOCK } from '../../api/config'
import { showXToast } from '../../utils/toast'

const items = ref(guestbookItems as GuestbookItem[])
const totalLabel = ref('共 ' + guestbookItems.length + ' 条留言')

/**
 * 加载留言列表
 */
async function loadList(): Promise<void> {
	items.value = await apiOrMock(() => fetchMsgboard(1, 30), guestbookItems)
	totalLabel.value = '共 ' + items.value.length + ' 条留言'
}

onMounted(() => {
	loadList()
})

/**
 * 发布留言（联调真实接口；mock 仅 toast）
 */
async function onPublish(): Promise<void> {
	if (USE_MOCK) {
		showXToast('💬', '已发布', '示意留言已提交')
		return
	}
	try {
		await postMsgboard({ name: '访客', comment: '来自 blog-x 的留言' })
		showXToast('💬', '已发布', '')
		await loadList()
	} catch (_) {}
}
</script>

<style>
.pub {
	font-size: 12px;
	color: #3db89a;
	font-weight: 600;
}

.count {
	font-size: 12px;
	color: #9a948a;
	margin-bottom: 10px;
}

.row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 6px;
}

.author {
	flex: 1;
	font-size: 13px;
	font-weight: 600;
	color: #1c1a17;
}

.floor {
	font-size: 10px;
	color: #9a948a;
}

.content {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.45;
}

.reply-nest {
	margin-top: 8px;
	margin-left: 8px;
	padding: 8px 10px;
	background-color: #ebe6df;
	border-radius: 10px;
}

.reply-t {
	font-size: 12px;
	color: #5c574f;
}
</style>
