<script setup lang="ts">
	/**
	 * 应用生命周期：冷启动有缓存 token 时走 Pinia 自动登录
	 * 微信小程序：onLaunch → loadTablerFonts（loadFontFace + 子集 ttf Data URL）
	 */
	import { useUserStore } from './store/user'
	import { onAuthCleared } from './utils/auth-events'
	import { loadTablerFonts } from './utils/load-tabler-fonts'

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		// 小程序须在 App.onLaunch 调 loadFontFace 且 global:true，图标才全局可见
		loadTablerFonts()
		const userStore = useUserStore()
		// request 层 clearToken（401）时同步 Pinia，避免 UI 仍显示已登录
		onAuthCleared(() => {
			userStore.hydrateFromStorage()
		})
		// 有本地 token 则静默恢复登录态并拉 /user/info
		userStore.tryAutoLogin()
	})

	onAppShow(() => {
		const userStore = useUserStore()
		userStore.hydrateFromStorage()
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	// Android / Harmony：双击返回退出
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* 页面可用；组件须自行 @import styles/x-base.css（styleIsolation v2） */
	@import './styles/x-base.css';
</style>
