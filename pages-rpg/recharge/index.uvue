<template>
	<!-- 钻石充值：支付宝下单（对齐 Nuxt 面额 + 自定义金额；支付链路同站点赞赏） -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="钻石充值"></x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view class="x-card bal-card">
				<text class="bal-label">当前钻石</text>
				<view class="bal-n-row">
					<x-icon name="diamond" :size="22" color="#1c1a17"></x-icon>
					<text class="bal-n">{{ diamonds }}</text>
				</view>
				<text class="rate-hint">{{ rateText }}</text>
			</view>

			<text class="sec-title">充值金额</text>
			<view class="pack">
				<view
					v-for="yuan in presetOptions"
					:key="'' + yuan"
					:class="amountMode == 'preset' && selectedPreset == yuan ? 'sku on' : 'sku'"
					@click="selectPreset(yuan)"
				>
					<text class="sku-strong">¥{{ yuan }}</text>
					<text class="sku-span">{{ calcDiamonds(yuan) }} 钻石</text>
				</view>
				<view
					:class="amountMode == 'custom' ? 'sku on' : 'sku'"
					@click="selectCustomMode"
				>
					<text class="sku-strong">自定义</text>
					<text class="sku-span">{{ customRangeHint }}</text>
				</view>
			</view>

			<view v-if="amountMode == 'custom'" class="custom-row">
				<input
					class="custom-input"
					type="digit"
					:value="customAmountInput"
					:placeholder="customPlaceholder"
					placeholder-class="custom-ph"
					@input="onCustomInput"
				/>
				<text class="custom-unit">元</text>
			</view>

			<view class="x-card preview-card">
				<text class="preview-label">预计到账</text>
				<text class="preview-value">{{ diamondsPreviewText }}</text>
				<text class="preview-suffix">钻石</text>
			</view>

			<text class="pay-hint">{{ alipayHint }}</text>
			<view class="x-btn pay" :class="paying || !isAmountValid ? 'pay-disabled' : ''" @click="onPay">
				<text class="x-btn-text">{{ payBtnText }}</text>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 钻石充值：POST /rpg/recharge/create（仅支付宝）+ 轮询 status
 * 面额/汇率/自定义范围对齐 Nuxt rpg-economy；拉起支付同站点赞赏（复制 universalLink/scheme）
 * 滚动：x-scroll-page 下拉刷新余额
 */
import { createRpgRecharge, getRpgRechargeStatus, fetchRpgHero } from '../../api/modules/rpg'
import {
	RPG_RECHARGE_AMOUNT_OPTIONS,
	RPG_RECHARGE_DEFAULT_AMOUNT,
	RPG_RECHARGE_MIN_YUAN,
	RPG_RECHARGE_MAX_YUAN,
	RPG_RECHARGE_RATE_TEXT,
	RPG_RECHARGE_ALIPAY_HINT,
	parseRechargeYuanInput,
	isRechargeYuanInRange,
	calcRechargeDiamonds,
} from '../../constants/rpg-economy'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'
import { useTheme } from '../../composables/useTheme'

const { themeCssVars, syncNativeChrome } = useTheme()

const presetOptions = RPG_RECHARGE_AMOUNT_OPTIONS
const rateText = RPG_RECHARGE_RATE_TEXT
const alipayHint = RPG_RECHARGE_ALIPAY_HINT
const customRangeHint = `${RPG_RECHARGE_MIN_YUAN}~${RPG_RECHARGE_MAX_YUAN} 元`
const customPlaceholder = `请输入 ${RPG_RECHARGE_MIN_YUAN}~${RPG_RECHARGE_MAX_YUAN}`

/** preset=快捷面额；custom=自定义输入 */
const amountMode = ref('preset')
const selectedPreset = ref(RPG_RECHARGE_DEFAULT_AMOUNT)
const customAmountInput = ref('')
const store = useMockStore()
const diamonds = store.diamonds
const paying = ref(false)

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/**
 * 下拉刷新钻石余额
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	try {
		const hero = await fetchRpgHero()
		store.diamonds.value = hero.diamonds
	} catch (_) {}
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

/**
 * 按金额算预计钻石（模板预览用）
 */
function calcDiamonds(yuan: number): number {
	return calcRechargeDiamonds(yuan)
}

/**
 * 当前生效金额（元）：预设直接取值，自定义解析并校验范围
 */
const resolvedAmount = computed((): number | null => {
	if (amountMode.value == 'preset') {
		return selectedPreset.value
	}
	const parsed = parseRechargeYuanInput(customAmountInput.value)
	if (parsed == null || !isRechargeYuanInRange(parsed)) return null
	return parsed
})

const isAmountValid = computed((): boolean => {
	return resolvedAmount.value != null
})

const diamondsPreviewText = computed((): string => {
	const amount = resolvedAmount.value
	if (amount == null) return '--'
	return '' + calcRechargeDiamonds(amount)
})

const payBtnText = computed((): string => {
	if (paying.value) return '处理中…'
	const amount = resolvedAmount.value
	if (amount == null) return '支付宝充值'
	return '支付宝充值 ¥' + amount
})

/**
 * 选中快捷面额
 */
function selectPreset(yuan: number): void {
	if (paying.value) return
	amountMode.value = 'preset'
	selectedPreset.value = yuan
}

/**
 * 切到自定义金额；空输入时带入当前预设作初值
 */
function selectCustomMode(): void {
	if (paying.value) return
	amountMode.value = 'custom'
	if (customAmountInput.value.trim().length == 0) {
		customAmountInput.value = '' + selectedPreset.value
	}
}

/**
 * 自定义金额输入：封顶到上限
 */
function onCustomInput(e: any): void {
	const detail = e != null ? e.detail : null
	const raw = detail != null && detail.value != null ? '' + detail.value : ''
	const parsed = parseRechargeYuanInput(raw)
	if (parsed != null && parsed > RPG_RECHARGE_MAX_YUAN) {
		customAmountInput.value = '' + RPG_RECHARGE_MAX_YUAN
		return
	}
	customAmountInput.value = raw
}

/**
 * 轮询充值到账（对齐站点赞赏：PENDING 继续，PAID 刷新余额）
 */
function pollRecharge(outTradeNo: string, left: number): void {
	if (left <= 0) {
		paying.value = false
		showXToast('hourglass', '支付处理中', '请稍后在冒险中心查看钻石')
		return
	}
	getRpgRechargeStatus(outTradeNo)
		.then(async (res) => {
			const status = res != null && res.status != null ? ('' + res.status).toLowerCase() : ''
			const paidFlag = res != null && res.paid === true
			const fulfilled = res != null && res.fulfilled === true
			const paid =
				paidFlag ||
				fulfilled ||
				status == 'paid' ||
				status == 'success'
			if (paid) {
				paying.value = false
				try {
					const hero = await fetchRpgHero()
					store.diamonds.value = hero.diamonds
				} catch (_) {}
				showXToast('diamond', '充值成功', '')
				return
			}
			if (status.length > 0 && status != 'pending') {
				paying.value = false
				showXToast('circle-x', '支付未完成', status)
				return
			}
			setTimeout(() => {
				pollRecharge(outTradeNo, left - 1)
			}, 2500)
		})
		.catch(() => {
			setTimeout(() => {
				pollRecharge(outTradeNo, left - 1)
			}, 2500)
		})
}

/**
 * 支付宝下单：create → 复制支付链接 → 轮询 status
 */
async function onPay(): Promise<void> {
	const amount = resolvedAmount.value
	if (amount == null || paying.value) {
		if (amount == null) {
			showXToast(
				'alert-triangle',
				'请输入有效金额',
				`范围 ${RPG_RECHARGE_MIN_YUAN}~${RPG_RECHARGE_MAX_YUAN} 元`,
			)
		}
		return
	}
	paying.value = true
	try {
		const res = await createRpgRecharge(amount)
		const outTradeNo =
			res != null && res.outTradeNo != null
				? '' + res.outTradeNo
				: res != null && res.out_trade_no != null
					? '' + res.out_trade_no
					: ''
		const link =
			res != null && res.universalLink != null
				? '' + res.universalLink
				: res != null && res.scheme != null
					? '' + res.scheme
					: ''
		if (outTradeNo.length == 0) {
			paying.value = false
			showXToast('alert-triangle', '下单失败', '')
			return
		}
		if (link.length > 0) {
			// 与站点赞赏一致：各端统一复制链接，避免 plus/window 条件编译差异
			uni.setClipboardData({
				data: link,
				success: () => {
					showXToast('clipboard', '支付链接已复制', '请在浏览器打开完成支付')
				},
			})
		} else {
			showXToast('credit-card', '请完成支付', '正在确认到账…')
		}
		pollRecharge(outTradeNo, 24)
	} catch (_) {
		paying.value = false
	}
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.bal-card {
	align-items: center;
	margin-bottom: 14px;
}

.bal-label {
	font-size: 12px;
	color: var(--x-ink-3, #9a948a);
	margin-bottom: 6px;
}

.bal-n-row {
	flex-direction: row;
	align-items: center;
}

.bal-n {
	font-size: 22px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-left: 6px;
}

.rate-hint {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
	margin-top: 8px;
}

.sec-title {
	font-size: 13px;
	font-weight: 600;
	color: var(--x-ink-2, #5c574f);
	margin-bottom: 10px;
}

.pack {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	margin-bottom: 12px;
}

.sku {
	width: 48%;
	border-radius: 16px;
	padding: 12px;
	background-color: var(--x-surface, #ffffff);
	border-width: 1.5px;
	border-style: solid;
	border-color: var(--x-bg-2, #ebe6df);
	margin-bottom: 8px;
}

.on {
	border-color: var(--x-accent, #3db89a);
	background-color: rgba(61, 184, 154, 0.08);
}

.sku-strong {
	font-size: 16px;
	font-weight: 600;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 2px;
}

.sku-span {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.custom-row {
	flex-direction: row;
	align-items: center;
	background-color: var(--x-surface, #ffffff);
	border-radius: 14px;
	border-width: 1.5px;
	border-style: solid;
	border-color: var(--x-bg-2, #ebe6df);
	padding: 4px 12px;
	margin-bottom: 12px;
}

.custom-input {
	flex: 1;
	height: 40px;
	font-size: 16px;
	font-weight: 600;
	color: var(--x-ink, #1c1a17);
}

.custom-ph {
	color: var(--x-ink-3, #9a948a);
	font-weight: 400;
	font-size: 13px;
}

.custom-unit {
	font-size: 14px;
	color: var(--x-ink-2, #5c574f);
	margin-left: 8px;
}

.preview-card {
	flex-direction: row;
	align-items: baseline;
	margin-bottom: 12px;
	padding: 12px 14px;
}

.preview-label {
	font-size: 12px;
	color: var(--x-ink-3, #9a948a);
	margin-right: 8px;
}

.preview-value {
	font-size: 20px;
	font-weight: 700;
	color: var(--x-accent-deep, #2a8f76);
}

.preview-suffix {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	margin-left: 4px;
}

.pay-hint {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
	margin-bottom: 12px;
	line-height: 1.4;
}

.pay {
	padding: 12px;
}

.pay-disabled {
	opacity: 0.55;
}
</style>
