<template>
	<!-- 钻石充值：SKU + 支付下单轮询 -->
	<view class="x-page-flex">
		<x-navbar title="钻石充值"></x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view class="x-card bal-card">
				<text class="bal-label">当前钻石</text>
				<text class="bal-n">💎 {{ diamonds }}</text>
			</view>
			<view class="pack">
				<view
					v-for="sku in skus"
					:key="sku.id"
					:class="sku.id === selectedId ? 'sku on' : 'sku'"
					@click="selectSku(sku.id)"
				>
					<text class="sku-strong">{{ sku.diamonds }} 钻石</text>
					<text class="sku-span">¥{{ sku.priceYuan }}{{ sku.bonusLabel != null ? ' · ' + sku.bonusLabel : '' }}</text>
				</view>
			</view>
			<view class="x-btn pay" @click="onPay">
				<text class="x-btn-text">支付 ¥{{ payPrice }}</text>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 钻石充值：联调 create + 轮询 status
 * 滚动：x-scroll-page 下拉刷新余额
 */
import type { RechargeSku } from '../../types/rpg'
import { createRpgRecharge, getRpgRechargeStatus, fetchRpgHero } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'

const skus: RechargeSku[] = [
	{ id: '60', diamonds: 60, priceYuan: 6 },
	{ id: '300', diamonds: 300, priceYuan: 30, bonusLabel: '+30' },
	{ id: '680', diamonds: 680, priceYuan: 68 },
	{ id: '1280', diamonds: 1280, priceYuan: 128 },
]
const selectedId = ref('300')
const store = useMockStore()
const diamonds = store.diamonds
const paying = ref(false)

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/**
 * 下拉刷新钻石余额
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	try {
		const hero = await fetchRpgHero()
		store.diamonds.value = hero.diamonds
	} catch (_) {}
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

/**
 * 按 id 查找充值档
 */
function findSku(id: string) {
	for (let i = 0; i < skus.length; i++) {
		if (skus[i].id === id) return skus[i]
	}
	return null
}

const payPrice = computed((): number => {
	const s = findSku(selectedId.value)
	return s != null ? s.priceYuan : 0
})

function selectSku(id: string): void {
	selectedId.value = id
}

/**
 * 轮询充值到账
 */
function pollRecharge(outTradeNo: string, left: number): void {
	if (left <= 0) {
		paying.value = false
		showXToast('⏳', '支付处理中', '请稍后在冒险中心查看钻石')
		return
	}
	getRpgRechargeStatus(outTradeNo)
		.then(async (res) => {
			const paid =
				res != null &&
				(res.status === 'paid' || res.status === 'success' || res.paid === true)
			if (paid) {
				paying.value = false
				try {
					const hero = await fetchRpgHero()
					store.diamonds.value = hero.diamonds
				} catch (_) {}
				showXToast('💎', '充值成功', '')
				return
			}
			setTimeout(() => {
				pollRecharge(outTradeNo, left - 1)
			}, 2000)
		})
		.catch(() => {
			setTimeout(() => {
				pollRecharge(outTradeNo, left - 1)
			}, 2000)
		})
}

/**
 * 下单充值
 */
async function onPay(): Promise<void> {
	const s = findSku(selectedId.value)
	if (s == null || paying.value) return
	paying.value = true
	try {
		const res = await createRpgRecharge(s.priceYuan)
		const outTradeNo =
			res != null && res.outTradeNo != null
				? '' + res.outTradeNo
				: res != null && res.out_trade_no != null
					? '' + res.out_trade_no
					: ''
		if (outTradeNo.length == 0) {
			paying.value = false
			showXToast('⚠️', '下单失败', '')
			return
		}
		showXToast('💳', '请完成支付', '正在确认到账…')
		pollRecharge(outTradeNo, 15)
	} catch (_) {
		paying.value = false
	}
}
</script>

<style>
@import '../../styles/x-base.css';

.bal-card {
	align-items: center;
	margin-bottom: 14px;
}

.bal-label {
	font-size: 12px;
	color: #9a948a;
	margin-bottom: 6px;
}

.bal-n {
	font-size: 22px;
	font-weight: 700;
	color: #1c1a17;
}

.pack {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	margin-bottom: 20px;
}

.sku {
	width: 48%;
	border-radius: 16px;
	padding: 12px;
	background-color: #ffffff;
	border-width: 1.5px;
	border-style: solid;
	border-color: transparent;
	margin-bottom: 8px;
}

.on {
	border-color: #3db89a;
	background-color: rgba(61, 184, 154, 0.08);
}

.sku-strong {
	font-size: 16px;
	font-weight: 600;
	color: #1c1a17;
	margin-bottom: 2px;
}

.sku-span {
	font-size: 11px;
	color: #9a948a;
}

.pay {
	padding: 12px;
}
</style>
