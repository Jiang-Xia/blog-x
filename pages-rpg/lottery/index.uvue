<template>
	<!-- 幸运抽奖：3×3 格 + 中心抽一次 + 高亮轮转 -->
	<view class="x-page-flex">
		<x-navbar title="幸运抽奖"></x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view class="lottery">
				<view
					v-for="(cell, i) in displayCells"
					:key="'c' + i"
					:class="cellClass(i)"
					@click="onCellClick(i)"
				>
					<x-icon :name="cell.icon" :size="22" color="#1c1a17"></x-icon>
					<text class="cell-lb">{{ cell.label }}</text>
				</view>
			</view>
			<view class="x-section-head">
				<text class="x-section-title">最近获得</text>
			</view>
			<text class="recent">{{ recentLabel }}</text>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 幸运抽奖：联调 pool + draw；UI 轮转后 toast 服务端结果
 * 滚动：x-scroll-page 下拉刷新奖池
 */
import type { LotteryCell } from '../../types/rpg'
import { fetchLotteryPool, lotteryDraw } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { toIconName } from '../../utils/icon-name'
import { showXToast } from '../../utils/toast'

/** 外围 8 格顺序（跳过中心 index 4） */
const ringOrder = [0, 1, 2, 5, 8, 7, 6, 3]
const hiIndex = ref(-1)
const spinning = ref(false)
const pool = ref([] as LotteryCell[])
const recentLabel = ref('宠物蛋 · 钻石+10')

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/**
 * 下拉刷新奖池
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	try {
		pool.value = await fetchLotteryPool()
	} catch (_) {
		pool.value = []
	}
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

type CellView = { icon: string; label: string; isGo: boolean }

/**
 * 组装 3×3：中心为抽一次
 */
const displayCells = computed((): CellView[] => {
	const list: CellView[] = []
	let prizeIdx = 0
	const cells = pool.value
	for (let i = 0; i < 9; i++) {
		if (i === 4) {
			list.push({ icon: 'dice', label: '抽一次', isGo: true })
		} else {
			const p =
				cells[prizeIdx] != null
					? cells[prizeIdx]
					: ({ icon: 'sparkles', label: '奖', index: prizeIdx } as LotteryCell)
			prizeIdx++
			list.push({ icon: toIconName(p.icon, 'sparkles'), label: p.label, isGo: false })
		}
	}
	return list
})

/**
 * 格子 class
 */
function cellClass(i: number): string {
	const base = displayCells.value[i].isGo ? 'cell go' : 'cell'
	if (hiIndex.value === i) return base + ' hi'
	return base
}

/**
 * 点击中心开抽
 */
function onCellClick(i: number): void {
	if (i !== 4) return
	spinLottery()
}

/**
 * 轮转高亮后出结果；联调时先请求 draw 再播动画
 */
async function spinLottery(): Promise<void> {
	if (spinning.value) return
	spinning.value = true
	let winLabel = ''
	let winIcon = 'sparkles'
	try {
		const res = await lotteryDraw(1, 'ticket')
		const first =
			res != null && res.rewards != null && res.rewards.length > 0 ? res.rewards[0] : null
		if (first != null) {
			winLabel = first.name != null ? '' + first.name : ''
			winIcon = toIconName(first.icon != null ? '' + first.icon : 'sparkles', 'sparkles')
		}
	} catch (_) {
		spinning.value = false
		return
	}
	let step = 0
	const total = 16 + Math.floor(Math.random() * 8)
	const cells = pool.value
	const timer = setInterval(() => {
		const ringPos = step % ringOrder.length
		hiIndex.value = ringOrder[ringPos]
		step++
		if (step >= total) {
			clearInterval(timer)
			const winRing = ringOrder[(step - 1) % ringOrder.length]
			const prizePos = ringOrder.indexOf(winRing)
			const prize = cells[prizePos]
			if (winLabel.length == 0 && prize != null) {
				winIcon = toIconName(prize.icon, 'sparkles')
				winLabel = prize.label
			}
			recentLabel.value = winLabel
			showXToast(winIcon, '恭喜获得', winLabel)
			spinning.value = false
			setTimeout(() => {
				hiIndex.value = -1
			}, 800)
		}
	}, 80)
}
</script>

<style>
@import '../../styles/x-base.css';

.lottery {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	margin-bottom: 16px;
}

.cell {
	width: 31%;
	height: 100px;
	border-radius: 14px;
	background-color: #ebe6df;
	align-items: center;
	justify-content: center;
	margin-bottom: 8px;
	padding: 8px;
}

.go {
	background-color: #3db89a;
}

.hi {
	border-width: 2px;
	border-style: solid;
	border-color: #f0a07a;
	background-color: #fff7f0;
}

.cell-em {
	font-size: 20px;
	margin-bottom: 2px;
}

.cell-lb {
	font-size: 10px;
	color: #5c574f;
	font-weight: 500;
}

.go .cell-lb {
	color: rgba(255, 255, 255, 0.9);
}

.recent {
	font-size: 13px;
	color: #5c574f;
}
</style>
