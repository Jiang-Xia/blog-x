<template>
	<!-- 签到日历：当月网格 + sign-info 摘要（网格由连续天数回溯） -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="签到日历"></x-navbar>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view class="x-card summary">
				<text class="sum-t">{{ summaryText }}</text>
				<view class="ring">
					<text class="ring-pct">{{ ringPct }}%</text>
				</view>
			</view>
			<text class="month">{{ monthLabel }}</text>
			<view class="cal">
				<text v-for="h in weekHeads" :key="h" class="hd">{{ h }}</text>
				<view
					v-for="(d, i) in days"
					:key="'d' + i"
					:class="dayClass(d)"
				>
					<text :class="dayTextClass(d)">{{ d.label }}</text>
				</view>
			</view>
			<text class="hint">说明：后端仅提供连续签到，网格按最近连续天数回溯标注</text>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 签到日历：联调 GET /rpg/sign-info
 * 后端无逐日明细；用 lastSignDate + consecutiveSignDays 推算本月命中格
 */
import { fetchSignInfo, type SignInfoSummary } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useTheme } from '../../composables/useTheme'
const { themeCssVars, syncNativeChrome } = useTheme()

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

const weekHeads = ['日', '一', '二', '三', '四', '五', '六']
const now = new Date()
const year = now.getFullYear()
const month = now.getMonth() // 0-based
const todayDate = now.getDate()
const daysInMonth = new Date(year, month + 1, 0).getDate()

const monthLabel = ref(year + ' 年 ' + (month + 1) + ' 月')
const summaryText = ref('加载中…')
const ringPct = ref(0)
/** 本月已签日期（1-based） */
const hits = ref([] as number[])
const todayOn = ref(false)

type DayCell = { label: string; muted: boolean; hit: boolean; on: boolean }

/**
 * 从 lastSignDate + consecutive 推算本月命中日
 */
function buildHitsFromSign(sign: SignInfoSummary): number[] {
	const out: number[] = []
	if (sign.streakDays <= 0 && !sign.signedToday) return out

	let endDay = todayDate
	if (sign.lastSignDate.length >= 10) {
		const parts = sign.lastSignDate.split('-')
		const y = parseInt(parts[0], 10)
		const m = parseInt(parts[1], 10) - 1
		const d = parseInt(parts[2], 10)
		if (y == year && m == month && !isNaN(d)) {
			endDay = d
		} else if (y != year || m != month) {
			// 最近签到不在本月：仅标今日（若今日已签）
			if (sign.signedToday) out.push(todayDate)
			return out
		}
	} else if (sign.signedToday) {
		endDay = todayDate
	}

	const streak = sign.streakDays > 0 ? sign.streakDays : sign.signedToday ? 1 : 0
	for (let i = 0; i < streak; i++) {
		const day = endDay - i
		if (day >= 1 && day <= daysInMonth) out.push(day)
	}
	return out
}

/**
 * 拉取签到摘要并刷新网格
 */
async function loadCalendar(): Promise<void> {
	let sign: SignInfoSummary = {
		signedToday: false,
		streakDays: 0,
		totalSignDays: 0,
		lastSignDate: '',
	}
	try {
		sign = await fetchSignInfo()
	} catch (_) {}
	hits.value = buildHitsFromSign(sign)
	todayOn.value = sign.signedToday
	const signedCount = hits.value.length
	const streak = sign.streakDays > 0 ? sign.streakDays : signedCount
	const total = sign.totalSignDays > 0 ? sign.totalSignDays : signedCount
	summaryText.value =
		'本月约 ' +
		signedCount +
		'/' +
		daysInMonth +
		' · 连续 ' +
		streak +
		' 天 · 累计 ' +
		total +
		' 天'
	ringPct.value = Math.min(100, Math.floor((signedCount / daysInMonth) * 100))
}

/**
 * 下拉刷新日历
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadCalendar()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

/**
 * 构建当月日历（含上月前导 mute）
 */
const days = computed((): DayCell[] => {
	const list: DayCell[] = []
	const firstWeekday = new Date(year, month, 1).getDay()
	const prevDays = new Date(year, month, 0).getDate()
	for (let i = firstWeekday - 1; i >= 0; i--) {
		list.push({
			label: '' + (prevDays - i),
			muted: true,
			hit: false,
			on: false,
		})
	}
	for (let d = 1; d <= daysInMonth; d++) {
		const hit = hits.value.indexOf(d) >= 0
		const on = d === todayDate && (todayOn.value || hit)
		list.push({
			label: '' + d,
			muted: false,
			hit: hit && !on,
			on,
		})
	}
	return list
})

/**
 * 格子容器 class
 */
function dayClass(d: DayCell): string {
	if (d.muted) return 'd muted'
	if (d.on) return 'd on'
	if (d.hit) return 'd hit'
	return 'd'
}

/**
 * 格子文字 class
 */
function dayTextClass(d: DayCell): string {
	if (d.on) return 'd-t on-t'
	if (d.hit) return 'd-t hit-t'
	if (d.muted) return 'd-t muted-t'
	return 'd-t'
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.summary {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.sum-t {
	flex: 1;
	font-size: 13px;
	color: var(--x-ink-2, #5c574f);
	line-height: 1.4;
	margin-right: 12px;
}

.ring {
	width: 56px;
	height: 56px;
	border-radius: 28px;
	border-width: 5px;
	border-style: solid;
	border-color: var(--x-accent, #3db89a);
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
	align-items: center;
	justify-content: center;
}

.ring-pct {
	font-size: 12px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
}

.month {
	font-size: 15px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 10px;
}

.cal {
	flex-direction: row;
	flex-wrap: wrap;
}

.hd {
	width: 14.28%;
	text-align: center;
	font-size: 10px;
	color: var(--x-ink-3, #9a948a);
	padding: 4px 0;
}

.d {
	width: 14.28%;
	height: 40px;
	border-radius: 10px;
	align-items: center;
	justify-content: center;
	background-color: var(--x-bg-2, #ebe6df);
	margin-bottom: 4px;
}

.muted {
	opacity: 0.35;
}

.on {
	background-color: var(--x-accent, #3db89a);
}

.hit {
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
}

.d-t {
	font-size: 11px;
	color: var(--x-ink-2, #5c574f);
}

.on-t {
	color: var(--x-on-ink, #ffffff);
	font-weight: 700;
}

.hit-t {
	color: var(--x-accent-deep, #2a8f76);
	font-weight: 600;
}

.muted-t {
	color: var(--x-ink-3, #9a948a);
}

.hint {
	margin-top: 12px;
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
	line-height: 1.4;
}
</style>
