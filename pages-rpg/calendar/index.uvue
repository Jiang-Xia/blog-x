	border-radius: 28px;
	border-width: 5px;
	border-style: solid;
	border-color: #3db89a;
	background-color: rgba(61, 184, 154, 0.12);
	align-items: center;
	justify-content: center;
}

.ring-pct {
	font-size: 12px;
	font-weight: 700;
	color: #1c1a17;
}

.month {
	font-size: 15px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 10px;
}

.cal {
	flex-direction: row;
	flex-wrap: wrap;
}

.hd {
	width: 14.28%;
	text-align: center;
	font-size: 10px;
	color: #9a948a;
	padding: 4px 0;
}

.d {
	width: 14.28%;
	height: 40px;
	border-radius: 10px;
	align-items: center;
	justify-content: center;
	background-color: #ebe6df;
	margin-bottom: 4px;
}

.muted {
	opacity: 0.35;
}

.on {
	background-color: #3db89a;
}

.hit {
	background-color: rgba(61, 184, 154, 0.12);
}

