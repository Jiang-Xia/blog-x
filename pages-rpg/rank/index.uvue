<template>
	<!-- 排行榜：真实头像 + 分段切换 type -->
	<view class="x-page-flex">
		<x-navbar title="排行榜"></x-navbar>
		<view class="x-seg">
			<view
				v-for="(s, i) in segs"
				:key="s"
				:class="segIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="setSeg(i)"
			>
				<text :class="segIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view
				v-for="row in rows"
				:key="row.rank"
				:class="row.isMe ? 'x-card row me' : 'x-card row'"
			>
				<text class="rank">#{{ row.rank }}</text>
				<view class="av">
					<image
						v-if="row.avatarUrl != null && row.avatarUrl.length > 0"
						class="av-img"
						:src="row.avatarUrl"
						mode="aspectFill"
					></image>
					<text v-else class="em">{{ row.emoji }}</text>
				</view>
				<view class="body">
					<text class="name">{{ row.name }}{{ row.isMe ? '（我）' : '' }}</text>
					<text class="x-meta">Lv.{{ row.level }}</text>
				</view>
				<text class="score">{{ row.score }}</text>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 排行榜：联调 GET /rpg/leaderboard；头像用接口 avatar 字段
 * 滚动：接口一次返回 TopN，仅下拉刷新 + 纵向滚动
 */
import type { RankRow } from '../../types/rpg'
import { fetchLeaderboard } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'

const segs = ['本周经验', '钻石', '连续签到']
const types = ['exp', 'currency', 'signDays']
const segIndex = ref(0)
const rows = ref([] as RankRow[])

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(20)

/**
 * 切换分段并刷新
 */
function setSeg(i: number): void {
	segIndex.value = i
	onRefresh()
}

/**
 * 按分段拉榜
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const type = types[segIndex.value]
	try {
		rows.value = await fetchLeaderboard(type, 20, 'week')
	} catch (_) {
		rows.value = []
	}
	endRefresh(rows.value.length, rows.value.length, rows.value.length)
}

onMounted(() => {
	onRefresh()
})
</script>

<style>
@import '../../styles/x-base.css';

.row {
	flex-direction: row;
	align-items: center;
}

.me {
	border-width: 1.5px;
	border-style: solid;
	border-color: #3db89a;
}

.rank {
	font-size: 14px;
	font-weight: 700;
	color: #9a948a;
	width: 40px;
}

.av {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: #ebe6df;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
	overflow: hidden;
}

.av-img {
	width: 36px;
	height: 36px;
}

.em {
	font-size: 18px;
}

.body {
	flex: 1;
}

.name {
	font-size: 14px;
	font-weight: 650;
	color: #1c1a17;
}

.score {
	font-size: 14px;
	font-weight: 700;
	color: #2a8f76;
}
</style>
