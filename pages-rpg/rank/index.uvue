<template>
	<!-- 排行榜：周期 + 维度双 Tab，对齐 Nuxt LeaderboardPanel；头像进公开主页 -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="排行榜"></x-navbar>
		<view class="x-seg">
			<view
				v-for="(s, i) in periodLabels"
				:key="'p' + i"
				:class="periodIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="setPeriod(i)"
			>
				<text :class="periodIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>
		<view class="x-seg type-seg">
			<view
				v-for="(s, i) in typeLabels"
				:key="'t' + i"
				:class="typeIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="setType(i)"
			>
				<text :class="typeIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>
		<x-scroll-page
			:enable-load-more="false"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-if="rows.length == 0 && !refreshing" class="empty">
				<text class="x-meta">暂无排行数据</text>
			</view>
			<view
				v-for="row in rows"
				:key="row.rank + '-' + row.uid"
				:class="rowClass(row)"
			>
				<text :class="rankClass(row.rank)">{{ rankText(row.rank) }}</text>
				<view class="av" @click="onAvatar(row.uid)">
					<image
						v-if="row.avatarUrl != null && row.avatarUrl.length > 0"
						class="av-img"
						:src="row.avatarUrl"
						mode="aspectFill"
					></image>
					<text v-else class="av-fall">{{ nameInitial(row.name) }}</text>
				</view>
				<view class="body" @click="onAvatar(row.uid)">
					<text class="name">{{ row.name }}{{ row.isMe ? '（我）' : '' }}</text>
					<text class="x-meta">LV{{ row.level }}</text>
				</view>
				<text class="score">{{ row.scoreLabel }}</text>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 排行榜：联调 GET /rpg/leaderboard
 * 展示对齐 Nuxt RpgLeaderboardPanel：周期(总/赛季/周/月) × 维度(经验/声望/钻石/等级/签到)
 * 头像/昵称跳转公开主页
 */
import type { RankRow } from '../../types/rpg'
import { fetchLeaderboard } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useUserStore } from '../../store/user'
import { goPublicProfile } from '../../utils/nav-profile'
import { useTheme } from '../../composables/useTheme'
const { themeCssVars, syncNativeChrome } = useTheme()

const periodLabels = ['总榜', '赛季榜', '周榜', '月榜']
const periodKeys = ['total', 'season', 'week', 'month']
const typeLabels = ['经验', '声望', '钻石', '等级', '签到']
const typeKeys = ['exp', 'reputation', 'currency', 'level', 'signDays']

const periodIndex = ref(0)
const typeIndex = ref(0)
const rows = ref([] as RankRow[])
const userStore = useUserStore()

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(50)

/**
 * 行样式：本人高亮 / Top3
 */
function rowClass(row: RankRow): string {
	let c = 'x-card row'
	if (row.isMe == true) c = c + ' me'
	if (row.rank <= 3) c = c + ' top'
	return c
}

/**
 * 名次样式
 */
function rankClass(rank: number): string {
	if (rank == 1) return 'rank gold'
	if (rank == 2) return 'rank silver'
	if (rank == 3) return 'rank bronze'
	return 'rank'
}

/**
 * Top3 奖牌文案，其余数字
 */
function rankText(rank: number): string {
	if (rank == 1) return '🥇'
	if (rank == 2) return '🥈'
	if (rank == 3) return '🥉'
	return '#' + rank
}

/**
 * 昵称首字兜底
 */
function nameInitial(name: string): string {
	if (name == null || name.length == 0) return '?'
	return name.substring(0, 1)
}

/**
 * 切换周期并刷新
 */
function setPeriod(i: number): void {
	periodIndex.value = i
	onRefresh()
}

/**
 * 切换维度并刷新
 */
function setType(i: number): void {
	typeIndex.value = i
	onRefresh()
}

/**
 * 头像/昵称 → 公开主页
 */
function onAvatar(uid: number): void {
	goPublicProfile(uid)
}

/**
 * 按当前 Tab 拉榜（limit=50，与 Nuxt RPG 页一致）
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const type = typeKeys[typeIndex.value]
	const period = periodKeys[periodIndex.value]
	const myUid = userStore.loggedIn ? userStore.profile.id : 0
	try {
		rows.value = await fetchLeaderboard(type, 50, period, myUid)
	} catch (_) {
		rows.value = []
	}
	endRefresh(rows.value.length, rows.value.length, rows.value.length)
}

onMounted(() => {
	onRefresh()
})

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.type-seg {
	margin-top: 0;
	margin-bottom: 8px;
}

.row {
	flex-direction: row;
	align-items: center;
}

.me {
	border-width: 1.5px;
	border-style: solid;
	border-color: var(--x-accent, #3db89a);
}

.top {
	background-color: rgba(246, 217, 168, 0.28);
}

.rank {
	font-size: 14px;
	font-weight: 700;
	color: var(--x-ink-3, #9a948a);
	width: 40px;
	text-align: center;
}

.gold {
	color: #c9a227;
}

.silver {
	color: #8a8580;
}

.bronze {
	color: #b87333;
}

.av {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: var(--x-bg-2, #ebe6df);
	align-items: center;
	justify-content: center;
	margin-right: 10px;
	overflow: hidden;
}

.av-img {
	width: 36px;
	height: 36px;
}

.av-fall {
	font-size: 14px;
	font-weight: 700;
	color: var(--x-ink-2, #5c574f);
}

.body {
	flex: 1;
}

.name {
	font-size: 14px;
	font-weight: 650;
	color: var(--x-ink, #1c1a17);
}

.score {
	font-size: 13px;
	font-weight: 700;
	color: var(--x-accent-deep, #2a8f76);
}

.empty {
	padding: 24px 0;
	align-items: center;
}
</style>
