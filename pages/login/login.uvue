<template>
	<!-- 登录：品牌 + 微信一键登录示意 -->
	<view class="x-page">
		<x-navbar title="登录"></x-navbar>
		<view class="brand">
			<text class="brand-em">🦊</text>
			<text class="brand-name">江夏的博客</text>
		</view>
		<view class="wx-btn" @click="onLogin">
			<text class="wx-text">微信一键登录</text>
		</view>
		<view class="unlock">
			<text class="x-chip">评论回复</text>
			<text class="x-chip x-chip-peach">签到抽奖</text>
			<text class="x-chip x-chip-lav">收藏同步</text>
		</view>
		<text class="proto">登录即表示同意用户协议与隐私政策（示意）</text>
	</view>
</template>

<script setup lang="ts">
/**
 * 登录页：联调微信小程序登录；USE_MOCK 或非微信端回落示意 token
 */
import { USE_MOCK } from '../../api/config'
import { loginByWeixin } from '../../api/modules/auth'
import { showXToast } from '../../utils/toast'
import { setToken } from '../../utils/storage'
import { goTab, TAB_ME } from '../../utils/tabNav'

/**
 * 登录成功后回退
 */
function afterLoginOk(): void {
	showXToast('✅', '登录成功', '欢迎回来')
	setTimeout(() => {
		uni.navigateBack({
			fail: () => {
				goTab(TAB_ME)
			},
		})
	}, 500)
}

/**
 * 微信一键登录（或 mock）
 */
async function onLogin(): Promise<void> {
	if (USE_MOCK) {
		setToken('mock_token_' + Date.now())
		afterLoginOk()
		return
	}
	try {
		await loginByWeixin()
		afterLoginOk()
	} catch (_) {
		showXToast('⚠️', '登录失败', '可改 USE_MOCK 或检查微信登录配置')
	}
}
</script>

