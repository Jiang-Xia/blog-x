<template>
	<!-- 消息中心：分段按 kind 过滤 + 全部已读 -->
	<view class="x-page-flex">
		<x-navbar title="消息中心">
			<template v-slot:right>
				<text class="read-all" @click="onReadAll">全部已读</text>
			</template>
		</x-navbar>

		<view class="x-seg">
			<view
				v-for="(s, i) in segs"
				:key="s"
				:class="segIndex === i ? 'x-seg-item x-seg-item-on' : 'x-seg-item'"
				@click="setSeg(i)"
			>
				<text :class="segIndex === i ? 'x-seg-text x-seg-text-on' : 'x-seg-text'">{{ s }}</text>
			</view>
		</view>

		<x-scroll-page
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-for="item in filtered" :key="item.id" class="msg">
				<view class="msg-row">
					<view class="msg-em">
						<x-icon :name="item.icon" :size="22" color="#1c1a17"></x-icon>
					</view>
					<view class="msg-body">
						<text class="msg-title">{{ item.title }}</text>
						<text class="msg-desc">{{ item.desc }}</text>
					</view>
				</view>
			</view>
			<x-empty v-if="filtered.length == 0 && showFooter" text="暂无消息"></x-empty>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 消息中心：联调 /notification/list + read
 * 分段「全部/评论/赞藏/系统」按 NotifyItem.kind 前端过滤（后端 list 无 type 筛选参数）
 * 滚动：x-scroll-page 下拉刷新 + 上滑加载更多
 */
import type { NotifyItem } from '../../types/notify'
import { fetchNotifications, markNotificationsRead } from '../../api/modules/notification'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'

const store = useMockStore()

const segs = ['全部', '评论', '赞藏', '系统']
/** 与 segs 下标对齐；空串 = 全部 */
const segKinds = ['', 'comment', 'like', 'system']
const segIndex = ref(0)
const allItems = ref([] as NotifyItem[])

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
} = useListScroll(20)

/** 当前分段过滤后的列表 */
const filtered = computed((): NotifyItem[] => {
	const kind = segKinds[segIndex.value]
	if (kind.length == 0) return allItems.value
	const list: NotifyItem[] = []
	for (let i = 0; i < allItems.value.length; i++) {
		if (allItems.value[i].kind == kind) list.push(allItems.value[i])
	}
	return list
})

/**
 * 切换分段（uvue 避免模板内直接赋值）
 */
function setSeg(i: number): void {
	segIndex.value = i
}

/**
 * 拉取一页通知
 */
async function fetchPage(page: number): Promise<NotifyItem[]> {
	try {
		return await fetchNotifications(page, pageSize)
	} catch (_) {
		return []
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	const rows = await fetchPage(1)
	allItems.value = rows
	endRefresh(rows.length, allItems.value.length)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const rows = await fetchPage(p)
	for (let i = 0; i < rows.length; i++) {
		allItems.value.push(rows[i])
	}
	endLoadMore(rows.length, allItems.value.length)
}

onMounted(() => {
	onRefresh()
})

/**
 * 全部已读：清角标 + PATCH /notification/read
 */
async function onReadAll(): Promise<void> {
	store.notifyBadge.value = 0
	try {
		await markNotificationsRead()
	} catch (_) {}
	showXToast('check', '全部已读', '角标已清')
}
</script>

<style>
@import '../../styles/x-base.css';

.read-all {
	font-size: 12px;
	color: #3db89a;
	font-weight: 500;
}

.msg {
	background-color: #ffffff;
	border-radius: 18px;
	padding: 12px 13px;
	margin-bottom: 10px;
}

.msg-row {
	flex-direction: row;
}

.msg-em {
	margin-right: 10px;
	align-items: center;
	justify-content: center;
}

.msg-body {
	flex: 1;
}

.msg-title {
	font-size: 13px;
	font-weight: 600;
	color: #1c1a17;
	margin-bottom: 4px;
}

.msg-desc {
	font-size: 12px;
	color: #5c574f;
	line-height: 1.4;
}
</style>
