<template>
	<!-- 搜索：关键词模糊（标题/摘要/正文）+ 分类/标签精确筛选；空关键词=全部 -->
	<view class="x-page-flex" :style="themeCssVars">
		<x-navbar title="搜索"></x-navbar>
		<view class="x-page-head">
		<view class="query-row">
			<input
				class="query-input"
				type="text"
				v-model="query"
				placeholder="搜索标题、摘要、正文…"
				placeholder-class="query-ph"
				confirm-type="search"
				@confirm="onSearch"
			/>
			<text class="search-btn" @click="onSearch">搜索</text>
			<text class="clear" @click="onClear">清除</text>
		</view>

		<!-- 分类 / 标签：单行横滑；精确筛选 -->
		<x-category-chips
			:items="categories"
			:active-index="catActiveIndex"
			@select="onSelectCatChip"
		></x-category-chips>
		<x-tag-chips
			:items="tagOptions"
			:selected-ids="selectedTagIds"
			@toggle="onToggleTag"
		></x-tag-chips>
		</view>

		<x-scroll-page
			:enable-refresh="searched"
			:enable-load-more="searched"
			:refreshing="refreshing"
			:pulling-distance="pullingDistance"
			:footer-text="footerText"
			:show-footer="searched && showFooter"
			@refresh="onRefresh"
			@loadmore="onLoadMore"
			@refresherpulling="onRefresherPulling"
			@refresherrestore="onRefresherRestore"
			@refresherabort="onRefresherAbort"
		>
			<view v-if="history.length > 0 && !searched" class="hist-block">
				<view class="hist-head">
					<text class="hist-title">最近搜索</text>
					<text class="hist-clear" @click="onClearHistory">清空</text>
				</view>
				<view class="chip-row">
					<view
						v-for="(h, i) in history"
						:key="'h' + i"
						class="x-chip x-chip-plain"
						@click="onChip(h)"
					>
						<text class="chip-t">{{ h }}</text>
					</view>
				</view>
			</view>

			<x-article-card
				v-for="item in results"
				:key="item.id"
				:id="item.id"
				:title="item.title"
				:category-name="item.categoryName"
				:time-label="item.timeLabel"
				:cover-url="item.coverUrl"
				:cover-icon="item.coverIcon"
				:cover-c1="item.coverC1"
				:like-count="item.likeCount"
				:comment-count="item.commentCount"
				:show-stat="false"
				@open="goDetail"
			></x-article-card>
			<view v-if="searched && results.length == 0 && showFooter" class="empty-tip">
				<text class="x-meta">暂无相关文章</text>
			</view>
		</x-scroll-page>
	</view>
</template>

<script setup lang="ts">
/**
 * 搜索页：对齐 Nuxt ArticleList
 * - 关键词同时写入 title/description/content（服务端 OR 模糊）
 * - 分类/标签：x-category-chips / x-tag-chips 单行横滑；UUID 精确
 * - 空关键词点击搜索 → 返回全部（可叠加分类/标签）
 * 数据来源：POST /article/list；筛选选项 GET /category、/tag
 */
import type { ArticleSummary, CategoryChip } from '../../types/article'
import {
	fetchArticleList,
	fetchCategories,
	fetchTags,
	type CategoryOption,
	type TagWallItem,
} from '../../api/modules/article'
import { useListScroll } from '../../composables/useListScroll'
import { useTheme } from '../../composables/useTheme'
import {
	clearSearchHistory,
	getSearchHistory,
	pushSearchHistory,
} from '../../utils/storage'
import { showXToast } from '../../utils/toast'

const { themeCssVars, syncNativeChrome } = useTheme()

const query = ref('')
const results = ref([] as ArticleSummary[])
const history = ref([] as string[])
const searched = ref(false)
const categories = ref([{ id: '', label: '全部分类' }] as CategoryOption[])
const catId = ref('')
const tagOptions = ref([] as TagWallItem[])
/** 已选标签 UUID */
const selectedTagIds = ref([] as string[])

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
	resetPaging,
} = useListScroll(20)

/**
 * 刷新本地搜索历史 chip
 */
function reloadHistory(): void {
	history.value = getSearchHistory()
}

/**
 * 当前分类在 chips 中的下标（供 x-category-chips）
 */
const catActiveIndex = computed((): number => {
	const list = categories.value
	for (let i = 0; i < list.length; i++) {
		if (list[i].id == catId.value) return i
	}
	return 0
})

/**
 * 按页拉取（空关键词不传 title/description/content）
 */
async function fetchPage(page: number, q: string): Promise<{ list: ArticleSummary[]; total: number }> {
	try {
		const body: {
			page: number
			pageSize: number
			client: boolean
			title?: string
			description?: string
			content?: string
			category?: string
			tags?: string[]
		} = { page, pageSize, client: true }
		if (q.length > 0) {
			body.title = q
			body.description = q
			body.content = q
		}
		if (catId.value.length > 0) body.category = catId.value
		if (selectedTagIds.value.length > 0) body.tags = selectedTagIds.value.slice()
		const res = await fetchArticleList(body)
		return { list: res.list, total: res.total }
	} catch (_) {
		return { list: [], total: 0 }
	}
}

/**
 * 执行搜索；空关键词仍拉列表（全部 + 当前筛选）
 */
async function doSearch(raw: string): Promise<void> {
	const q = raw.trim()
	query.value = q
	if (q.length > 0) {
		history.value = pushSearchHistory(q)
	}
	searched.value = true
	beginRefresh()
	const res = await fetchPage(1, q)
	results.value = res.list
	endRefresh(res.list.length, results.value.length, res.total)
}

/**
 * 下拉刷新当前关键词
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	if (!searched.value) {
		endRefresh(0, 0)
		return
	}
	const res = await fetchPage(1, query.value.trim())
	results.value = res.list
	endRefresh(res.list.length, results.value.length, res.total)
}

/**
 * 上滑加载更多
 */
async function onLoadMore(): Promise<void> {
	if (!searched.value) return
	const p = beginLoadMore()
	if (p <= 0) return
	const res = await fetchPage(p, query.value.trim())
	for (let i = 0; i < res.list.length; i++) {
		results.value.push(res.list[i])
	}
	endLoadMore(res.list.length, results.value.length, res.total)
}

/**
 * 加载分类 / 标签筛选项
 */
async function loadFilters(): Promise<void> {
	try {
		const rows = await fetchCategories()
		const chips: CategoryOption[] = [{ id: '', label: '全部分类' }]
		for (let i = 0; i < rows.length; i++) {
			chips.push(rows[i])
		}
		categories.value = chips
	} catch (_) {
		categories.value = [{ id: '', label: '全部分类' }]
	}
	try {
		tagOptions.value = await fetchTags()
	} catch (_) {
		tagOptions.value = []
	}
}

onLoad((options) => {
	reloadHistory()
	loadFilters()
	const q =
		options != null && options['q'] != null && ('' + options['q']).length > 0
			? decodeURIComponent('' + options['q'])
			: ''
	const tagId =
		options != null && options['tagId'] != null ? decodeURIComponent('' + options['tagId']) : ''
	const category =
		options != null && options['category'] != null
			? decodeURIComponent('' + options['category'])
			: ''
	if (tagId.length > 0) {
		selectedTagIds.value = [tagId]
	}
	if (category.length > 0) {
		catId.value = category
	}
	// 有关键词 / 精确筛选 / 路由强制搜 → 直接出结果；否则展示历史
	if (q.length > 0 || tagId.length > 0 || category.length > 0) {
		doSearch(q)
	}
})

function onSearch(): void {
	doSearch(query.value)
}

/**
 * 点击历史 chip 再搜
 */
function onChip(h: string): void {
	doSearch(h)
}

/**
 * 分类 chip 选中（x-category-chips → index + chip）
 */
function onSelectCatChip(i: number, chip: CategoryChip): void {
	if (chip == null) return
	catId.value = chip.id != null ? chip.id : ''
	resetPaging()
	doSearch(query.value)
}

/**
 * 切换标签多选精确筛选
 */
function onToggleTag(id: string): void {
	const idx = selectedTagIds.value.indexOf(id)
	if (idx >= 0) {
		selectedTagIds.value.splice(idx, 1)
	} else {
		selectedTagIds.value.push(id)
	}
	resetPaging()
	doSearch(query.value)
}

function onClear(): void {
	query.value = ''
	results.value = []
	searched.value = false
	catId.value = ''
	selectedTagIds.value = []
	resetPaging()
	showXToast('eraser', '已清除', '')
}

function onClearHistory(): void {
	clearSearchHistory()
	history.value = []
	showXToast('eraser', '已清空历史', '')
}

function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}

onShow(() => {
	syncNativeChrome()
})
</script>

<style>
@import '../../styles/x-base.css';

.query-row {
	flex-direction: row;
	align-items: center;
	background-color: var(--x-surface, #ffffff);
	border-radius: 999px;
	padding: 8px 12px;
	margin-bottom: 10px;
}

.query-input {
	flex: 1;
	font-size: 14px;
	color: var(--x-ink, #1c1a17);
	font-weight: 600;
	height: 28px;
}

.query-ph {
	color: var(--x-ink-3, #9a948a);
	font-weight: 400;
}

.search-btn {
	font-size: 12px;
	color: var(--x-accent, #3db89a);
	font-weight: 600;
	margin-left: 8px;
	margin-right: 8px;
}

.clear {
	font-size: 12px;
	color: var(--x-ink-3, #9a948a);
}

.hist-block {
	margin-bottom: 12px;
}

.hist-head {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 8px;
}

.hist-title {
	font-size: 12px;
	font-weight: 600;
	color: var(--x-ink-2, #5c574f);
}

.hist-clear {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.chip-row {
	flex-direction: row;
	flex-wrap: wrap;
}

.chip-t {
	font-size: 11px;
	color: var(--x-ink-2, #5c574f);
	font-weight: 500;
}

.chip-t-dark {
	font-size: 11px;
	color: var(--x-on-ink, #ffffff);
	font-weight: 500;
}

.empty-tip {
	align-items: center;
	padding: 24px 0;
}
</style>
