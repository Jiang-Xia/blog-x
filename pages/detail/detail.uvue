	background-color: rgba(61, 184, 154, 0.08);
}

.ai-label {
	font-size: 12px;
	font-weight: 600;
	color: #2a8f76;
	margin-bottom: 6px;
}

.ai-body {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.5;
}

.related {
	height: 90px;
	margin-bottom: 12px;
}

.related-inner {
	flex-direction: row;
}

.mini {
	width: 120px;
	border-radius: 14px;
	padding: 10px;
	background-color: #ffffff;
	margin-right: 8px;
}

.mini-em {
	font-size: 20px;
	margin-bottom: 4px;
}

.mini-t {
	font-size: 12px;
	font-weight: 650;
	color: #1c1a17;
	lines: 2;
	text-overflow: ellipsis;
}

.cmt-compose {
	flex-direction: row;
	align-items: center;
	margin-bottom: 12px;
}

.cmt-field {
	flex: 1;
	height: 40px;
	border-radius: 14px;
	background-color: #ffffff;
	padding: 0 12px;
	font-size: 13px;
	color: #1c1a17;
	margin-right: 8px;
}

.cmt-send {
	padding: 10px 14px;
	border-radius: 14px;
	background-color: #3db89a;
}

.cmt-send-t {
	font-size: 13px;
	font-weight: 600;
	color: #ffffff;
}

.comment {
	flex-direction: row;
	margin-bottom: 12px;
}

.cav {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background-color: #f0e6d8;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
}

.bubble {
	flex: 1;
	background-color: #ffffff;
	border-radius: 16px;
	padding: 10px 12px;
}

.c-name {
	font-size: 12px;
	font-weight: 600;
	color: #1c1a17;
	margin-bottom: 4px;
}

.c-text {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.45;
}

.bottom-pad {
	height: 24px;
}

.action-bar {
	position: fixed;
	left: 14px;
	right: 14px;
	bottom: 14px;
	height: 52px;
	background-color: rgba(255, 255, 255, 0.95);
	border-radius: 18px;
	flex-direction: row;
	align-items: center;
	padding: 0 12px;
	z-index: 30;
}

.cmt-input {
	flex: 1;
	height: 34px;
	border-radius: 16px;
	background-color: #ebe6df;
	justify-content: center;
	padding: 0 12px;
	margin-right: 8px;
}

.cmt-ph {
	font-size: 12px;
	color: #9a948a;
}

.act {
	align-items: center;
	margin-left: 6px;
	min-width: 36px;
}

.ic {
	width: 20px;
	height: 20px;
	border-radius: 6px;
	background-color: #ebe6df;
	margin-bottom: 2px;
}

.on .ic {
	background-color: rgba(232, 137, 122, 0.22);
}

.fav-on .ic {
	background-color: rgba(246, 217, 168, 0.65);
}

.tip {
	background-color: rgba(61, 184, 154, 0.25);
}

.act-t {
	font-size: 10px;
	color: #9a948a;
}
</style>
