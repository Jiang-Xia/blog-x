	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: #f0e6d8;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
	overflow: hidden;
}

.av-img {
	width: 36px;
	height: 36px;
}

.av-em {
	font-size: 16px;
}

