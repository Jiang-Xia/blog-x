<template>
	<!-- 文章详情：正文占位、AI、相关、评论发表、底栏赞藏赏 -->
	<view class="page-wrap">
		<scroll-view class="x-page detail-scroll" scroll-y="true">
			<x-navbar title="文章">
				<template v-slot:right>
					<text class="nav-more">⋯  ↗</text>
				</template>
			</x-navbar>

			<view class="author-row">
				<view class="x-avatar av">
					<text>{{ article.authorEmoji }}</text>
				</view>
				<view class="author-meta">
					<text class="author-name">{{ article.authorName }}</text>
					<text class="x-meta">{{ article.readLabel }}</text>
				</view>
			</view>

			<text class="detail-title">{{ article.title }}</text>
			<text class="x-meta meta-line">{{ article.categoryName }} · {{ article.timeLabel }}</text>

			<view class="prose">
				<view class="l"></view>
				<view class="l"></view>
				<view class="l s"></view>
				<view class="code"></view>
				<view class="l"></view>
				<view class="l s"></view>
			</view>

			<view class="x-card ai-card" @click="goAi">
				<text class="ai-label">✦ AI 摘要</text>
				<text class="ai-body">{{ article.aiSummary }}</text>
			</view>

			<view class="x-section-head">
				<text class="x-section-title">相关阅读</text>
			</view>
			<scroll-view class="related" scroll-x="true">
				<view class="related-inner">
					<view
						v-for="m in related"
						:key="m.id"
						class="mini"
						@click="goDetail(m.id)"
					>
						<text class="mini-em">{{ m.emoji }}</text>
						<text class="mini-t">{{ m.title }}</text>
					</view>
				</view>
			</scroll-view>

			<view class="x-section-head">
				<text class="x-section-title">评论</text>
			</view>
			<view class="cmt-compose">
				<input
					class="cmt-field"
					type="text"
					v-model="commentDraft"
					placeholder="说点什么…"
					placeholder-class="cmt-ph"
					confirm-type="send"
					@confirm="onSubmitComment"
				/>
				<view class="cmt-send" @click="onSubmitComment">
					<text class="cmt-send-t">发送</text>
				</view>
			</view>
			<view v-for="(c, idx) in comments" :key="idx" class="comment">
				<view class="cav">
					<text>{{ c.emoji }}</text>
				</view>
				<view class="bubble">
					<text class="c-name">{{ c.name }} {{ c.tag }}</text>
					<text class="c-text">{{ c.text }}</text>
				</view>
			</view>
			<view class="bottom-pad"></view>
		</scroll-view>

		<view class="action-bar">
			<view class="cmt-input" @click="focusCompose">
				<text class="cmt-ph">{{ commentDraft.length > 0 ? commentDraft : '说点什么…' }}</text>
			</view>
			<view class="act" @click="onLike">
				<view :class="liked ? 'ic ic-on' : 'ic'"></view>
				<text class="act-t">赞</text>
			</view>
			<view class="act" @click="onFav">
				<view :class="faved ? 'ic ic-fav' : 'ic'"></view>
				<text class="act-t">藏</text>
			</view>
			<view class="act" @click="tipOpen = true">
				<view class="ic tip"></view>
				<text class="act-t">赏</text>
			</view>
		</view>

		<x-tip-sheet :open="tipOpen" @close="tipOpen = false" @paid="onTipPaid"></x-tip-sheet>
	</view>
</template>

<script setup lang="ts">
/**
 * 文章详情：联调 info/views/related/comment + 赞藏 + 发表评论 + 钻石打赏
 * 失败回落 mock；赏打开 tip-sheet（paid 带 amount）
 */
import { articles, detailComments, relatedMinis } from '../../mock/data'
import type { ArticleDetail } from '../../types/article'
import {
	fetchArticleInfo,
	fetchRelatedArticles,
	reportArticleViews,
} from '../../api/modules/article'
import {
	addComment,
	checkCollected,
	checkLiked,
	fetchComments,
	tipArticle,
	toggleCollect,
	toggleLike,
} from '../../api/modules/interact'
import { apiOrMock } from '../../composables/useApiOrMock'
import { USE_MOCK } from '../../api/config'
import {
	isMockFaved,
	isMockLiked,
	toggleMockFav,
	toggleMockLike,
} from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { showXToast } from '../../utils/toast'

type CommentRow = { emoji: string; name: string; tag: string; text: string }

const article = ref(articles[0] as ArticleDetail)
const related = ref(relatedMinis as Array<{ id: string; emoji: string; title: string }>)
const comments = ref(detailComments as CommentRow[])
const tipOpen = ref(false)
const liked = ref(false)
const faved = ref(false)
const articleId = ref('0')
const commentDraft = ref('')
const submitting = ref(false)
const userStore = useUserStore()

/**
 * 将服务端评论列表映射为展示行
 */
function mapCommentRows(res: any): CommentRow[] {
	const arr = res != null && res.list != null ? res.list : []
	const out: CommentRow[] = []
	for (let i = 0; i < arr.length; i++) {
		const c = arr[i]
		out.push({
			emoji: '💬',
			name: c.userInfo != null && c.userInfo.nickname != null ? '' + c.userInfo.nickname : '用户',
			tag: '',
			text: c.content != null ? '' + c.content : '',
		})
	}
	return out
}

/**
 * 重新拉取评论列表
 */
async function reloadComments(id: string): Promise<void> {
	const cmt = await apiOrMock(async () => {
		const res = await fetchComments(id)
		const rows = mapCommentRows(res)
		return rows.length > 0 ? rows : detailComments
	}, detailComments)
	comments.value = cmt
}

/**
 * 加载详情、相关、评论与赞藏状态
 */
async function loadDetail(id: string): Promise<void> {
	const mockArt = articles[0]
	for (let i = 0; i < articles.length; i++) {
		if (articles[i].id === id) {
			article.value = articles[i]
			break
		}
	}
	const info = await apiOrMock(() => fetchArticleInfo(id), null as ArticleDetail | null)
	if (info != null) {
		article.value = info
	} else if (article.value.id !== id) {
		article.value = mockArt
	}
	reportArticleViews(id).catch(() => {})

	const rel = await apiOrMock(async () => {
		const list = await fetchRelatedArticles(id, 6)
		return list.map((a) => ({
			id: a.id,
			emoji: a.coverEmoji,
			title: a.title,
		}))
	}, relatedMinis)
	related.value = rel

	await reloadComments(id)

	if (USE_MOCK) {
		liked.value = isMockLiked(id)
		faved.value = isMockFaved(id)
	} else {
		liked.value = await checkLiked(id)
		faved.value = await checkCollected(id)
	}
}

onLoad((options) => {
	const id = options != null && options['id'] != null ? '' + options['id'] : '0'
	articleId.value = id
	loadDetail(id)
})

function goAi(): void {
	uni.navigateTo({ url: '/pages-blog/ai/index' })
}

function goDetail(id: string): void {
	uni.redirectTo({ url: '/pages/detail/detail?id=' + id })
}

/** 底栏点输入区时提示滚动到评论框 */
function focusCompose(): void {
	showXToast('💬', '评论', '请在上方评论框输入')
}

/**
 * 发表评论：POST /comment/create
 */
async function onSubmitComment(): Promise<void> {
	const text = commentDraft.value.trim()
	if (text.length == 0 || submitting.value) return
	if (!USE_MOCK && !userStore.loggedIn) {
		showXToast('🔐', '请先登录', '')
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	if (USE_MOCK) {
		comments.value = [
			{ emoji: '🦊', name: '我', tag: '', text: text },
		].concat(comments.value)
		commentDraft.value = ''
		showXToast('💬', '已评论', 'mock')
		return
	}
	submitting.value = true
	try {
		const res = await addComment(articleId.value, text)
		commentDraft.value = ''
		const status = res != null && res.status != null ? '' + res.status : ''
		if (status == 'pending') {
			showXToast('⏳', '已提交', '待审核后展示')
		} else {
			showXToast('💬', '评论成功', '')
		}
		await reloadComments(articleId.value)
	} catch (_) {
	} finally {
		submitting.value = false
	}
}

/**
 * 点赞：联调 POST /like
 */
async function onLike(): Promise<void> {
	if (USE_MOCK) {
		liked.value = toggleMockLike(articleId.value)
		showXToast(liked.value ? '❤️' : '🤍', liked.value ? '已点赞' : '取消点赞', '')
		return
	}
	try {
		await toggleLike(articleId.value)
		liked.value = await checkLiked(articleId.value)
		showXToast(liked.value ? '❤️' : '🤍', liked.value ? '已点赞' : '取消点赞', '')
	} catch (_) {}
}

/**
 * 收藏：联调 POST /collect
 */
async function onFav(): Promise<void> {
	if (USE_MOCK) {
		faved.value = toggleMockFav(articleId.value)
		showXToast(faved.value ? '⭐' : '☆', faved.value ? '已收藏' : '取消收藏', '')
		return
	}
	try {
		await toggleCollect(articleId.value)
		faved.value = await checkCollected(articleId.value)
		showXToast(faved.value ? '⭐' : '☆', faved.value ? '已收藏' : '取消收藏', '')
	} catch (_) {}
}

/**
 * tip-sheet 钻石打赏：联调 POST /rpg/article/tip
 */
async function onTipPaid(amount: number): Promise<void> {
	if (USE_MOCK) return
	const idNum = parseInt(articleId.value, 10)
	if (isNaN(idNum)) return
	const tipAmount = amount > 0 ? amount : 1
	try {
		await tipArticle(idNum, tipAmount)
		showXToast('💎', '打赏成功', tipAmount + ' 钻石')
	} catch (_) {}
}
</script>

<style>
.page-wrap {
	flex: 1;
	background-color: #f4f1ec;
}

.detail-scroll {
	flex: 1;
	padding-bottom: 80px;
}

.nav-more {
	font-size: 12px;
	color: #5c574f;
}

.author-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 12px;
}

.av {
	width: 36px;
	height: 36px;
	margin-right: 10px;
}

.author-name {
	font-size: 13px;
	font-weight: 600;
	color: #1c1a17;
}

.detail-title {
	font-size: 20px;
	font-weight: 700;
	color: #1c1a17;
	line-height: 1.35;
	margin-bottom: 8px;
}

