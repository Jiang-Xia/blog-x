	flex-direction: row;
	margin-bottom: 12px;
}

.cav {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background-color: #f0e6d8;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
	overflow: hidden;
}

