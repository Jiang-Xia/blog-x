	background-color: rgba(255, 255, 255, 0.95);
	border-radius: 18px;
	flex-direction: row;
	align-items: center;
	padding: 0 12px;
	z-index: 30;
}

.cmt-input {
	flex: 1;
	height: 34px;
	border-radius: 16px;
	background-color: #ebe6df;
	justify-content: center;
	padding: 0 12px;
	margin-right: 8px;
}

