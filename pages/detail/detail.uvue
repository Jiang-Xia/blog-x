	font-size: 13px;
	color: #5c574f;
	line-height: 1.5;
}

.related {
	/* 横滑展示全部相关；标题完整换行，高度留足 */
	height: 200px;
	margin-bottom: 12px;
	flex-direction: row;
}

.related-inner {
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: stretch;
	padding-right: 8px;
}

.mini {
	width: 148px;
