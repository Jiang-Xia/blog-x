<template>
	<!-- 文章详情：正文占位、AI、相关、评论、底栏赞藏赏 -->
	<view class="page-wrap">
		<scroll-view class="x-page detail-scroll" scroll-y="true">
			<x-navbar title="文章">
				<template v-slot:right>
					<text class="nav-more">⋯  ↗</text>
				</template>
			</x-navbar>

			<view class="author-row">
				<view class="x-avatar av">
					<text>{{ article.authorEmoji }}</text>
				</view>
				<view class="author-meta">
					<text class="author-name">{{ article.authorName }}</text>
					<text class="x-meta">{{ article.readLabel }}</text>
				</view>
			</view>

			<text class="detail-title">{{ article.title }}</text>
			<text class="x-meta meta-line">{{ article.categoryName }} · {{ article.timeLabel }}</text>

			<view class="prose">
				<view class="l"></view>
				<view class="l"></view>
				<view class="l s"></view>
				<view class="code"></view>
				<view class="l"></view>
				<view class="l s"></view>
			</view>

			<view class="x-card ai-card" @click="goAi">
				<text class="ai-label">✦ AI 摘要</text>
				<text class="ai-body">{{ article.aiSummary }}</text>
			</view>

			<view class="x-section-head">
				<text class="x-section-title">相关阅读</text>
			</view>
			<scroll-view class="related" scroll-x="true">
				<view class="related-inner">
					<view
						v-for="m in related"
						:key="m.id"
						class="mini"
						@click="goDetail(m.id)"
					>
						<text class="mini-em">{{ m.emoji }}</text>
						<text class="mini-t">{{ m.title }}</text>
					</view>
				</view>
			</scroll-view>

			<view class="x-section-head">
				<text class="x-section-title">评论</text>
			</view>
			<view v-for="(c, idx) in comments" :key="idx" class="comment">
				<view class="cav">
					<text>{{ c.emoji }}</text>
				</view>
				<view class="bubble">
					<text class="c-name">{{ c.name }} {{ c.tag }}</text>
					<text class="c-text">{{ c.text }}</text>
				</view>
			</view>
			<view class="bottom-pad"></view>
		</scroll-view>

		<view class="action-bar">
			<view class="cmt-input">
				<text class="cmt-ph">说点什么…</text>
			</view>
			<view :class="liked ? 'act on' : 'act'" @click="onLike">
				<view class="ic"></view>
				<text class="act-t">赞</text>
			</view>
			<view :class="faved ? 'act fav-on' : 'act'" @click="onFav">
				<view class="ic"></view>
				<text class="act-t">藏</text>
			</view>
			<view class="act" @click="tipOpen = true">
				<view class="ic tip"></view>
				<text class="act-t">赏</text>
			</view>
		</view>

		<x-tip-sheet :open="tipOpen" @close="tipOpen = false"></x-tip-sheet>
	</view>
</template>

<script setup lang="ts">
/**
 * 文章详情：mock articles；赞/藏写 useMockStore；赏打开 tip-sheet
 */
import { articles, detailComments, relatedMinis } from '../../mock/data'
import type { ArticleDetail } from '../../types/article'
import {
	isMockFaved,
	isMockLiked,
	toggleMockFav,
	toggleMockLike,
} from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'

const article = ref(articles[0] as ArticleDetail)
const related = relatedMinis
const comments = detailComments
const tipOpen = ref(false)
const liked = ref(false)
const faved = ref(false)
const articleId = ref('0')

onLoad((options) => {
	const id = options != null && options['id'] != null ? ('' + options['id']) : '0'
	articleId.value = id
	for (let i = 0; i < articles.length; i++) {
		if (articles[i].id === id) {
			article.value = articles[i]
			break
		}
	}
	liked.value = isMockLiked(id)
	faved.value = isMockFaved(id)
})

function goAi(): void {
	uni.navigateTo({ url: '/pages-blog/ai/index' })
}

function goDetail(id: string): void {
	uni.redirectTo({ url: '/pages/detail/detail?id=' + id })
}

function onLike(): void {
	liked.value = toggleMockLike(articleId.value)
	showXToast(liked.value ? '❤️' : '🤍', liked.value ? '已点赞' : '取消点赞', '')
}

function onFav(): void {
	faved.value = toggleMockFav(articleId.value)
	showXToast(faved.value ? '⭐' : '☆', faved.value ? '已收藏' : '取消收藏', '')
}
</script>

