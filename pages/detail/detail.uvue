	height: 8px;
	border-radius: 3px;
	background-color: #ebe6df;
	margin-bottom: 8px;
}

.s {
	width: 62%;
}

.code {
	height: 48px;
	border-radius: 12px;
	background-color: #2c2924;
	margin: 10px 0;
}

