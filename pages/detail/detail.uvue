	font-size: 12px;
	font-weight: 600;
	color: #2a8f76;
	margin-bottom: 6px;
}

.ai-body {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.5;
}

.related {
	height: 90px;
	margin-bottom: 12px;
}

.related-inner {
	flex-direction: row;
}

.mini {
	width: 120px;
	border-radius: 14px;
	padding: 10px;
	background-color: #ffffff;
	margin-right: 8px;
}

.mini-em {
	font-size: 20px;
	margin-bottom: 4px;
}

.mini-t {
	font-size: 12px;
	font-weight: 650;
	color: #1c1a17;
	lines: 2;
	text-overflow: ellipsis;
}

.comment {
	flex-direction: row;
	margin-bottom: 12px;
}

.cav {
	width: 32px;
	height: 32px;
	border-radius: 16px;
	background-color: #f0e6d8;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
}

.bubble {
	flex: 1;
	background-color: #ffffff;
	border-radius: 16px;
	padding: 10px 12px;
}

.c-name {
	font-size: 12px;
	font-weight: 600;
	color: #1c1a17;
	margin-bottom: 4px;
}

.c-text {
	font-size: 13px;
	color: #5c574f;
	line-height: 1.45;
}

.bottom-pad {
	height: 24px;
}

.action-bar {
	position: fixed;
	left: 14px;
	right: 14px;
	bottom: 14px;
	height: 52px;
	background-color: rgba(255, 255, 255, 0.95);
	border-radius: 18px;
	flex-direction: row;
	align-items: center;
	padding: 0 12px;
	z-index: 30;
}

.cmt-input {
	flex: 1;
	height: 34px;
	border-radius: 16px;
	background-color: #ebe6df;
	justify-content: center;
	padding: 0 12px;
	margin-right: 8px;
}

.cmt-ph {
	font-size: 12px;
	color: #9a948a;
}

.act {
	align-items: center;
