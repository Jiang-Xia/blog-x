<template>
	<!-- 主壳：uni-tab + tab-bar-blur 毛玻璃悬浮底栏（对齐官方示例与小卡原型） -->
	<uni-tab
		class="tab-shell"
		style="flex: 1; --uni-tab-bar-height: 62px"
		:active-index="activeIndex"
		:tab-content-height-full="tabContentHeightFull"
		@change="handleChange"
	>
		<uni-tab-content :style="tabContentStyle">
			<x-tab-home></x-tab-home>
		</uni-tab-content>
		<uni-tab-content :style="tabContentStyle">
			<x-tab-discover></x-tab-discover>
		</uni-tab-content>
		<uni-tab-content :style="tabContentStyle">
			<x-tab-rpg></x-tab-rpg>
		</uni-tab-content>
		<uni-tab-content :style="tabContentStyle">
			<x-tab-me></x-tab-me>
		</uni-tab-content>

		<uni-tab-bar class="blur-tab-list" :style="tabBarStyle">
			<uni-tab-item class="blur-tab-item">
				<view :class="activeIndex == 0 ? 'tab-inner tab-inner-on' : 'tab-inner'">
					<view class="ti-wrap">
						<x-icon
							name="home"
							:size="17"
							:filled="activeIndex == 0"
							:color="activeIndex == 0 ? '#2a8f76' : '#9a948a'"
						></x-icon>
					</view>
					<text :class="activeIndex == 0 ? 'tl tl-on' : 'tl'">首页</text>
				</view>
			</uni-tab-item>
			<uni-tab-item class="blur-tab-item">
				<view :class="activeIndex == 1 ? 'tab-inner tab-inner-on' : 'tab-inner'">
					<view class="ti-wrap">
						<x-icon
							name="compass"
							:size="17"
							:filled="activeIndex == 1"
							:color="activeIndex == 1 ? '#2a8f76' : '#9a948a'"
						></x-icon>
					</view>
					<text :class="activeIndex == 1 ? 'tl tl-on' : 'tl'">发现</text>
				</view>
			</uni-tab-item>
			<uni-tab-item class="blur-tab-item">
				<view :class="activeIndex == 2 ? 'tab-inner tab-inner-on' : 'tab-inner'">
					<view class="ti-wrap">
						<x-icon
							name="sword"
							:size="17"
							:filled="activeIndex == 2"
							:color="activeIndex == 2 ? '#2a8f76' : '#9a948a'"
						></x-icon>
					</view>
					<text :class="activeIndex == 2 ? 'tl tl-on' : 'tl'">冒险</text>
				</view>
			</uni-tab-item>
			<uni-tab-item class="blur-tab-item">
				<view :class="activeIndex == 3 ? 'tab-inner tab-inner-on' : 'tab-inner'">
					<view class="ti-wrap">
						<x-icon
							name="user"
							:size="17"
							:filled="activeIndex == 3"
							:color="activeIndex == 3 ? '#2a8f76' : '#9a948a'"
						></x-icon>
					</view>
					<text :class="activeIndex == 3 ? 'tl tl-on' : 'tl'">我的</text>
				</view>
			</uni-tab-item>
		</uni-tab-bar>
	</uni-tab>
</template>

<script setup lang="ts">
/**
 * 主壳页：自定义 tab-bar-blur（半透明毛玻璃）承载四 Tab
 * 底栏图标用 x-icon（home/compass/sword/user）；切 Tab 用 utils/tabNav.goTab，勿用 switchTab
 */
import { useUserStore } from '../../store/user'
import { tabActiveIndex, TAB_HOME, TAB_ME } from '../../utils/tabNav'

/** 左右边距（对齐原型 14px） */
const TAB_BAR_MARGIN = 14
/** 底边距（对齐原型 16px） */
const TAB_BAR_BOTTOM = 16

/**
 * 计算悬浮底栏定位样式（宽度随窗口变化）
 */
function buildTabBarStyle(): string {
	const windowInfo = uni.getWindowInfo()
	const tabBarWidth = Math.max(0, windowInfo.windowWidth - TAB_BAR_MARGIN * 2)
	return (
		'left: ' +
		TAB_BAR_MARGIN +
		'px; bottom: ' +
		TAB_BAR_BOTTOM +
		'px; width: ' +
		tabBarWidth +
		'px; padding-bottom: 0px; align-items: center; border-radius: 22px; overflow: hidden; border-top-width: 0px; border-width: 1px; border-style: solid; border-color: rgba(255,255,255,0.7); background-color: rgba(255, 255, 255, 0.82);'
	)
}

const activeIndex = tabActiveIndex
const tabBarStyle = ref(buildTabBarStyle())

/**
 * 底栏绝对悬浮钉死（tabContentHeightFull → position:absolute）
 * 内容区由各 Tab 内一层 scroll-y 整体滚动，页面本身 disableScroll
 */
let tabContentHeightFull = true
let tabContentStyle = 'flex: 1; width: 100%; height: 100%; min-height: 0px;'
// #ifdef MP-ALIPAY
tabContentHeightFull = false
// #endif

/**
 * 解析 ?tab= 查询参数
 */
function applyTabQuery(raw: string | null): void {
	if (raw == null || raw.length == 0) {
		return
	}
	const n = parseInt(raw)
	if (isNaN(n) || n < TAB_HOME || n > TAB_ME) {
		return
	}
	activeIndex.value = n
}

/**
 * 同步底栏宽度
 */
function syncTabBarStyle(): void {
	tabBarStyle.value = buildTabBarStyle()
}

/**
 * Tab 点击切换
 */
function handleChange(index: number): void {
	activeIndex.value = index
}

onLoad((options) => {
	if (options != null) {
		const tab = options['tab']
		if (tab != null) {
			applyTabQuery('' + tab)
		}
	}
	syncTabBarStyle()
})

onReady(() => {
	syncTabBarStyle()
})

onShow(() => {
	syncTabBarStyle()
	// 从登录页返回时，对齐 storage 与 Pinia（含 401 清态）
	useUserStore().hydrateFromStorage()
})
</script>

<style>
.tab-shell {
	flex: 1;
	width: 100%;
	height: 100%;
	background-color: #f4f1ec;
}

.blur-tab-list {
	/* 官方 tab-bar-blur：backdrop-filter；不支持端仍可见半透明白底 */
	backdrop-filter: blur(20px);
	box-shadow: 0px 10px 30px rgba(40, 32, 20, 0.12);
}

/* #ifdef WEB */
.blur-tab-list {
	-webkit-backdrop-filter: blur(20px);
}
/* #endif */

.blur-tab-item {
	position: relative;
	z-index: 1;
	height: 100%;
	padding: 5px;
}

.tab-inner {
	flex: 1;
	width: 100%;
	height: 100%;
	border-radius: 17px;
	align-items: center;
	justify-content: center;
	flex-direction: column;
}

.tab-inner-on {
	background-color: rgba(61, 184, 154, 0.12);
}

.ti-wrap {
	margin-bottom: 2px;
	align-items: center;
	justify-content: center;
}

.tl {
	font-size: 10px;
	font-weight: 600;
	color: #9a948a;
}

.tl-on {
	color: #2a8f76;
}
</style>
