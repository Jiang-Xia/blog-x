<template>
	<!-- 分类筛选：单行横滑 -->
	<scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="false">
		<view class="cat-row">
			<view
				v-for="(c, i) in items"
				:key="chipKey(c, i)"
				class="cat-chip"
				:class="i === activeIndex ? 'cat-chip-on' : 'cat-chip-off'"
				@click="onTap(i)"
			>
				<text :class="i === activeIndex ? 'cat-t-on' : 'cat-t'">{{ c.label }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
/**
 * 分类筛选横滑业务组件（单行）
 * - 数据：父组件传入 CategoryChip[]（id + label，展示用后端 label）
 * - 布局：单行横滑；胶囊固定 26px，与 x-tag-chips 同高
 * - 交互：点击抛 select(index, chip)；activeIndex 由父组件控制选中态
 */
import type { CategoryChip } from '../../types/article'

const props = defineProps({
	/** 分类列表；首项通常为「全部」id='' */
	items: {
		type: Array,
		default: () => [] as CategoryChip[],
	},
	/** 当前选中下标 */
	activeIndex: {
		type: Number,
		default: 0,
	},
})

const emit = defineEmits(['select'])

/**
 * chip 稳定 key（优先 id）
 */
function chipKey(c: CategoryChip, i: number): string {
	if (c != null && c.id != null && ('' + c.id).length > 0) return '' + c.id
	if (c != null && c.label != null) return c.label + '-' + i
	return '' + i
}

/**
 * 点击某一分类
 */
function onTap(i: number): void {
	const list = props.items as CategoryChip[]
	const chip = list[i]
	if (chip == null) return
	emit('select', i, chip)
}
</script>

<style>
.cat-scroll {
	width: 100%;
	height: 26px;
	margin-bottom: 8px;
	flex-direction: row;
}

.cat-row {
	flex-direction: row;
	flex-wrap: nowrap;
	align-items: center;
	height: 26px;
	padding-right: 8px;
}

.cat-chip {
	flex-shrink: 0;
	height: 26px;
	padding-left: 12px;
	padding-right: 12px;
	border-radius: 999px;
	margin-right: 8px;
	align-items: center;
	justify-content: center;
	/* 无边框；高度与带边框的标签胶囊一致 */
	box-sizing: border-box;
}

.cat-chip-on {
	/* ink 填充；深色下 ink 为浅色，字用 --x-bg 保持对比 */
	background-color: var(--x-ink, #1c1a17);
}

.cat-chip-off {
	/* bg2 比 surface 更贴页面底，深色下不跳白块 */
	background-color: var(--x-bg-2, #ebe6df);
}

.cat-t {
	font-size: 11px;
	color: var(--x-ink-2, #5c574f);
	font-weight: 500;
	lines: 1;
}

.cat-t-on {
	font-size: 11px;
	color: var(--x-bg, #f4f1ec);
	font-weight: 500;
	lines: 1;
}
</style>
