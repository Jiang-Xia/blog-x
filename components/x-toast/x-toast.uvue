<template>
	<!-- 原型风格居中 Toast：x-icon + 标题 + 描述 -->
	<view v-if="visible" class="x-toast">
		<x-icon v-if="icon.length > 0" class="x-toast-ico" :name="icon" :size="28" color="#ffffff"></x-icon>
		<text class="x-toast-title">{{ title }}</text>
		<text v-if="desc.length > 0" class="x-toast-desc">{{ desc }}</text>
	</view>
</template>

<script setup lang="ts">
/**
 * 小卡风格 Toast 展示组件（纯展示）
 * 父组件控制 visible / 文案；也可配合 utils/toast.showXToast
 */
defineProps({
	visible: { type: Boolean, default: false },
	/** Tabler 图标名 */
	icon: { type: String, default: 'sun' },
	title: { type: String, default: '' },
	desc: { type: String, default: '' },
})
</script>

<style>
.x-toast {
	position: fixed;
	left: 50%;
	top: 42%;
	transform: translate(-50%, -50%);
	background-color: rgba(28, 26, 23, 0.9);
	border-radius: 16px;
	padding: 18px 20px;
	z-index: 999;
	align-items: center;
	min-width: 150px;
}

.x-toast-ico {
	margin-bottom: 6px;
}

.x-toast-title {
	font-size: 14px;
	color: #ffffff;
	font-weight: 600;
	text-align: center;
	margin-bottom: 4px;
}

.x-toast-desc {
	font-size: 12px;
	color: rgba(255, 255, 255, 0.85);
	text-align: center;
	line-height: 1.45;
}
</style>
