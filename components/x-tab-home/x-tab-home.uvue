<template>
	<!-- 首页 Tab 面板：搜索、今日进度、快捷入口、最新文章（mock） -->
	<scroll-view class="x-page-tab" scroll-y="true">
		<view class="status-pad"></view>
		<view class="search-bar" @click="goSearch">
			<text class="search-ico">⌕</text>
			<text class="search-ph">搜索文章、标签、作者</text>
			<view class="bell" @click.stop="goNotify">
				<text class="bell-text">{{ notifyBadge }}</text>
			</view>
		</view>

		<view class="x-card today">
			<view class="today-left">
				<text class="today-label">今日进度</text>
				<text class="today-title">{{ homeTodayTitle }}</text>
				<view class="chip-row">
					<text class="x-chip">{{ homeStreakLabel }}</text>
					<text class="x-chip x-chip-lav">{{ unreadChip }}</text>
				</view>
			</view>
			<view class="ring">
				<text class="ring-pct">{{ ringPct }}%</text>
				<text class="ring-sub">签到</text>
			</view>
		</view>

		<view class="chip-row chip-gap">
			<view class="x-chip x-chip-dark" @click="goAi">
				<text class="chip-t-dark">✦ AI 助手</text>
			</view>
			<view class="x-chip x-chip-plain" @click="goRpg">
				<text class="chip-t">{{ questChip }}</text>
			</view>
			<view class="x-chip x-chip-plain" @click="onWrite">
				<text class="chip-t">写文章</text>
			</view>
		</view>

		<scroll-view class="cat-scroll" scroll-x="true">
			<view class="chip-row nowrap">
				<text
					v-for="(c, i) in categories"
					:key="c"
					:class="i === 0 ? 'x-chip x-chip-dark' : 'x-chip x-chip-plain'"
				>{{ c }}</text>
			</view>
		</scroll-view>

		<view class="x-section-head">
			<text class="x-section-title">最新文章</text>
			<text class="x-link" @click="goDiscover">全部</text>
		</view>

		<view
			v-for="item in list"
			:key="item.id"
			class="x-card article"
			@click="goDetail(item.id)"
		>
			<view class="article-body">
				<view class="meta-row">
					<text class="x-meta">{{ item.categoryName }}</text>
					<text class="x-meta"> · </text>
					<text class="x-meta">{{ item.timeLabel }}</text>
				</view>
				<text class="article-title">{{ item.title }}</text>
				<text class="article-stat">👍 {{ item.likeCount }} · 💬 {{ item.commentCount }}</text>
			</view>
			<view class="cover" :style="{ backgroundColor: item.coverC1 }">
				<text class="cover-em">{{ item.coverEmoji }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
/**
 * 首页 Tab 面板：对齐小卡原型 home
 * 数据来源：联调 article/list、category、未读、sign-info、my-quests；失败回落 mock
 */
import { homeArticles, homeCategories, rpgQuestsSeed } from '../../mock/data'
import type { ArticleSummary } from '../../types/article'
import { fetchArticleList, fetchCategoryNames } from '../../api/modules/article'
import { fetchUnreadCount } from '../../api/modules/notification'
import { fetchMyQuests, fetchSignInfo } from '../../api/modules/rpg'
import { apiOrMock } from '../../composables/useApiOrMock'
import { useMockStore } from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { goTab, TAB_DISCOVER, TAB_RPG } from '../../utils/tabNav'

const list = ref(homeArticles as ArticleSummary[])
const categories = ref(homeCategories as string[])
const store = useMockStore()
const userStore = useUserStore()
const notifyBadge = store.notifyBadge
const homeTodayTitle = store.homeTodayTitle
const homeStreakLabel = store.homeStreakLabel
const unreadChip = ref('未读 —')
const ringPct = ref(70)
/** 今日任务进度芯片文案 */
const questChip = ref('今日任务 —')

/**
 * 拉取首页列表、分类、未读、签到与任务进度
 */
async function loadHome(): Promise<void> {
	const articles = await apiOrMock(async () => {
		const res = await fetchArticleList({ page: 1, pageSize: 10, client: true })
		return res.list
	}, homeArticles)
	list.value = articles
	const cats = await apiOrMock(() => fetchCategoryNames(), homeCategories)
	categories.value = cats
	const unread = await apiOrMock(() => fetchUnreadCount(), store.notifyBadge.value)
	store.notifyBadge.value = unread
	unreadChip.value = '未读 ' + unread

	const sign = await apiOrMock(
		() => fetchSignInfo(),
		{
			signedToday: store.checkedInToday.value,
			streakDays: store.streakDays.value,
			totalSignDays: store.streakDays.value,
			lastSignDate: '',
		},
	)
	store.checkedInToday.value = sign.signedToday
	if (sign.streakDays > 0) store.streakDays.value = sign.streakDays

	const quests = await apiOrMock(() => fetchMyQuests(), rpgQuestsSeed)
	let done = 0
	const total = quests.length
	for (let i = 0; i < quests.length; i++) {
		if (quests[i].done || quests[i].claimable) done++
	}
	questChip.value = '今日任务 ' + done + '/' + (total > 0 ? total : '—')
	store.homeTodayTitle.value =
		(sign.signedToday ? '已签到' : '待签到') +
		' · 任务 ' +
		done +
		'/' +
		(total > 0 ? total : 0)
	store.homeStreakLabel.value =
		'连续 ' + (sign.streakDays > 0 ? sign.streakDays : store.streakDays.value) + ' 天'
	ringPct.value = sign.signedToday ? 100 : total > 0 ? Math.floor((done / total) * 100) : 40
}

onMounted(() => {
	loadHome()
})

/** 进搜索 */
function goSearch(): void {
	uni.navigateTo({ url: '/pages/search/search' })
}

/** 进消息中心 */
function goNotify(): void {
	uni.navigateTo({ url: '/pages/notify/notify' })
}

/** 进 AI 助手（博客分包） */
function goAi(): void {
	uni.navigateTo({ url: '/pages-blog/ai/index' })
}

/** 切到冒险 Tab */
function goRpg(): void {
	goTab(TAB_RPG)
}

/** 进写文章；未登录跳登录 */
function onWrite(): void {
	if (!userStore.loggedIn) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({ url: '/pages-blog/write/index' })
}

/** 切到发现 */
function goDiscover(): void {
	goTab(TAB_DISCOVER)
}

/** 进文章详情 */
function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
