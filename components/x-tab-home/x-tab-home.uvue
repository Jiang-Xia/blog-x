	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}

.chip-gap {
	margin-bottom: 12px;
}

.nowrap {
	flex-wrap: nowrap;
}

.cat-scroll {
	margin-bottom: 12px;
	height: 36px;
}

.chip-t {
	font-size: 11px;
	color: #5c574f;
	font-weight: 500;
}

.chip-t-dark {
	font-size: 11px;
	color: #ffffff;
	font-weight: 500;
}

.ring {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: rgba(61, 184, 154, 0.15);
	align-items: center;
	justify-content: center;
	border-width: 6px;
	border-style: solid;
	border-color: #3db89a;
}

