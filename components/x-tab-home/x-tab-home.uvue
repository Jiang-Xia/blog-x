<template>
	<!-- 首页 Tab：统一滚动壳；分类横滑单独 scroll-x -->
	<x-scroll-page
		variant="tab"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:footer-text="footerText"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@loadmore="onLoadMore"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
		<view class="status-pad"></view>
		<view class="search-bar" @click="goSearch">
			<text class="search-ico">⌕</text>
			<text class="search-ph">搜索文章、标签、作者</text>
			<view class="bell" @click.stop="goNotify">
				<text class="bell-text">{{ notifyBadge }}</text>
			</view>
		</view>

		<view class="x-card today">
			<view class="today-left">
				<text class="today-label">今日进度</text>
				<text class="today-title">{{ homeTodayTitle }}</text>
				<view class="chip-row">
					<text class="x-chip">{{ homeStreakLabel }}</text>
					<text class="x-chip x-chip-lav">{{ unreadChip }}</text>
				</view>
			</view>
			<view class="ring">
				<text class="ring-pct">{{ ringPct }}%</text>
				<text class="ring-sub">签到</text>
			</view>
		</view>

		<view class="chip-row chip-gap">
			<view class="x-chip x-chip-dark" @click="goAi">
				<text class="chip-t-dark">✦ AI 助手</text>
			</view>
			<view class="x-chip x-chip-plain" @click="goRpg">
				<text class="chip-t">{{ questChip }}</text>
			</view>
			<view class="x-chip x-chip-plain" @click="onWrite">
				<text class="chip-t">写文章</text>
			</view>
		</view>

		<!-- 分类横滑：点击按 category.id 筛选 -->
		<x-category-chips
			:items="categories"
			:active-index="catIndex"
			@select="onSelectCat"
		></x-category-chips>

		<view class="x-section-head">
			<text class="x-section-title">最新文章</text>
			<text class="x-link" @click="goDiscover">全部</text>
		</view>

		<x-article-card
			v-for="item in list"
			:key="item.id"
			:id="item.id"
			:title="item.title"
			:category-name="item.categoryName"
			:time-label="item.timeLabel"
			:cover-url="item.coverUrl"
			:cover-emoji="item.coverEmoji"
			:cover-c1="item.coverC1"
			:like-count="item.likeCount"
			:comment-count="item.commentCount"
			@open="goDetail"
		></x-article-card>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 首页 Tab 面板：对齐小卡原型 home
 * 数据来源：联调 article/list、category、未读、sign-info、my-quests
 * 滚动：x-scroll-page(variant=tab) 下拉刷新 + 文章上滑加载更多
 */
import type { ArticleSummary, CategoryChip } from '../../types/article'
import type { RpgQuest } from '../../types/rpg'
import { fetchArticleList, fetchCategories, type CategoryOption } from '../../api/modules/article'
import { fetchUnreadCount } from '../../api/modules/notification'
import { fetchMyQuests, fetchSignInfo } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { goTab, TAB_DISCOVER, TAB_RPG } from '../../utils/tabNav'

const list = ref([] as ArticleSummary[])
const listTotal = ref(-1)
const categories = ref([
	{ id: '', label: '全部' },
] as CategoryChip[])
const catIndex = ref(0)
const store = useMockStore()
const userStore = useUserStore()
const notifyBadge = store.notifyBadge
const homeTodayTitle = store.homeTodayTitle
const homeStreakLabel = store.homeStreakLabel
const unreadChip = ref('未读 —')
const ringPct = ref(70)
/** 今日任务进度芯片文案 */
const questChip = ref('今日任务 —')

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
	resetPaging,
} = useListScroll(10)

/**
 * 当前选中分类 UUID（空=全部）
 */
function currentCatId(): string | undefined {
	const cat = categories.value[catIndex.value]
	if (cat != null && cat.id.length > 0) return cat.id
	return undefined
}

/**
 * 拉取一页文章
 */
async function fetchArticlesPage(page: number): Promise<{ list: ArticleSummary[]; total: number }> {
	try {
		const res = await fetchArticleList({
			page,
			pageSize,
			client: true,
			category: currentCatId(),
		})
		return { list: res.list, total: res.total }
	} catch (_) {
		return { list: [], total: 0 }
	}
}

/**
 * 拉取首页头区（分类/未读/签到/任务），不含文章分页
 */
async function loadHomeMeta(): Promise<void> {
	try {
		const rows = await fetchCategories()
		const chips: CategoryChip[] = [{ id: '', label: '全部' }]
		for (let i = 0; i < rows.length; i++) {
			const r = rows[i] as CategoryOption
			chips.push({ id: r.id, label: r.label })
		}
		categories.value = chips
	} catch (_) {
		categories.value = [{ id: '', label: '全部' }]
	}

	try {
		const unread = await fetchUnreadCount()
		store.notifyBadge.value = unread
		unreadChip.value = '未读 ' + unread
	} catch (_) {
		unreadChip.value = '未读 —'
	}

	let sign = {
		signedToday: false,
		streakDays: 0,
		totalSignDays: 0,
		lastSignDate: '',
	}
	try {
		sign = await fetchSignInfo()
		store.checkedInToday.value = sign.signedToday
		if (sign.streakDays > 0) store.streakDays.value = sign.streakDays
	} catch (_) {}

	let quests = [] as RpgQuest[]
	try {
		quests = await fetchMyQuests()
	} catch (_) {}
	let done = 0
	const total = quests.length
	for (let i = 0; i < quests.length; i++) {
		if (quests[i].done || quests[i].claimable) done++
	}
	questChip.value = '今日任务 ' + done + '/' + (total > 0 ? total : '—')
	store.homeTodayTitle.value =
		(sign.signedToday ? '已签到' : '待签到') +
		' · 任务 ' +
		done +
		'/' +
		(total > 0 ? total : 0)
	store.homeStreakLabel.value =
		'连续 ' + (sign.streakDays > 0 ? sign.streakDays : store.streakDays.value) + ' 天'
	ringPct.value = sign.signedToday ? 100 : total > 0 ? Math.floor((done / total) * 100) : 40
}

/**
 * 下拉刷新：头区 + 文章第 1 页
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadHomeMeta()
	const res = await fetchArticlesPage(1)
	list.value = res.list
	listTotal.value = res.total
	endRefresh(res.list.length, list.value.length, res.total)
}

/**
 * 上滑加载更多文章
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const res = await fetchArticlesPage(p)
	for (let i = 0; i < res.list.length; i++) {
		list.value.push(res.list[i])
	}
	if (res.total >= 0) listTotal.value = res.total
	endLoadMore(res.list.length, list.value.length, listTotal.value)
}

onMounted(() => {
	onRefresh()
})

/**
 * 切换分类并重新拉列表
 */
function onSelectCat(i: number): void {
	if (i < 0 || i >= categories.value.length) return
	catIndex.value = i
	resetPaging()
	onRefreshArticlesOnly()
}

/**
 * 仅刷新文章（分类切换，不重复拉签到等）
 */
async function onRefreshArticlesOnly(): Promise<void> {
	beginRefresh()
	const res = await fetchArticlesPage(1)
	list.value = res.list
	listTotal.value = res.total
	endRefresh(res.list.length, list.value.length, res.total)
}

/** 进搜索 */
function goSearch(): void {
	uni.navigateTo({ url: '/pages/search/search' })
}

/** 进消息中心 */
function goNotify(): void {
	uni.navigateTo({ url: '/pages/notify/notify' })
}

/** 进 AI 助手（博客分包） */
function goAi(): void {
	uni.navigateTo({ url: '/pages-blog/ai/index' })
}

/** 切到冒险 Tab */
function goRpg(): void {
	goTab(TAB_RPG)
}

/** 进写文章；未登录跳登录 */
function onWrite(): void {
	if (!userStore.loggedIn) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({ url: '/pages-blog/write/index' })
}

/** 切到发现 */
function goDiscover(): void {
	goTab(TAB_DISCOVER)
}

/** 进文章详情 */
function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.search-bar {
	flex-direction: row;
	align-items: center;
	background-color: #ffffff;
	border-radius: 999px;
	padding: 11px 14px;
	margin-bottom: 12px;
}

.search-ico {
	font-size: 14px;
	color: #9a948a;
	margin-right: 8px;
}

.search-ph {
	flex: 1;
	font-size: 13px;
	color: #9a948a;
}

.bell {
	min-width: 18px;
	height: 18px;
	border-radius: 9px;
	background-color: #e8897a;
	padding: 0 4px;
	align-items: center;
	justify-content: center;
}

.bell-text {
	font-size: 9px;
	font-weight: 600;
	color: #ffffff;
}

.today {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	background-color: #f3faf7;
}

.today-left {
	flex: 1;
	margin-right: 12px;
}

.today-label {
	font-size: 12px;
	color: #5c574f;
	margin-bottom: 4px;
}

.today-title {
	font-size: 16px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 8px;
}

.chip-row {
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}

.chip-gap {
	margin-bottom: 12px;
}

.chip-t {
	font-size: 11px;
	color: #5c574f;
	font-weight: 500;
}

.chip-t-dark {
	font-size: 11px;
	color: #ffffff;
	font-weight: 500;
}

.ring {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: rgba(61, 184, 154, 0.15);
	align-items: center;
	justify-content: center;
	border-width: 6px;
	border-style: solid;
	border-color: #3db89a;
}

.ring-pct {
	font-size: 14px;
	font-weight: 700;
	color: #1c1a17;
}

.ring-sub {
	font-size: 9px;
	color: #9a948a;
}
</style>
