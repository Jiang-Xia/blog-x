<template>
	<!-- 首页 Tab：统一滚动壳；分类横滑单独 scroll-x -->
	<x-scroll-page
		variant="tab"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:footer-text="footerText"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@loadmore="onLoadMore"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
		<view class="status-pad"></view>
		<view class="search-bar" @click="goSearch">
			<view class="search-ico">
				<x-icon name="search" :size="14" :color="tokens.ink3"></x-icon>
			</view>
			<text class="search-ph">搜索文章、标签、作者</text>
			<!-- 右侧铃铛：未读通知入口；角标仅在有未读时显示 -->
			<view class="bell-wrap" @click.stop="goNotify">
				<x-icon name="bell" :size="16" :color="tokens.ink2"></x-icon>
				<view v-if="notifyBadge > 0" class="bell">
					<text class="bell-text">{{ notifyBadge > 99 ? '99+' : notifyBadge }}</text>
				</view>
			</view>
		</view>

		<view class="x-card today">
			<view class="today-left">
				<text class="today-label">今日进度</text>
				<text class="today-title">{{ homeTodayTitle }}</text>
				<view class="chip-row">
					<text class="x-chip">{{ homeStreakLabel }}</text>
					<text class="x-chip x-chip-lav">{{ unreadChip }}</text>
				</view>
			</view>
			<view class="ring">
				<text class="ring-pct">{{ ringPct }}%</text>
				<text class="ring-sub">任务</text>
			</view>
		</view>

		<view class="chip-row chip-gap">
			<view class="x-chip x-chip-dark chip-with-ico" @click="goAi">
				<!-- chip-dark 字色跟 --x-bg，图标同步 -->
				<x-icon name="sparkles" :size="12" :color="tokens.bg"></x-icon>
				<text class="chip-t-dark">AI 助手</text>
			</view>
			<view class="x-chip x-chip-plain" @click="goRpg">
				<text class="chip-t">{{ questChip }}</text>
			</view>
			<view class="x-chip x-chip-plain chip-with-ico" @click="onWrite">
				<x-icon name="pencil" :size="12" :color="tokens.ink2"></x-icon>
				<text class="chip-t">写文章</text>
			</view>
		</view>

		<!-- 分类 / 标签：单行横滑；精确 category / tags[] -->
		<x-category-chips
			:items="categories"
			:active-index="catIndex"
			@select="onSelectCat"
		></x-category-chips>
		<x-tag-chips
			:items="tagOptions"
			:selected-ids="selectedTagIds"
			@toggle="onToggleTag"
		></x-tag-chips>

		<view class="x-section-head">
			<text class="x-section-title">最新文章</text>
			<text class="x-link" @click="goDiscover">全部</text>
		</view>

		<x-article-card
			v-for="item in list"
			:key="item.id"
			:id="item.id"
			:title="item.title"
			:category-name="item.categoryName"
			:time-label="item.timeLabel"
			:cover-url="item.coverUrl"
			:cover-icon="item.coverIcon"
			:cover-c1="item.coverC1"
			:like-count="item.likeCount"
			:comment-count="item.commentCount"
			@open="goDetail"
		></x-article-card>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 首页 Tab 面板：对齐小卡原型 home
 * 数据来源：联调 article/list、category、tag、未读、sign-info、my-quests
 * 筛选：分类单选 + 标签多选（单行横滑组件）
 * 滚动：x-scroll-page(variant=tab) 下拉刷新 + 文章上滑加载更多
 */
import type { ArticleSummary, CategoryChip } from '../../types/article'
import type { RpgQuest } from '../../types/rpg'
import {
	fetchArticleList,
	fetchCategories,
	fetchTags,
	type CategoryOption,
	type TagWallItem,
} from '../../api/modules/article'
import { fetchUnreadCount } from '../../api/modules/notification'
import { fetchMyQuests, fetchSignInfo } from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { useTheme } from '../../composables/useTheme'
import { useUserStore } from '../../store/user'
import { goTab, TAB_DISCOVER, TAB_RPG } from '../../utils/tabNav'

const { tokens } = useTheme()

const list = ref([] as ArticleSummary[])
const listTotal = ref(-1)
const categories = ref([
	{ id: '', label: '全部' },
] as CategoryChip[])
const catIndex = ref(0)
/** 标签筛选项（GET /tag） */
const tagOptions = ref([] as TagWallItem[])
/** 已选标签 UUID（多选精确筛选） */
const selectedTagIds = ref([] as string[])
const store = useMockStore()
const userStore = useUserStore()
const notifyBadge = store.notifyBadge
const homeTodayTitle = store.homeTodayTitle
const homeStreakLabel = store.homeStreakLabel
const unreadChip = ref('未读 —')
const ringPct = ref(70)
/** 今日任务进度芯片文案 */
const questChip = ref('今日任务 —')

const {
	pageSize,
	refreshing,
	pullingDistance,
	footerText,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
	beginLoadMore,
	endLoadMore,
	resetPaging,
} = useListScroll(10)

/**
 * 当前选中分类 UUID（空=全部）
 */
function currentCatId(): string | undefined {
	const cat = categories.value[catIndex.value]
	if (cat != null && cat.id.length > 0) return cat.id
	return undefined
}

/**
 * 拉取一页文章
 */
async function fetchArticlesPage(page: number): Promise<{ list: ArticleSummary[]; total: number }> {
	try {
		const res = await fetchArticleList({
			page,
			pageSize,
			client: true,
			category: currentCatId(),
			tags: selectedTagIds.value.length > 0 ? selectedTagIds.value.slice() : undefined,
		})
		return { list: res.list, total: res.total }
	} catch (_) {
		return { list: [], total: 0 }
	}
}

/**
 * 拉取首页头区（分类/未读/签到/任务），不含文章分页
 */
async function loadHomeMeta(): Promise<void> {
	try {
		const rows = await fetchCategories()
		const chips: CategoryChip[] = [{ id: '', label: '全部' }]
		for (let i = 0; i < rows.length; i++) {
			const r = rows[i] as CategoryOption
			chips.push({ id: r.id, label: r.label })
		}
		categories.value = chips
	} catch (_) {
		categories.value = [{ id: '', label: '全部' }]
	}

	try {
		tagOptions.value = await fetchTags()
	} catch (_) {
		tagOptions.value = []
	}

	try {
		const unread = await fetchUnreadCount()
		store.notifyBadge.value = unread
		unreadChip.value = '未读 ' + unread
	} catch (_) {
		unreadChip.value = '未读 —'
	}

	let sign = {
		signedToday: false,
		streakDays: 0,
		totalSignDays: 0,
		lastSignDate: '',
	}
	try {
		sign = await fetchSignInfo()
		store.checkedInToday.value = sign.signedToday
		if (sign.streakDays > 0) store.streakDays.value = sign.streakDays
	} catch (_) {}

	let quests = [] as RpgQuest[]
	try {
		quests = await fetchMyQuests()
	} catch (_) {}
	let done = 0
	const total = quests.length
	for (let i = 0; i < quests.length; i++) {
		if (quests[i].done || quests[i].claimable) done++
	}
	questChip.value = '今日任务 ' + done + '/' + (total > 0 ? total : '—')
	store.homeTodayTitle.value =
		(sign.signedToday ? '已签到' : '待签到') +
		' · 任务 ' +
		done +
		'/' +
		(total > 0 ? total : 0)
	store.homeStreakLabel.value =
		'连续 ' + (sign.streakDays > 0 ? sign.streakDays : store.streakDays.value) + ' 天'
	// 圆环：今日任务完成百分比（与签到状态解耦）
	ringPct.value = total > 0 ? Math.floor((done / total) * 100) : 0
}

/**
 * 下拉刷新：头区 + 文章第 1 页
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadHomeMeta()
	const res = await fetchArticlesPage(1)
	list.value = res.list
	listTotal.value = res.total
	endRefresh(res.list.length, list.value.length, res.total)
}

/**
 * 上滑加载更多文章
 */
async function onLoadMore(): Promise<void> {
	const p = beginLoadMore()
	if (p <= 0) return
	const res = await fetchArticlesPage(p)
	for (let i = 0; i < res.list.length; i++) {
		list.value.push(res.list[i])
	}
	if (res.total >= 0) listTotal.value = res.total
	endLoadMore(res.list.length, list.value.length, listTotal.value)
}

onMounted(() => {
	onRefresh()
})

/**
 * 切换分类并重新拉列表
 */
function onSelectCat(i: number): void {
	if (i < 0 || i >= categories.value.length) return
	catIndex.value = i
	resetPaging()
	onRefreshArticlesOnly()
}

/**
 * 切换标签多选并重新拉列表
 */
function onToggleTag(id: string): void {
	const idx = selectedTagIds.value.indexOf(id)
	if (idx >= 0) {
		selectedTagIds.value.splice(idx, 1)
	} else {
		selectedTagIds.value.push(id)
	}
	resetPaging()
	onRefreshArticlesOnly()
}

/**
 * 仅刷新文章（分类/标签切换，不重复拉签到等）
 */
async function onRefreshArticlesOnly(): Promise<void> {
	beginRefresh()
	const res = await fetchArticlesPage(1)
	list.value = res.list
	listTotal.value = res.total
	endRefresh(res.list.length, list.value.length, res.total)
}

/** 进搜索 */
function goSearch(): void {
	uni.navigateTo({ url: '/pages/search/search' })
}

/** 进消息中心 */
function goNotify(): void {
	uni.navigateTo({ url: '/pages/notify/notify' })
}

/** 进 AI 助手（博客分包） */
function goAi(): void {
	uni.navigateTo({ url: '/pages-blog/ai/index' })
}

/** 切到冒险 Tab */
function goRpg(): void {
	goTab(TAB_RPG)
}

/** 进写文章；未登录跳登录 */
function onWrite(): void {
	if (!userStore.loggedIn) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	uni.navigateTo({ url: '/pages-blog/write/index' })
}

/** 切到发现 */
function goDiscover(): void {
	goTab(TAB_DISCOVER)
}

/** 进文章详情 */
function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.search-bar {
	flex-direction: row;
	align-items: center;
	background-color: var(--x-surface, #ffffff);
	border-radius: 999px;
	/* 右侧略留白，避免铃铛角标贴边被圆角裁切 */
	padding: 11px 12px 11px 14px;
	margin-bottom: 12px;
	overflow: visible;
}

.search-ico {
	margin-right: 8px;
	align-items: center;
	justify-content: center;
}

.chip-with-ico {
	flex-direction: row;
	align-items: center;
}

.chip-with-ico .chip-t-dark {
	margin-left: 4px;
}

.chip-with-ico .chip-t {
	margin-left: 4px;
}

.search-ph {
	flex: 1;
	font-size: 13px;
	color: var(--x-ink-3, #9a948a);
}

.bell-wrap {
	position: relative;
	width: 32px;
	height: 28px;
	align-items: center;
	justify-content: center;
	margin-left: 4px;
	/* 角标 absolute 溢出时勿被裁切 */
	overflow: visible;
}

.bell {
	position: absolute;
	/* 落在 wrap 内右上角，避免负偏移被 search-bar 圆角裁掉 */
	top: 0;
	right: 0;
	min-width: 16px;
	height: 16px;
	border-radius: 8px;
	background-color: var(--x-danger, #e8897a);
	padding: 0 4px;
	align-items: center;
	justify-content: center;
	z-index: 2;
}

.bell-text {
	font-size: 10px;
	font-weight: 600;
	line-height: 16px;
	color: var(--x-on-ink, #ffffff);
}

.today {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	/* 主题强调浅底，替代写死浅绿，深色模式不再跳色 */
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
}

.today-left {
	flex: 1;
	margin-right: 12px;
}

.today-label {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	margin-bottom: 4px;
}

.today-title {
	font-size: 16px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 8px;
}

.chip-row {
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}

.chip-gap {
	margin-bottom: 12px;
}

.chip-t {
	font-size: 11px;
	color: var(--x-ink-2, #5c574f);
	font-weight: 500;
}

.chip-t-dark {
	font-size: 11px;
	color: var(--x-bg, #f4f1ec);
	font-weight: 500;
}

.ring {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
	align-items: center;
	justify-content: center;
	border-width: 6px;
	border-style: solid;
	border-color: var(--x-accent, #3db89a);
}

.ring-pct {
	font-size: 14px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
}

.ring-sub {
	font-size: 9px;
	color: var(--x-ink-3, #9a948a);
}
</style>
