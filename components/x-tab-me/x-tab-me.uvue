<template>
	<!-- 我的 Tab：统一滚动壳 + 下拉刷新资料 -->
	<x-scroll-page
		variant="tab"
		:enable-load-more="false"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
			<view class="status-pad"></view>
			<view class="profile-top" @click="onProfileTap">
				<view class="big-avatar">
					<image
						v-if="profile.avatarUrl != null && profile.avatarUrl.length > 0"
						class="big-avatar-img"
						:src="profile.avatarUrl"
						mode="aspectFill"
					></image>
					<x-icon v-else :name="profile.avatarIcon" :size="30" color="#1c1a17"></x-icon>
				</view>
				<text class="name">{{ profile.nickname }}</text>
				<text class="bio">{{ profile.bio }}</text>
			</view>

			<view class="stat-row">
				<view class="stat">
					<text class="stat-n">{{ profile.articleCount }}</text>
					<text class="stat-l">文章</text>
				</view>
				<view class="stat">
					<text class="stat-n">{{ profile.favoriteCount }}</text>
					<text class="stat-l">收藏</text>
				</view>
				<view class="stat">
					<text class="stat-n">{{ profile.likeReceived }}</text>
					<text class="stat-l">获赞</text>
				</view>
			</view>

			<view class="x-card menu">
				<view class="mrow" @click="goFavorites">
					<view class="m-ico"><x-icon name="star" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">我的收藏</text>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view class="mrow" @click="goInbox">
					<view class="m-ico"><x-icon name="inbox" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">评论收件箱</text>
					<view v-if="inboxBadge > 0" class="badge">
						<text class="badge-t">{{ inboxBadge }}</text>
					</view>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view class="mrow" @click="goProfile">
					<view class="m-ico"><x-icon name="user" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">公开主页</text>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view class="mrow" @click="goAudit">
					<view class="m-ico"><x-icon name="shield" :size="16" color="#1c1a17"></x-icon></view>
					<view class="m-col">
						<text class="m-label">切换管理模式</text>
						<text class="m-sub">审核 / 订单</text>
					</view>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view v-if="!loggedIn" class="mrow" @click="goLogin">
					<view class="m-ico"><x-icon name="message" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">登录 / 绑定</text>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view v-else class="mrow" @click="onLogout">
					<view class="m-ico"><x-icon name="logout" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">退出登录</text>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
				<view class="mrow last" @click="goNotify">
					<view class="m-ico"><x-icon name="bell" :size="16" color="#1c1a17"></x-icon></view>
					<text class="m-label">站内通知</text>
					<x-icon name="chevron-right" :size="16" color="#9a948a"></x-icon>
				</view>
			</view>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 我的 Tab 面板：对齐原型 me
 * 数据来源：Pinia useUserStore.profile（GET /user/info → mapUserProfile：nickname / avatar / intro）
 * 头像优先 avatarUrl，无则回退 avatarIcon；角标来自收件箱
 * 滚动：x-scroll-page 下拉刷新
 */
import { storeToRefs } from 'pinia'
import { fetchInbox } from '../../api/modules/interact'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { showXToast } from '../../utils/toast'

const userStore = useUserStore()
const { profile, loggedIn } = storeToRefs(userStore)
const store = useMockStore()
const inboxBadge = store.inboxBadge

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/**
 * 已登录则刷新资料与收件箱角标
 */
async function loadMe(): Promise<void> {
	if (!userStore.loggedIn) return
	try {
		await userStore.refreshProfile()
	} catch (_) {}
	try {
		const inbox = await fetchInbox(1, 20)
		store.inboxBadge.value = inbox.length
	} catch (_) {
		store.inboxBadge.value = 0
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadMe()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

// 登录成功 / 退出后即时刷新（组件常驻主壳，不会重新 mount）
watch(loggedIn, (v: boolean) => {
	if (v) {
		loadMe()
	} else {
		store.inboxBadge.value = 0
	}
})

/**
 * 点头像区：未登录去登录
 */
function onProfileTap(): void {
	if (!userStore.loggedIn) {
		goLogin()
	}
}

function goFavorites(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/favorites/index' })
}

function goInbox(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/inbox/index' })
}

function goProfile(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/profile/index' })
}

function goAudit(): void {
	uni.navigateTo({ url: '/pages-blog/audit/index' })
}

function goLogin(): void {
	uni.navigateTo({ url: '/pages/login/login' })
}

/**
 * 退出登录
 */
function onLogout(): void {
	userStore.logout()
	showXToast('hand-stop', '已退出', '可随时重新登录')
}

function goNotify(): void {
	uni.navigateTo({ url: '/pages/notify/notify' })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.profile-top {
	align-items: center;
	padding: 10px 0 4px;
}

.big-avatar {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: #ffe8d6;
	border-width: 3px;
	border-style: solid;
	border-color: #ffffff;
	align-items: center;
	justify-content: center;
	margin-bottom: 10px;
	overflow: hidden;
}

.big-avatar-img {
	width: 72px;
	height: 72px;
}

.name {
	font-size: 18px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 4px;
}

.bio {
	font-size: 12px;
	color: #5c574f;
	text-align: center;
}

.stat-row {
	flex-direction: row;
	justify-content: space-between;
	margin: 16px 0 12px;
}

.stat {
	flex: 1;
	background-color: #ffffff;
	border-radius: 14px;
	padding: 12px 6px;
	align-items: center;
	margin: 0 4px;
}

.stat-n {
	font-size: 17px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 2px;
}

.stat-l {
	font-size: 11px;
	color: #9a948a;
}

.menu {
	padding: 4px 12px;
}

.mrow {
	flex-direction: row;
	align-items: center;
	padding: 12px 2px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: rgba(28, 26, 23, 0.06);
}

.last {
	border-bottom-width: 0;
}

.m-ico {
	width: 34px;
	height: 34px;
	border-radius: 11px;
	background-color: #ebe6df;
	align-items: center;
	justify-content: center;
	margin-right: 10px;
}

.m-col {
	flex: 1;
}

.m-label {
	flex: 1;
	font-size: 13px;
	font-weight: 500;
	color: #1c1a17;
}

.m-sub {
	font-size: 10px;
	color: #9a948a;
}

.badge {
	min-width: 16px;
	height: 16px;
	border-radius: 8px;
	background-color: #e8897a;
	padding: 0 4px;
	align-items: center;
	justify-content: center;
	margin-right: 4px;
}

.badge-t {
	font-size: 9px;
	font-weight: 600;
	color: #ffffff;
}
</style>
