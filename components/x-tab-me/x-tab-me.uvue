<template>
	<!-- 我的 Tab：统一滚动壳 + 下拉刷新资料 -->
	<x-scroll-page
		variant="tab"
		:enable-load-more="false"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
			<view class="status-pad"></view>
			<view class="profile-top" @click="onProfileTap">
				<view class="big-avatar">
					<image
						v-if="profile.avatarUrl != null && profile.avatarUrl.length > 0"
						class="big-avatar-img"
						:src="profile.avatarUrl"
						mode="aspectFill"
					></image>
					<x-icon v-else :name="profile.avatarIcon" :size="30" :color="tokens.ink"></x-icon>
				</view>
				<text class="name">{{ profile.nickname }}</text>
				<text class="bio">{{ profile.bio.length > 0 ? profile.bio : '点击完善个人简介' }}</text>
				<text v-if="homepageLabel.length > 0" class="homepage">{{ homepageLabel }}</text>
			</view>

			<view class="stat-row">
				<view class="stat">
					<text class="stat-n">{{ profile.articleCount }}</text>
					<text class="stat-l">文章</text>
				</view>
				<view class="stat">
					<text class="stat-n">{{ profile.favoriteCount }}</text>
					<text class="stat-l">收藏</text>
				</view>
				<view class="stat">
					<text class="stat-n">{{ profile.likeReceived }}</text>
					<text class="stat-l">获赞</text>
				</view>
			</view>

			<!-- 莫兰迪色系 + 暗黑模式 -->
			<x-theme-picker></x-theme-picker>

			<view class="x-card menu">
				<view v-if="loggedIn" class="mrow" @click="goEditProfile">
					<view class="m-ico"><x-icon name="pencil" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">编辑资料</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view class="mrow" @click="goFavorites">
					<view class="m-ico"><x-icon name="star" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">我的收藏</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view class="mrow" @click="goInbox">
					<view class="m-ico"><x-icon name="inbox" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">评论收件箱</text>
					<view v-if="inboxBadge > 0" class="badge">
						<text class="badge-t">{{ inboxBadge }}</text>
					</view>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view class="mrow" @click="goProfile">
					<view class="m-ico"><x-icon name="user" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">公开主页</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view class="mrow" @click="goAudit">
					<view class="m-ico"><x-icon name="shield" :size="16" :color="tokens.ink"></x-icon></view>
					<view class="m-col">
						<text class="m-label">切换管理模式</text>
						<text class="m-sub">审核 / 订单</text>
					</view>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view v-if="!loggedIn" class="mrow" @click="goLogin">
					<view class="m-ico"><x-icon name="message" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">登录 / 绑定</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view v-else class="mrow" @click="onLogout">
					<view class="m-ico"><x-icon name="logout" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">退出登录</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
				<view class="mrow last" @click="goNotify">
					<view class="m-ico"><x-icon name="bell" :size="16" :color="tokens.ink"></x-icon></view>
					<text class="m-label">站内通知</text>
					<x-icon name="chevron-right" :size="16" :color="tokens.ink3"></x-icon>
				</view>
			</view>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 我的 Tab 面板：对齐原型 me
 * 数据来源：Pinia useUserStore.profile（GET /user/info → nickname / avatar / intro / homepage）
 * 编辑：/pages-blog/profile-edit；头像优先 avatarUrl；角标来自收件箱
 * 滚动：x-scroll-page 下拉刷新
 */
import { storeToRefs } from 'pinia'
import { fetchInbox } from '../../api/modules/interact'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { useTheme } from '../../composables/useTheme'
import { useUserStore } from '../../store/user'
import { showXToast } from '../../utils/toast'

const userStore = useUserStore()
const { profile, loggedIn } = storeToRefs(userStore)
const store = useMockStore()
const inboxBadge = store.inboxBadge
const { tokens } = useTheme()

/**
 * 个人主页展示文案（不依赖 URL 构造，兼容 App / 小程序）
 * 形如 https://www.a.com/path → a.com
 */
const homepageLabel = computed((): string => {
	const url = profile.value.homepage != null ? ('' + profile.value.homepage).trim() : ''
	if (url.length == 0) return ''
	let rest = url
	const scheme = rest.indexOf('://')
	if (scheme >= 0) rest = rest.substring(scheme + 3)
	const slash = rest.indexOf('/')
	if (slash >= 0) rest = rest.substring(0, slash)
	const q = rest.indexOf('?')
	if (q >= 0) rest = rest.substring(0, q)
	if (rest.indexOf('www.') == 0) rest = rest.substring(4)
	if (rest.length == 0) {
		return url.length > 32 ? url.substring(0, 32) + '…' : url
	}
	return rest
})

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/**
 * 已登录则刷新资料与收件箱角标
 */
async function loadMe(): Promise<void> {
	if (!userStore.loggedIn) return
	try {
		await userStore.refreshProfile()
	} catch (_) {}
	try {
		const inbox = await fetchInbox(1, 20)
		store.inboxBadge.value = inbox.length
	} catch (_) {
		store.inboxBadge.value = 0
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadMe()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

// 登录成功 / 退出后即时刷新（组件常驻主壳，不会重新 mount）
watch(loggedIn, (v: boolean) => {
	if (v) {
		loadMe()
	} else {
		store.inboxBadge.value = 0
	}
})

/**
 * 点头像区：未登录去登录；已登录进编辑资料
 */
function onProfileTap(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	goEditProfile()
}

/**
 * 编辑头像 / 昵称 / 简介 / 个人主页
 */
function goEditProfile(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/profile-edit/index' })
}

function goFavorites(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/favorites/index' })
}

function goInbox(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	uni.navigateTo({ url: '/pages-blog/inbox/index' })
}

function goProfile(): void {
	if (!userStore.loggedIn) {
		goLogin()
		return
	}
	const id = userStore.profile.id
	const q = id > 0 ? '?uid=' + id : ''
	uni.navigateTo({ url: '/pages-blog/profile/index' + q })
}

function goAudit(): void {
	uni.navigateTo({ url: '/pages-blog/audit/index' })
}

function goLogin(): void {
	uni.navigateTo({ url: '/pages/login/login' })
}

/**
 * 退出登录
 */
function onLogout(): void {
	userStore.logout()
	showXToast('hand-stop', '已退出', '可随时重新登录')
}

function goNotify(): void {
	uni.navigateTo({ url: '/pages/notify/notify' })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.profile-top {
	align-items: center;
	padding: 10px 0 4px;
}

.big-avatar {
	width: 72px;
	height: 72px;
	border-radius: 36px;
	background-color: var(--x-warm-tint, #ffe8d6);
	border-width: 3px;
	border-style: solid;
	border-color: var(--x-surface, #ffffff);
	align-items: center;
	justify-content: center;
	margin-bottom: 10px;
	overflow: hidden;
}

.big-avatar-img {
	width: 72px;
	height: 72px;
}

.name {
	font-size: 18px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 4px;
}

.bio {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	text-align: center;
}

.homepage {
	font-size: 11px;
	color: var(--x-accent-deep, #2a8f76);
	margin-top: 4px;
	text-align: center;
}

.stat-row {
	flex-direction: row;
	justify-content: space-between;
	margin: 16px 0 12px;
}

.stat {
	flex: 1;
	background-color: var(--x-surface, #ffffff);
	border-radius: 14px;
	padding: 12px 6px;
	align-items: center;
	margin: 0 4px;
}

.stat-n {
	font-size: 17px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 2px;
}

.stat-l {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.menu {
	padding: 4px 12px;
}

.mrow {
	flex-direction: row;
	align-items: center;
	padding: 12px 2px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: var(--x-line, rgba(28, 26, 23, 0.06));
}

.last {
	border-bottom-width: 0;
}

.m-ico {
	width: 34px;
	height: 34px;
	border-radius: 11px;
	background-color: var(--x-bg-2, #ebe6df);
	align-items: center;
	justify-content: center;
	margin-right: 10px;
}

.m-col {
	flex: 1;
}

.m-label {
	flex: 1;
	font-size: 13px;
	font-weight: 500;
	color: var(--x-ink, #1c1a17);
}

.m-sub {
	font-size: 10px;
	color: var(--x-ink-3, #9a948a);
}

.badge {
	min-width: 16px;
	height: 16px;
	border-radius: 8px;
	background-color: var(--x-danger, #e8897a);
	padding: 0 4px;
	align-items: center;
	justify-content: center;
	margin-right: 4px;
}

.badge-t {
	font-size: 9px;
	font-weight: 600;
	color: var(--x-on-ink, #ffffff);
}
</style>
