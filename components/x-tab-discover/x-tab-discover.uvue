<template>
	<!-- 发现 Tab：统一滚动壳；入口磁贴 + 热门 -->
	<x-scroll-page
		variant="tab"
		:enable-load-more="false"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
		<view class="status-pad"></view>
		<text class="x-page-title">发现</text>

		<view class="search-bar" @click="goSearch">
			<view class="search-ico">
				<x-icon name="search" :size="14" color="#9a948a"></x-icon>
			</view>
			<text class="search-ph">搜索文章、标签、作者</text>
		</view>

		<!-- 分类过多横滑；点击跳搜索 -->
		<x-category-chips
			:items="categories"
			:active-index="0"
			@select="onSelectCat"
		></x-category-chips>

		<view class="x-grid-2">
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goArchive">
					<view class="x-tile-ico"><x-icon name="books" :size="22" color="#1c1a17"></x-icon></view>
					<text class="x-tile-title">归档</text>
					<text class="x-tile-desc">按月浏览</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goTags">
					<view class="x-tile-ico"><x-icon name="tag" :size="22" color="#1c1a17"></x-icon></view>
					<text class="x-tile-title">标签墙</text>
					<text class="x-tile-desc">全部标签</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goGuestbook">
					<view class="x-tile-ico"><x-icon name="message" :size="22" color="#1c1a17"></x-icon></view>
					<text class="x-tile-title">留言板</text>
					<text class="x-tile-desc">访客留言</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goLinks">
					<view class="x-tile-ico"><x-icon name="link" :size="22" color="#1c1a17"></x-icon></view>
					<text class="x-tile-title">友链</text>
					<text class="x-tile-desc">友情链接</text>
				</view>
			</view>
		</view>

		<view class="x-section-head">
			<text class="x-section-title">热门</text>
		</view>
		<x-article-card
			:id="hot.id"
			:title="hot.title"
			:category-name="hot.categoryName"
			:time-label="hot.timeLabel"
			:cover-url="hot.coverUrl"
			:cover-icon="hot.coverIcon"
			:cover-c1="hot.coverC1"
			:like-count="hot.likeCount"
			:comment-count="hot.commentCount"
			:show-stat="false"
			:stat-line="hotStatLine"
			:show-meta="false"
			@open="goDetail"
		></x-article-card>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 发现 Tab 面板：对齐原型 discover
 * 数据来源：联调文章列表取热门；分类 GET /category
 * 滚动：x-scroll-page 下拉刷新（入口页无分页）
 */
import type { ArticleSummary, CategoryChip } from '../../types/article'
import { fetchArticleList, fetchCategories } from '../../api/modules/article'
import { useListScroll } from '../../composables/useListScroll'

const emptyHot: ArticleSummary = {
	id: '',
	title: '',
	categoryName: '',
	timeLabel: '',
	likeCount: 0,
	commentCount: 0,
	coverUrl: '',
	coverIcon: 'flame',
	coverC1: '#e8a87c',
	coverC2: '#f4d4a8',
	hotLabel: '',
}

const categories = ref([] as CategoryChip[])
const hot = ref(emptyHot)

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(5)

/** 热门卡副文案 */
const hotStatLine = computed((): string => {
	const h = hot.value.hotLabel
	if (h != null && h.length > 0) return h
	return '热门'
})

/**
 * 加载分类 + 热门（列表首条）
 */
async function loadDiscover(): Promise<void> {
	try {
		const rows = await fetchCategories()
		const chips: CategoryChip[] = [{ id: '', label: '推荐' }]
		for (let i = 0; i < rows.length; i++) {
			chips.push({ id: rows[i].id, label: rows[i].label })
		}
		categories.value = chips
	} catch (_) {
		categories.value = [{ id: '', label: '推荐' }]
	}

	let articles = [] as ArticleSummary[]
	try {
		const res = await fetchArticleList({ page: 1, pageSize: 5, client: true })
		articles = res.list
	} catch (_) {}
	if (articles.length > 0) {
		const top = articles[0]
		hot.value = {
			...top,
			hotLabel: top.likeCount > 0 ? '热度 ' + top.likeCount : '热门',
		}
	}
}

/**
 * 下拉刷新
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadDiscover()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

function goSearch(): void {
	uni.navigateTo({ url: '/pages/search/search' })
}

/**
 * 分类 chip → 搜索页（「推荐/全部」不带关键词）
 */
function onSelectCat(_i: number, chip: CategoryChip): void {
	const c = chip != null && chip.label != null ? chip.label : ''
	if (c == '推荐' || c == '全部' || c.length == 0) {
		goSearch()
		return
	}
	uni.navigateTo({ url: '/pages/search/search?q=' + encodeURIComponent(c) })
}

function goArchive(): void {
	uni.navigateTo({ url: '/pages-blog/archives/index' })
}

/** 进标签墙（联调 GET /tag） */
function goTags(): void {
	uni.navigateTo({ url: '/pages-blog/tags/index' })
}

function goGuestbook(): void {
	uni.navigateTo({ url: '/pages-blog/guestbook/index' })
}

function goLinks(): void {
	uni.navigateTo({ url: '/pages-blog/links/index' })
}

function goDetail(id: string): void {
	uni.navigateTo({ url: '/pages/detail/detail?id=' + id })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.search-bar {
	flex-direction: row;
	align-items: center;
	background-color: var(--x-surface, #ffffff);
	border-radius: 999px;
	padding: 11px 14px;
	margin-bottom: 12px;
}

.search-ico {
	margin-right: 8px;
	align-items: center;
	justify-content: center;
}

.search-ph {
	flex: 1;
	font-size: 13px;
	color: var(--x-ink-3, #9a948a);
}
</style>
