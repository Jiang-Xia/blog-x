<template>
	<!-- 文章列表小卡：封面优先文章 coverUrl，无则 x-icon 占位 -->
	<view class="x-card article" @click="onOpen">
		<view class="article-body">
			<view v-if="showMeta" class="meta-row">
				<text class="x-meta">{{ metaLine }}</text>
			</view>
			<text class="article-title">{{ title }}</text>
			<view v-if="showStat" class="article-stat-row">
				<x-icon name="thumb-up" :size="11" :color="tokens.ink2"></x-icon>
				<text class="article-stat">{{ likeCount }}</text>
				<x-icon name="message" :size="11" :color="tokens.ink2"></x-icon>
				<text class="article-stat">{{ commentCount }}</text>
			</view>
			<text v-else-if="statLine.length > 0" class="article-stat">{{ statLine }}</text>
		</view>
		<view class="cover" :style="{ backgroundColor: coverBg }">
			<image
				v-if="coverUrl.length > 0"
				class="cover-img"
				:src="coverUrl"
				mode="aspectFill"
			></image>
			<x-icon v-else :name="coverIcon" :size="26" :color="tokens.ink2"></x-icon>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 文章卡片（列表复用）
 * - 封面：文章 coverUrl（API cover 经 resolveStaticUrl）；空则 coverIcon + coverC1
 * - 深色：占位封面映射为压饱和色块，避免亮粉绿跳色
 * - 点击抛 open(id)，由父页跳转详情
 */
import { useTheme } from '../../composables/useTheme'

const props = defineProps({
	id: { type: String, default: '' },
	title: { type: String, default: '' },
	categoryName: { type: String, default: '' },
	timeLabel: { type: String, default: '' },
	coverUrl: { type: String, default: '' },
	/** 无封面时的 Tabler 占位图标名 */
	coverIcon: { type: String, default: 'book' },
	coverC1: { type: String, default: '#c8efe4' },
	likeCount: { type: Number, default: 0 },
	commentCount: { type: Number, default: 0 },
	/** 热度等自定义副文案；有值时替代 category·time */
	hotLabel: { type: String, default: '' },
	/** 是否展示点赞/评论 */
	showStat: { type: Boolean, default: true },
	/** 无 showStat 时的自定义一行（如「热度 1.2k」） */
	statLine: { type: String, default: '' },
	/** 是否展示 meta 行 */
	showMeta: { type: Boolean, default: true },
})

const emit = defineEmits(['open'])
const { tokens, isDark } = useTheme()

const metaLine = computed((): string => {
	if (props.hotLabel.length > 0) return props.hotLabel
	const cat = props.categoryName
	const time = props.timeLabel
	if (cat.length > 0 && time.length > 0) return cat + ' · ' + time
	if (cat.length > 0) return cat
	return time
})

/**
 * 亮色占位封面 → 深色压饱和色（与 adapters COVER_PALETTE 对齐）
 */
function coverC1ForDark(c1: string): string {
	if (c1 == '#c8efe4') return '#2a403a'
	if (c1 == '#ffe8d6') return '#3d322c'
	if (c1 == '#e8dff8') return '#322e3d'
	if (c1 == '#fde2e2') return '#3d2e2e'
	if (c1 == '#e8a87c') return '#3d3228'
	if (c1 == '#f4d4a8') return '#3a3228'
	if (c1 == '#d4cfc7') return '#2e2c2a'
	return tokens.value.bg2
}

/**
 * 封面占位底色：深色模式用压饱和映射，避免浅粉绿突兀
 */
const coverBg = computed((): string => {
	if (!isDark.value) return props.coverC1
	return coverC1ForDark(props.coverC1)
})

/**
 * 打开文章详情
 */
function onOpen(): void {
	if (props.id.length == 0) return
	emit('open', props.id)
}
</script>

<style>
@import '../../styles/x-base.css';

.article {
	flex-direction: row;
	align-items: center;
}

.article-body {
	flex: 1;
	margin-right: 12px;
}

.meta-row {
	flex-direction: row;
	margin-bottom: 4px;
}

.article-title {
	font-size: 14px;
	font-weight: 650;
	color: var(--x-ink, #1c1a17);
	line-height: 1.35;
	margin-bottom: 4px;
	lines: 2;
	text-overflow: ellipsis;
}

.article-stat-row {
	flex-direction: row;
	align-items: center;
}

.article-stat {
	font-size: 11px;
	color: var(--x-ink-2, #5c574f);
	margin-left: 2px;
	margin-right: 8px;
}

.cover {
	width: 78px;
	height: 78px;
	border-radius: 16px;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}

.cover-img {
	width: 78px;
	height: 78px;
}
</style>
