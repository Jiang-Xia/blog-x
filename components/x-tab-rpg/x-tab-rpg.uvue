<template>
	<!-- 冒险中心面板：Hero、每日任务、玩法入口、充值（mock） -->
	<scroll-view class="x-page-tab" scroll-y="true">
		<view class="status-pad"></view>
		<view class="head-row">
			<text class="x-page-title">冒险中心</text>
			<text class="x-chip x-chip-peach">{{ hero.weatherBuff }}</text>
		</view>

		<view class="rpg-hero">
			<text class="hero-label">旅行者 · {{ hero.travelerName }} · 连续签到 {{ streakDays }}</text>
			<text class="hero-lv">Lv.{{ hero.level }} · 距下一级还差 {{ hero.expToNext }} 经验</text>
			<view class="bar">
				<view class="bar-i" :style="{ width: hero.expBarPercent + '%' }"></view>
			</view>
			<view class="bal-row">
				<text class="bal">💎 {{ diamonds }}</text>
				<text class="bal">🪙 {{ hero.coins }}</text>
				<text class="bal">抽奖券 ×{{ hero.lotteryTickets }}</text>
			</view>
		</view>

		<view class="x-card quest">
			<view :class="checkedInToday ? 'q-icon done' : 'q-icon'">
				<text>{{ checkedInToday ? '✅' : '☀️' }}</text>
			</view>
			<view class="q-body">
				<text class="q-title">每日签到</text>
				<text class="q-desc">{{ checkedInToday ? '今日已签到' : '签到领取经验与钻石' }}</text>
			</view>
			<view
				:class="checkedInToday ? 'x-btn disabled' : 'x-btn'"
				@click="onCheckin"
			>
				<text class="x-btn-text">{{ checkedInToday ? '已签' : '签到' }}</text>
			</view>
		</view>

		<view class="x-card quest">
			<view class="q-icon peach">
				<text>📖</text>
			</view>
			<view class="q-body">
				<text class="q-title">阅读 1 篇文章</text>
				<text class="q-desc">进度 0/1</text>
			</view>
			<view class="x-btn x-btn-ghost" @click="goHome">
				<text class="x-btn-ghost-text">去完成</text>
			</view>
		</view>

		<view class="x-grid-2">
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goLottery">
					<text class="x-tile-ico">🎰</text>
					<text class="x-tile-title">幸运抽奖</text>
					<text class="x-tile-desc">消耗抽奖券</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goRank">
					<text class="x-tile-ico">🏆</text>
					<text class="x-tile-title">排行榜</text>
					<text class="x-tile-desc">本周经验</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="goCalendar">
					<text class="x-tile-ico">📅</text>
					<text class="x-tile-title">签到日历</text>
					<text class="x-tile-desc">本月进度</text>
				</view>
			</view>
			<view class="x-grid-2-item">
				<view class="x-tile" @click="onBag">
					<text class="x-tile-ico">🎒</text>
					<text class="x-tile-title">背包装扮</text>
					<text class="x-tile-desc">称号 / 头像框</text>
				</view>
			</view>
		</view>

		<view class="recharge-row">
			<text class="recharge-tip">钻石不足？</text>
			<view class="x-btn" @click="goRecharge">
				<text class="x-btn-text">充值</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
/**
 * 冒险中心面板：对齐原型 rpg 屏
 * 数据来源：联调 /rpg/status|sign|my-quests；失败回落 mock
 */
import { rpgHeroSeed, rpgQuestsSeed } from '../../mock/data'
import type { RpgHero, RpgQuest } from '../../types/rpg'
import {
	fetchMyQuests,
	fetchRpgHero,
	fetchSignInfo,
	rpgSignIn,
} from '../../api/modules/rpg'
import { apiOrMock } from '../../composables/useApiOrMock'
import { USE_MOCK } from '../../api/config'
import { doMockCheckin, useMockStore } from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'
import { goTab, TAB_HOME } from '../../utils/tabNav'

const hero = ref(rpgHeroSeed as RpgHero)
const quests = ref(rpgQuestsSeed as RpgQuest[])
const store = useMockStore()
const diamonds = store.diamonds
const streakDays = store.streakDays
const checkedInToday = store.checkedInToday

/**
 * 同步 RPG 状态到本地 store 与 hero
 */
async function loadRpg(): Promise<void> {
	const h = await apiOrMock(() => fetchRpgHero(), rpgHeroSeed)
	hero.value = h
	store.diamonds.value = h.diamonds
	store.streakDays.value = h.streakDays
	const sign = await apiOrMock(() => fetchSignInfo(), {
		signedToday: store.checkedInToday.value,
		streakDays: store.streakDays.value,
	})
	store.checkedInToday.value = sign.signedToday
	if (sign.streakDays > 0) store.streakDays.value = sign.streakDays
	quests.value = await apiOrMock(() => fetchMyQuests(), rpgQuestsSeed)
}

onMounted(() => {
	loadRpg()
})

/** 每日签到 */
async function onCheckin(): Promise<void> {
	if (USE_MOCK) {
		const r = doMockCheckin()
		showXToast(r.ok ? '☀️' : '📌', r.toastTitle, r.toastDesc)
		return
	}
	if (checkedInToday.value) {
		showXToast('📌', '今日已签到', '明天再来哦')
		return
	}
	try {
		await rpgSignIn()
		showXToast('☀️', '签到成功', '')
		await loadRpg()
		store.homeTodayTitle.value = '已签到'
		store.homeStreakLabel.value = '连续 ' + store.streakDays.value + ' 天'
	} catch (_) {}
}

/** 回首页读文章 */
function goHome(): void {
	goTab(TAB_HOME)
}

function goLottery(): void {
	uni.navigateTo({ url: '/pages-rpg/lottery/index' })
}

function goRank(): void {
	uni.navigateTo({ url: '/pages-rpg/rank/index' })
}

function goCalendar(): void {
	uni.navigateTo({ url: '/pages-rpg/calendar/index' })
}

function goRecharge(): void {
	uni.navigateTo({ url: '/pages-rpg/recharge/index' })
}

function onBag(): void {
	showXToast('🎒', '背包', '称号 / 头像框 · 示意')
}
</script>

<style>
