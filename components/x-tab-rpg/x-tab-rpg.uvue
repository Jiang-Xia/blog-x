<template>
	<!-- 冒险中心：海报 → 冒险者卡片（真实用户）→ 签到/任务 → 四入口 -->
	<x-scroll-page
		variant="tab"
		:enable-load-more="false"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
			<view class="status-pad"></view>
			<view class="head-row">
				<text class="x-page-title">冒险中心</text>
				<text class="x-chip x-chip-peach">{{ hero.weatherBuff }}</text>
			</view>

			<!-- 活动海报（对齐 Nuxt SeasonBanner） -->
			<view v-if="poster != null" class="poster-card" @click="previewPoster">
				<image
					v-if="posterUrl.length > 0"
					class="poster-img"
					:src="posterUrl"
					mode="aspectFill"
				></image>
				<view class="poster-body">
					<text class="poster-type">{{ posterTypeLabel }}</text>
					<text class="poster-name">{{ poster.name }}</text>
					<text v-if="poster.description.length > 0" class="poster-desc">{{ poster.description }}</text>
					<text v-if="poster.expBuffRate > 1" class="poster-buff">经验 ×{{ poster.expBuffRate }}</text>
				</view>
			</view>

			<!-- 冒险者卡片：登录用户真实信息 -->
			<view class="rpg-hero">
				<view class="hero-top">
					<view class="hero-av">
						<image
							v-if="avatarUrl.length > 0"
							class="hero-av-img"
							:src="avatarUrl"
							mode="aspectFill"
						></image>
						<x-icon v-else name="paw" :size="22" color="#ffffff"></x-icon>
					</view>
					<view class="hero-meta">
						<text class="hero-label">旅行者 · {{ travelerName }} · 连续签到 {{ streakDays }}</text>
						<text class="hero-lv">Lv.{{ hero.level }} · 距下一级还差 {{ hero.expToNext }} 经验</text>
					</view>
				</view>
				<view class="bar">
					<view class="bar-i" :style="{ width: hero.expBarPercent + '%' }"></view>
				</view>
				<view class="bal-row">
					<view class="bal">
						<x-icon name="diamond" :size="14" color="#ffffff"></x-icon>
						<text class="bal-t">{{ diamonds }}</text>
					</view>
					<view class="bal">
						<x-icon name="coin" :size="14" color="#ffffff"></x-icon>
						<text class="bal-t">{{ hero.coins }}</text>
					</view>
					<text class="bal-t">抽奖券 ×{{ hero.lotteryTickets }}</text>
				</view>
			</view>

			<!-- 功能入口放在冒险者卡片下方 -->
			<view class="x-grid-2">
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goLottery">
						<view class="x-tile-ico"><x-icon name="dice" :size="20" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">幸运抽奖</text>
						<text class="x-tile-desc">消耗抽奖券</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goRank">
						<view class="x-tile-ico"><x-icon name="trophy" :size="20" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">排行榜</text>
						<text class="x-tile-desc">本周经验</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goCalendar">
						<view class="x-tile-ico"><x-icon name="calendar" :size="20" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">签到日历</text>
						<text class="x-tile-desc">本月进度</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="onBag">
						<view class="x-tile-ico"><x-icon name="backpack" :size="20" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">背包装扮</text>
						<text class="x-tile-desc">称号 / 头像框</text>
					</view>
				</view>
			</view>

			<view class="x-card quest">
				<view :class="checkedInToday ? 'q-icon done' : 'q-icon'">
					<x-icon
						:name="checkedInToday ? 'check' : 'sun'"
						:size="18"
						:color="checkedInToday ? '#2a8f76' : '#1c1a17'"
					></x-icon>
				</view>
				<view class="q-body">
					<text class="q-title">每日签到</text>
					<text class="q-desc">{{ checkedInToday ? '今日已签到' : '签到领取经验与钻石' }}</text>
				</view>
				<view
					:class="checkedInToday ? 'x-btn disabled' : 'x-btn'"
					@click="onCheckin"
				>
					<text class="x-btn-text">{{ checkedInToday ? '已签' : '签到' }}</text>
				</view>
			</view>

			<!-- 签到任务已有独立卡片，列表排除 kind=checkin -->
			<view v-for="q in displayQuests" :key="q.id" class="x-card quest">
				<view :class="q.done ? 'q-icon done' : 'q-icon peach'">
					<x-icon
						:name="q.done ? 'check' : q.icon"
						:size="18"
						:color="q.done ? '#2a8f76' : '#1c1a17'"
					></x-icon>
				</view>
				<view class="q-body">
					<text class="q-title">{{ q.title }}</text>
					<text class="q-desc">{{ q.desc }}</text>
				</view>
				<view v-if="q.done" class="x-btn disabled">
					<text class="x-btn-text">已领</text>
				</view>
				<view v-else-if="q.claimable" class="x-btn" @click="onClaim(q.id)">
					<text class="x-btn-text">领取</text>
				</view>
				<view v-else class="x-btn x-btn-ghost" @click="goHome">
					<text class="x-btn-ghost-text">去完成</text>
				</view>
			</view>

			<view class="recharge-row">
				<text class="recharge-tip">钻石不足？</text>
				<view class="x-btn" @click="goRecharge">
					<text class="x-btn-text">充值</text>
				</view>
			</view>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 冒险中心面板：对齐原型 rpg + Nuxt 海报 / 用户卡
 * 数据来源：/rpg/status|sign|my-quests|activities/current；用户昵称/头像来自 Pinia
 */
import type { RpgHero, RpgQuest } from '../../types/rpg'
import {
	claimQuest,
	fetchActivityPoster,
	fetchMyQuests,
	fetchRpgHero,
	fetchSignInfo,
	rpgSignIn,
	type RpgActivityPoster,
} from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { useUserStore } from '../../store/user'
import { resolveStaticUrl } from '../../utils/static-url'
import { showXToast } from '../../utils/toast'
import { goTab, TAB_HOME } from '../../utils/tabNav'
import { storeToRefs } from 'pinia'

const emptyHero: RpgHero = {
	travelerName: '',
	level: 0,
	expToNext: 0,
	expBarPercent: 0,
	diamonds: 0,
	coins: 0,
	lotteryTickets: 0,
	streakDays: 0,
	weatherBuff: '',
}

const hero = ref(emptyHero)
const quests = ref([] as RpgQuest[])
const poster = ref(null as RpgActivityPoster | null)
const store = useMockStore()
const userStore = useUserStore()
const { profile, loggedIn } = storeToRefs(userStore)
const diamonds = store.diamonds
const streakDays = store.streakDays
const checkedInToday = store.checkedInToday

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/** 展示用旅行者名：优先登录昵称 */
const travelerName = computed((): string => {
	if (loggedIn.value && profile.value.nickname.length > 0 && profile.value.nickname != '未登录') {
		return profile.value.nickname
	}
	if (hero.value.travelerName.length > 0) return hero.value.travelerName
	return '旅行者'
})

/** 头像完整 URL */
const avatarUrl = computed((): string => {
	if (loggedIn.value && profile.value.avatarUrl.length > 0) return profile.value.avatarUrl
	return ''
})

/** 海报完整 URL */
const posterUrl = computed((): string => {
	const p = poster.value
	if (p == null || p.posterUrl.length == 0) return ''
	return resolveStaticUrl(p.posterUrl)
})

/** 活动类型中文 */
const posterTypeLabel = computed((): string => {
	const t = poster.value != null ? poster.value.activityType : ''
	if (t == 'season') return '赛季'
	if (t == 'festival') return '节日'
	if (t == 'event') return '限时'
	return '活动'
})

/** 展示用任务（排除签到，避免与上方签到卡重复） */
const displayQuests = computed((): RpgQuest[] => {
	const list: RpgQuest[] = []
	for (let i = 0; i < quests.value.length; i++) {
		if (quests.value[i].kind != 'checkin') {
			list.push(quests.value[i])
		}
	}
	return list
})

/**
 * 同步 RPG 状态到本地 store 与 hero
 */
async function loadRpg(): Promise<void> {
	try {
		const h = await fetchRpgHero()
		hero.value = h
		store.diamonds.value = h.diamonds
		store.streakDays.value = h.streakDays
	} catch (_) {}

	try {
		const sign = await fetchSignInfo()
		store.checkedInToday.value = sign.signedToday
		if (sign.streakDays > 0) store.streakDays.value = sign.streakDays
		store.homeTodayTitle.value = sign.signedToday ? '今日已签到' : '今日待签到'
		store.homeStreakLabel.value = '连续 ' + store.streakDays.value + ' 天'
	} catch (_) {}

	try {
		quests.value = await fetchMyQuests()
	} catch (_) {
		quests.value = []
	}

	try {
		poster.value = await fetchActivityPoster()
	} catch (_) {
		poster.value = null
	}
}

/**
 * 下拉刷新冒险状态
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadRpg()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

/** 预览活动海报大图 */
function previewPoster(): void {
	const url = posterUrl.value
	if (url.length == 0) return
	uni.previewImage({ urls: [url], current: url })
}

/** 每日签到 */
async function onCheckin(): Promise<void> {
	if (!userStore.loggedIn) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	if (checkedInToday.value) {
		showXToast('pin', '今日已签到', '明天再来哦')
		return
	}
	try {
		await rpgSignIn()
		showXToast('sun', '签到成功', '')
		await loadRpg()
		store.homeTodayTitle.value = '已签到'
		store.homeStreakLabel.value = '连续 ' + store.streakDays.value + ' 天'
	} catch (_) {}
}

/**
 * 领取任务奖励：POST /rpg/quest/claim
 */
async function onClaim(questCode: string): Promise<void> {
	try {
		await claimQuest(questCode)
		showXToast('gift', '奖励已领取', '')
		await loadRpg()
	} catch (_) {}
}

/** 回首页读文章 */
function goHome(): void {
	goTab(TAB_HOME)
}

function goLottery(): void {
	uni.navigateTo({ url: '/pages-rpg/lottery/index' })
}

function goRank(): void {
	uni.navigateTo({ url: '/pages-rpg/rank/index' })
}

function goCalendar(): void {
	uni.navigateTo({ url: '/pages-rpg/calendar/index' })
}

function goRecharge(): void {
	uni.navigateTo({ url: '/pages-rpg/recharge/index' })
}

/** 进背包装扮页 */
function onBag(): void {
	uni.navigateTo({ url: '/pages-rpg/backpack/index' })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.head-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.poster-card {
	background-color: var(--x-surface, #ffffff);
	border-radius: 22px;
	overflow: hidden;
	margin-bottom: 12px;
}

.poster-img {
	width: 100%;
	height: 140px;
	background-color: var(--x-bg-2, #ebe6df);
}

.poster-body {
	padding: 12px 14px 14px;
}

.poster-type {
	font-size: 10px;
	font-weight: 600;
	color: var(--x-accent-deep, #2a8f76);
	margin-bottom: 4px;
}

.poster-name {
	font-size: 15px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 4px;
}

.poster-desc {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	line-height: 1.4;
	margin-bottom: 4px;
}

.poster-buff {
	font-size: 11px;
	font-weight: 600;
	color: #c06a45;
}

.rpg-hero {
	background-color: #2d6b5c;
	border-radius: 22px;
	padding: 16px;
	margin-bottom: 12px;
}

.hero-top {
	flex-direction: row;
	align-items: center;
	margin-bottom: 10px;
}

.hero-av {
	width: 48px;
	height: 48px;
	border-radius: 24px;
	background-color: rgba(255, 255, 255, 0.18);
	align-items: center;
	justify-content: center;
	margin-right: 12px;
	overflow: hidden;
}

.hero-av-img {
	width: 48px;
	height: 48px;
}

.hero-meta {
	flex: 1;
}

.hero-label {
	font-size: 12px;
	color: rgba(255, 255, 255, 0.78);
	margin-bottom: 4px;
}

.hero-lv {
	font-size: 16px;
	font-weight: 700;
	color: var(--x-on-ink, #ffffff);
	line-height: 1.3;
}

.bar {
	height: 8px;
	background-color: rgba(255, 255, 255, 0.2);
	border-radius: 999px;
	overflow: hidden;
	margin-bottom: 6px;
}

.bar-i {
	height: 8px;
	background-color: var(--x-warm, #f6d9a8);
	border-radius: 999px;
}

.bal-row {
	flex-direction: row;
	margin-top: 6px;
	align-items: center;
}

.bal {
	flex-direction: row;
	align-items: center;
	margin-right: 14px;
}

.bal-t {
	font-size: 11px;
	color: rgba(255, 255, 255, 0.9);
	margin-left: 4px;
}

.quest {
	flex-direction: row;
	align-items: center;
}

.q-icon {
	width: 42px;
	height: 42px;
	border-radius: 14px;
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
	align-items: center;
	justify-content: center;
	margin-right: 12px;
}

.q-icon.peach {
	background-color: rgba(240, 160, 122, 0.16);
}

.q-icon.done {
	background-color: rgba(61, 184, 154, 0.22);
}

.q-body {
	flex: 1;
}

.q-title {
	font-size: 13px;
	font-weight: 650;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 2px;
}

.q-desc {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.disabled {
	opacity: 0.55;
}

.recharge-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 2px 20px;
}

.recharge-tip {
	font-size: 13px;
	color: var(--x-ink-2, #5c574f);
}
</style>
