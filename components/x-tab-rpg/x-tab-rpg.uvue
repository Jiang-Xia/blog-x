<template>
	<!-- 冒险中心：统一滚动壳 + 下拉刷新 -->
	<x-scroll-page
		variant="tab"
		:enable-load-more="false"
		:refreshing="refreshing"
		:pulling-distance="pullingDistance"
		:show-footer="showFooter"
		@refresh="onRefresh"
		@refresherpulling="onRefresherPulling"
		@refresherrestore="onRefresherRestore"
		@refresherabort="onRefresherAbort"
	>
			<view class="status-pad"></view>
			<view class="head-row">
				<text class="x-page-title">冒险中心</text>
				<text class="x-chip x-chip-peach">{{ hero.weatherBuff }}</text>
			</view>

			<view class="rpg-hero">
				<text class="hero-label">旅行者 · {{ hero.travelerName }} · 连续签到 {{ streakDays }}</text>
				<text class="hero-lv">Lv.{{ hero.level }} · 距下一级还差 {{ hero.expToNext }} 经验</text>
				<view class="bar">
					<view class="bar-i" :style="{ width: hero.expBarPercent + '%' }"></view>
				</view>
				<view class="bal-row">
					<view class="bal">
						<x-icon name="diamond" :size="14" color="#ffffff"></x-icon>
						<text class="bal-t">{{ diamonds }}</text>
					</view>
					<view class="bal">
						<x-icon name="coin" :size="14" color="#ffffff"></x-icon>
						<text class="bal-t">{{ hero.coins }}</text>
					</view>
					<text class="bal-t">抽奖券 ×{{ hero.lotteryTickets }}</text>
				</view>
			</view>

			<view class="x-card quest">
				<view :class="checkedInToday ? 'q-icon done' : 'q-icon'">
					<x-icon
						:name="checkedInToday ? 'circle-check' : 'sun'"
						:size="18"
						:color="checkedInToday ? '#2a8f76' : '#1c1a17'"
					></x-icon>
				</view>
				<view class="q-body">
					<text class="q-title">每日签到</text>
					<text class="q-desc">{{ checkedInToday ? '今日已签到' : '签到领取经验与钻石' }}</text>
				</view>
				<view
					:class="checkedInToday ? 'x-btn disabled' : 'x-btn'"
					@click="onCheckin"
				>
					<text class="x-btn-text">{{ checkedInToday ? '已签' : '签到' }}</text>
				</view>
			</view>

			<!-- 签到任务已有独立卡片，列表排除 kind=checkin -->
			<view v-for="q in displayQuests" :key="q.id" class="x-card quest">
				<view :class="q.done ? 'q-icon done' : 'q-icon peach'">
					<x-icon
						:name="q.done ? 'circle-check' : q.icon"
						:size="18"
						:color="q.done ? '#2a8f76' : '#1c1a17'"
					></x-icon>
				</view>
				<view class="q-body">
					<text class="q-title">{{ q.title }}</text>
					<text class="q-desc">{{ q.desc }}</text>
				</view>
				<view v-if="q.done" class="x-btn disabled">
					<text class="x-btn-text">已领</text>
				</view>
				<view v-else-if="q.claimable" class="x-btn" @click="onClaim(q.id)">
					<text class="x-btn-text">领取</text>
				</view>
				<view v-else class="x-btn x-btn-ghost" @click="goHome">
					<text class="x-btn-ghost-text">去完成</text>
				</view>
			</view>

			<view class="x-grid-2">
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goLottery">
						<view class="x-tile-ico"><x-icon name="dice" :size="22" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">幸运抽奖</text>
						<text class="x-tile-desc">消耗抽奖券</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goRank">
						<view class="x-tile-ico"><x-icon name="trophy" :size="22" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">排行榜</text>
						<text class="x-tile-desc">本周经验</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="goCalendar">
						<view class="x-tile-ico"><x-icon name="calendar" :size="22" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">签到日历</text>
						<text class="x-tile-desc">本月进度</text>
					</view>
				</view>
				<view class="x-grid-2-item">
					<view class="x-tile" @click="onBag">
						<view class="x-tile-ico"><x-icon name="backpack" :size="22" color="#1c1a17"></x-icon></view>
						<text class="x-tile-title">背包装扮</text>
						<text class="x-tile-desc">称号 / 头像框</text>
					</view>
				</view>
			</view>

			<view class="recharge-row">
				<text class="recharge-tip">钻石不足？</text>
				<view class="x-btn" @click="goRecharge">
					<text class="x-btn-text">充值</text>
				</view>
			</view>
	</x-scroll-page>
</template>

<script setup lang="ts">
/**
 * 冒险中心面板：对齐原型 rpg 屏
 * 数据来源：联调 /rpg/status|sign|my-quests
 * 滚动：x-scroll-page 下拉刷新
 */
import type { RpgHero, RpgQuest } from '../../types/rpg'
import {
	claimQuest,
	fetchMyQuests,
	fetchRpgHero,
	fetchSignInfo,
	rpgSignIn,
} from '../../api/modules/rpg'
import { useListScroll } from '../../composables/useListScroll'
import { useMockStore } from '../../composables/useMockStore'
import { showXToast } from '../../utils/toast'
import { goTab, TAB_HOME } from '../../utils/tabNav'

const emptyHero: RpgHero = {
	travelerName: '',
	level: 0,
	expToNext: 0,
	expBarPercent: 0,
	diamonds: 0,
	coins: 0,
	lotteryTickets: 0,
	streakDays: 0,
	weatherBuff: '',
}

const hero = ref(emptyHero)
const quests = ref([] as RpgQuest[])
const store = useMockStore()
const diamonds = store.diamonds
const streakDays = store.streakDays
const checkedInToday = store.checkedInToday

const {
	refreshing,
	pullingDistance,
	showFooter,
	onRefresherPulling,
	onRefresherRestore,
	onRefresherAbort,
	beginRefresh,
	endRefresh,
} = useListScroll(10)

/** 展示用任务（排除签到，避免与上方签到卡重复） */
const displayQuests = computed((): RpgQuest[] => {
	const list: RpgQuest[] = []
	for (let i = 0; i < quests.value.length; i++) {
		if (quests.value[i].kind != 'checkin') {
			list.push(quests.value[i])
		}
	}
	return list
})

/**
 * 同步 RPG 状态到本地 store 与 hero
 */
async function loadRpg(): Promise<void> {
	try {
		const h = await fetchRpgHero()
		hero.value = h
		store.diamonds.value = h.diamonds
		store.streakDays.value = h.streakDays
	} catch (_) {}

	try {
		const sign = await fetchSignInfo()
		store.checkedInToday.value = sign.signedToday
		if (sign.streakDays > 0) store.streakDays.value = sign.streakDays
		store.homeTodayTitle.value = sign.signedToday ? '今日已签到' : '今日待签到'
		store.homeStreakLabel.value = '连续 ' + store.streakDays.value + ' 天'
	} catch (_) {}

	try {
		quests.value = await fetchMyQuests()
	} catch (_) {
		quests.value = []
	}
}

/**
 * 下拉刷新冒险状态
 */
async function onRefresh(): Promise<void> {
	beginRefresh()
	await loadRpg()
	endRefresh(1, 1, 1)
}

onMounted(() => {
	onRefresh()
})

/** 每日签到 */
async function onCheckin(): Promise<void> {
	if (checkedInToday.value) {
		showXToast('pin', '今日已签到', '明天再来哦')
		return
	}
	try {
		await rpgSignIn()
		showXToast('sun', '签到成功', '')
		await loadRpg()
		store.homeTodayTitle.value = '已签到'
		store.homeStreakLabel.value = '连续 ' + store.streakDays.value + ' 天'
	} catch (_) {}
}

/**
 * 领取任务奖励：POST /rpg/quest/claim
 */
async function onClaim(questCode: string): Promise<void> {
	try {
		await claimQuest(questCode)
		showXToast('gift', '奖励已领取', '')
		await loadRpg()
	} catch (_) {}
}

/** 回首页读文章 */
function goHome(): void {
	goTab(TAB_HOME)
}

function goLottery(): void {
	uni.navigateTo({ url: '/pages-rpg/lottery/index' })
}

function goRank(): void {
	uni.navigateTo({ url: '/pages-rpg/rank/index' })
}

function goCalendar(): void {
	uni.navigateTo({ url: '/pages-rpg/calendar/index' })
}

function goRecharge(): void {
	uni.navigateTo({ url: '/pages-rpg/recharge/index' })
}

/** 进背包装扮页 */
function onBag(): void {
	uni.navigateTo({ url: '/pages-rpg/backpack/index' })
}
</script>

<style>
@import '../../styles/x-base.css';

.status-pad {
	height: 48px;
}

.head-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.rpg-hero {
	background-color: #2d6b5c;
	border-radius: 22px;
	padding: 16px;
	margin-bottom: 12px;
}

.hero-label {
	font-size: 12px;
	color: rgba(255, 255, 255, 0.78);
	margin-bottom: 4px;
}

.hero-lv {
	font-size: 18px;
	font-weight: 700;
	color: var(--x-on-ink, #ffffff);
	margin-bottom: 10px;
	line-height: 1.3;
}

.bar {
	height: 8px;
	background-color: rgba(255, 255, 255, 0.2);
	border-radius: 999px;
	overflow: hidden;
	margin-bottom: 6px;
}

.bar-i {
	height: 8px;
	background-color: var(--x-warm, #f6d9a8);
	border-radius: 999px;
}

.bal-row {
	flex-direction: row;
	margin-top: 6px;
}

.bal {
	flex-direction: row;
	align-items: center;
	margin-right: 14px;
}

.bal-t {
	font-size: 11px;
	color: rgba(255, 255, 255, 0.9);
	margin-left: 4px;
}

.quest {
	flex-direction: row;
	align-items: center;
}

.q-icon {
	width: 42px;
	height: 42px;
	border-radius: 14px;
	background-color: var(--x-accent-tint, rgba(61, 184, 154, 0.12));
	align-items: center;
	justify-content: center;
	margin-right: 12px;
}

.q-icon.peach {
	background-color: rgba(240, 160, 122, 0.16);
}

.q-icon.done {
	background-color: rgba(61, 184, 154, 0.22);
}

.q-body {
	flex: 1;
}

.q-title {
	font-size: 13px;
	font-weight: 650;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 2px;
}

.q-desc {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.disabled {
	opacity: 0.55;
}

.recharge-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 2px 20px;
}

.recharge-tip {
	font-size: 13px;
	color: var(--x-ink-2, #5c574f);
}
</style>
