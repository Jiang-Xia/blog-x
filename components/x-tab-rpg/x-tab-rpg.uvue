.status-pad {
	height: 48px;
}

.head-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.rpg-hero {
	background-color: #2d6b5c;
	border-radius: 22px;
	padding: 16px;
	margin-bottom: 12px;
}

.hero-label {
	font-size: 12px;
	color: rgba(255, 255, 255, 0.78);
	margin-bottom: 4px;
}

.hero-lv {
	font-size: 18px;
	font-weight: 700;
	color: #ffffff;
	margin-bottom: 10px;
	line-height: 1.3;
}

.bar {
	height: 8px;
	background-color: rgba(255, 255, 255, 0.2);
	border-radius: 999px;
	overflow: hidden;
	margin-bottom: 6px;
}

.bar-i {
	height: 8px;
	background-color: #f6d9a8;
	border-radius: 999px;
}

.bal-row {
	flex-direction: row;
	margin-top: 6px;
}

.bal {
	font-size: 11px;
	color: rgba(255, 255, 255, 0.9);
	margin-right: 14px;
}

.quest {
	flex-direction: row;
	align-items: center;
}

.q-icon {
	width: 42px;
	height: 42px;
	border-radius: 14px;
	background-color: rgba(61, 184, 154, 0.12);
	align-items: center;
	justify-content: center;
	margin-right: 12px;
}

.q-icon.peach {
	background-color: rgba(240, 160, 122, 0.16);
}

.q-icon.done {
	background-color: rgba(61, 184, 154, 0.22);
}

.q-body {
	flex: 1;
}

.q-title {
	font-size: 13px;
	font-weight: 650;
	color: #1c1a17;
	margin-bottom: 2px;
}

.q-desc {
	font-size: 11px;
	color: #9a948a;
}

.disabled {
	opacity: 0.55;
}

.recharge-row {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 2px 20px;
}

.recharge-tip {
	font-size: 13px;
	color: #5c574f;
}
</style>
