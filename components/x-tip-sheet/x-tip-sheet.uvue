<template>
	<!-- 打赏底部 Sheet：SKU + 微信支付（示意） -->
	<view v-if="open" class="x-sheet-mask" @click="onMask">
		<view class="x-sheet" @click.stop="noop">
			<view class="x-sheet-handle"></view>
			<text class="x-sheet-title">请作者喝杯咖啡</text>
			<text class="x-sheet-desc">支持创作 · RPG 钻石加油 / 砸蛋 / 送花（示意）</text>
			<view class="x-pack">
				<view
					v-for="sku in skus"
					:key="sku.id"
					:class="sku.id === selectedId ? 'x-sku x-sku-on' : 'x-sku'"
					@click="selectSku(sku.id)"
				>
					<text class="x-sku-strong">{{ sku.label }}</text>
					<text class="x-sku-span">{{ sku.desc }}</text>
				</view>
			</view>
			<view class="x-wx-btn" @click="onPay">
				<text class="x-wx-btn-text">微信支付</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 打赏 Sheet：纯前端示意，支付成功仅 toast
 * 数据：mock tipSkus
 */
import { tipSkus } from '../../mock/data'
import { showXToast } from '../../utils/toast'

const props = defineProps({
	open: { type: Boolean, default: false },
})

const emit = defineEmits(['close', 'paid'])

const skus = tipSkus
const selectedId = ref('6.66')

/**
 * 阻止点击穿透到遮罩
 */
function noop(): void {}

/**
 * 选中 SKU
 */
function selectSku(id: string): void {
	selectedId.value = id
}

/**
 * 点击遮罩关闭
 */
function onMask(): void {
	emit('close')
}

/**
 * 支付成功：抛出 paid 由详情页调 tipArticle；文案仍示意
 */
function onPay(): void {
	emit('paid')
	emit('close')
	showXToast('☕', '打赏成功', '已提交')
}
</script>

<style>
