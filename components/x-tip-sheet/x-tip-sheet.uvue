<template>
	<!-- 打赏 Sheet：钻石 tipArticle / 站点赞赏 createSiteTip -->
	<view v-if="open" class="x-sheet-mask" @click="onMask">
		<view class="x-sheet" @click.stop="noop">
			<view class="x-sheet-handle"></view>
			<text class="x-sheet-title">请作者喝杯咖啡</text>
			<view class="mode-row">
				<view
					:class="mode == 'diamond' ? 'mode-chip mode-on' : 'mode-chip'"
					@click="setModeDiamond"
				>
					<text :class="mode == 'diamond' ? 'mode-t mode-t-on' : 'mode-t'">钻石打赏</text>
				</view>
				<view
					:class="mode == 'site' ? 'mode-chip mode-on' : 'mode-chip'"
					@click="setModeSite"
				>
					<text :class="mode == 'site' ? 'mode-t mode-t-on' : 'mode-t'">站点赞赏</text>
				</view>
			</view>
			<text class="x-sheet-desc">{{ modeDesc }}</text>
			<view class="x-pack">
				<view
					v-for="sku in currentSkus"
					:key="sku.id"
					:class="sku.id === selectedId ? 'x-sku x-sku-on' : 'x-sku'"
					@click="selectSku(sku.id)"
				>
					<text class="x-sku-strong">{{ sku.label }}</text>
					<text class="x-sku-span">{{ sku.desc }}</text>
				</view>
			</view>
			<view class="x-wx-btn" :class="paying ? 'btn-disabled' : ''" @click="onPay">
				<text class="x-wx-btn-text">{{ payBtnText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 打赏 Sheet：钻石 → paid(amount)；站点赞赏 → createSiteTip + 轮询 status
 * 数据：本地打赏档位；联调 tipArticle / site/tip/*
 */
import { createSiteTip, getSiteTipStatus } from '../../api/modules/interact'
import { showXToast } from '../../utils/toast'

const props = defineProps({
	open: { type: Boolean, default: false },
})

const emit = defineEmits(['close', 'paid'])

const tipDiamondSkus = [
	{ id: '1', amount: 1, label: '1 钻', desc: '鼓励一下' },
	{ id: '5', amount: 5, label: '5 钻', desc: '加油' },
	{ id: '10', amount: 10, label: '10 钻', desc: '送花' },
	{ id: '50', amount: 50, label: '50 钻', desc: '砸蛋礼' },
]

const tipSiteSkus = [
	{ id: '6.66', amountYuan: 6.66, label: '¥6.66', desc: '咖啡' },
	{ id: '16.66', amountYuan: 16.66, label: '¥16.66', desc: '奶茶' },
	{ id: '26.66', amountYuan: 26.66, label: '¥26.66', desc: '午餐' },
	{ id: '66.66', amountYuan: 66.66, label: '¥66.66', desc: '大餐' },
]

const mode = ref('diamond')
const selectedId = ref('5')
const paying = ref(false)

type SkuRow = { id: string; label: string; desc: string; amount?: number; amountYuan?: number }

const currentSkus = computed((): SkuRow[] => {
	if (mode.value == 'site') {
		const list: SkuRow[] = []
		for (let i = 0; i < tipSiteSkus.length; i++) {
			const s = tipSiteSkus[i]
			list.push({ id: s.id, label: s.label, desc: s.desc, amountYuan: s.amountYuan })
		}
		return list
	}
	const list: SkuRow[] = []
	for (let i = 0; i < tipDiamondSkus.length; i++) {
		const s = tipDiamondSkus[i]
		list.push({ id: s.id, label: s.label, desc: s.desc, amount: s.amount })
	}
	return list
})

const modeDesc = computed((): string => {
	return mode.value == 'site'
		? '支付宝赞赏站点（不发钻）；下单后打开支付链接'
		: '消耗 RPG 钻石打赏作者（≥1）'
})

const payBtnText = computed((): string => {
	if (paying.value) return '处理中…'
	return mode.value == 'site' ? '支付宝赞赏' : '钻石打赏'
})

/**
 * 阻止点击穿透到遮罩
 */
function noop(): void {}

/** 切到钻石打赏 */
function setModeDiamond(): void {
	mode.value = 'diamond'
	selectedId.value = '5'
}

/** 切到站点赞赏 */
function setModeSite(): void {
	mode.value = 'site'
	selectedId.value = '6.66'
}

/**
 * 选中 SKU
 */
function selectSku(id: string): void {
	selectedId.value = id
}

/**
 * 点击遮罩关闭
 */
function onMask(): void {
	if (paying.value) return
	emit('close')
}

/**
 * 查找当前选中 SKU
 */
function findSelected(): SkuRow | null {
	const list = currentSkus.value
	for (let i = 0; i < list.length; i++) {
		if (list[i].id === selectedId.value) return list[i]
	}
	return null
}

/**
 * 轮询站点赞赏到账
 */
function pollSiteTip(outTradeNo: string, left: number): void {
	if (left <= 0) {
		paying.value = false
		showXToast('hourglass', '支付处理中', '稍后可在关于页流水查看')
		emit('close')
		return
	}
	getSiteTipStatus(outTradeNo)
		.then((res) => {
			const status = res != null && res.status != null ? '' + res.status : ''
			if (status == 'PAID' || status == 'paid') {
				paying.value = false
				showXToast('coffee', '赞赏成功', '感谢支持')
				emit('close')
				return
			}
			if (status.length > 0 && status != 'PENDING' && status != 'pending') {
				paying.value = false
				showXToast('circle-x', '支付未完成', status)
				return
			}
			setTimeout(() => {
				pollSiteTip(outTradeNo, left - 1)
			}, 2500)
		})
		.catch(() => {
			setTimeout(() => {
				pollSiteTip(outTradeNo, left - 1)
			}, 2500)
		})
}

/**
 * 提交：钻石抛 paid；站点赞赏建单
 */
async function onPay(): Promise<void> {
	const sku = findSelected()
	if (sku == null || paying.value) return

	if (mode.value == 'diamond') {
		const amount = sku.amount != null ? sku.amount : 1
		emit('paid', amount)
		emit('close')
		return
	}

	// 站点赞赏
	const yuan = sku.amountYuan != null ? sku.amountYuan : 6.66
	paying.value = true
	try {
		const res = await createSiteTip({
			amountYuan: yuan,
			displayName: '匿名用户',
			message: '请作者喝杯咖啡！',
		})
		const outTradeNo =
			res != null && res.outTradeNo != null
				? '' + res.outTradeNo
				: res != null && res.out_trade_no != null
					? '' + res.out_trade_no
					: ''
		const link =
			res != null && res.universalLink != null
				? '' + res.universalLink
				: res != null && res.scheme != null
					? '' + res.scheme
					: ''
		if (outTradeNo.length == 0) {
			paying.value = false
			showXToast('circle-x', '下单失败', '')
			return
		}
		if (link.length > 0) {
			// uni-app x 各端统一复制链接，避免 plus/window 条件编译差异
			uni.setClipboardData({
				data: link,
				success: () => {
					showXToast('clipboard', '支付链接已复制', '请在浏览器打开完成支付')
				},
			})
		}
		pollSiteTip(outTradeNo, 24)
	} catch (_) {
		paying.value = false
	}
}
</script>

<style>
.x-sheet-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(28, 26, 23, 0.32);
	z-index: 100;
	justify-content: flex-end;
}

.x-sheet {
	background-color: var(--x-surface, #ffffff);
	border-radius: 24px 24px 0 0;
	padding: 12px 16px 28px;
}

.x-sheet-handle {
	width: 36px;
	height: 4px;
	border-radius: 2px;
	background-color: var(--x-bg-2, #ebe6df);
	align-self: center;
	margin-bottom: 12px;
}

.x-sheet-title {
	font-size: 16px;
	font-weight: 700;
	color: var(--x-ink, #1c1a17);
	margin-bottom: 8px;
}

.mode-row {
	flex-direction: row;
	margin-bottom: 8px;
}

.mode-chip {
	padding: 6px 12px;
	border-radius: 999px;
	background-color: var(--x-bg-2, #ebe6df);
	margin-right: 8px;
}

.mode-on {
	background-color: rgba(61, 184, 154, 0.18);
}

.mode-t {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	font-weight: 500;
}

.mode-t-on {
	color: var(--x-accent-deep, #2a8f76);
	font-weight: 650;
}

.x-sheet-desc {
	font-size: 12px;
	color: var(--x-ink-2, #5c574f);
	margin-bottom: 12px;
	line-height: 1.45;
}

.x-pack {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	margin-bottom: 14px;
}

.x-sku {
	width: 48%;
	border-radius: 16px;
	padding: 12px;
	background-color: var(--x-surface, #ffffff);
	border-width: 1.5px;
	border-style: solid;
	border-color: var(--x-bg-2, #ebe6df);
	margin-bottom: 8px;
}

.x-sku-on {
	border-color: var(--x-accent, #3db89a);
	background-color: rgba(61, 184, 154, 0.08);
}

.x-sku-strong {
	font-size: 16px;
	color: var(--x-ink, #1c1a17);
	font-weight: 600;
	margin-bottom: 2px;
}

.x-sku-span {
	font-size: 11px;
	color: var(--x-ink-3, #9a948a);
}

.x-wx-btn {
	background-color: var(--x-accent, #3db89a);
	border-radius: 999px;
	padding: 13px;
	align-items: center;
	justify-content: center;
}

.btn-disabled {
	opacity: 0.55;
}

.x-wx-btn-text {
	font-size: 14px;
	font-weight: 600;
	color: var(--x-on-ink, #ffffff);
}
</style>
