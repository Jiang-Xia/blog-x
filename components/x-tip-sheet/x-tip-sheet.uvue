	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(28, 26, 23, 0.32);
	z-index: 100;
	justify-content: flex-end;
}

.x-sheet {
	background-color: #ffffff;
	border-radius: 24px 24px 0 0;
	padding: 12px 16px 28px;
}

.x-sheet-handle {
	width: 36px;
	height: 4px;
	border-radius: 2px;
	background-color: #ebe6df;
	align-self: center;
	margin-bottom: 12px;
}

.x-sheet-title {
	font-size: 16px;
	font-weight: 700;
	color: #1c1a17;
	margin-bottom: 4px;
}

.x-sheet-desc {
	font-size: 12px;
	color: #5c574f;
	margin-bottom: 12px;
	line-height: 1.45;
}

.x-pack {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	margin-bottom: 14px;
}

.x-sku {
	width: 48%;
	border-radius: 16px;
	padding: 12px;
	background-color: #ffffff;
	border-width: 1.5px;
	border-style: solid;
	border-color: #ebe6df;
	margin-bottom: 8px;
}

.x-sku-on {
	border-color: #3db89a;
	background-color: rgba(61, 184, 154, 0.08);
}

.x-sku-strong {
	font-size: 16px;
	color: #1c1a17;
	font-weight: 600;
	margin-bottom: 2px;
}

.x-sku-span {
	font-size: 11px;
	color: #9a948a;
}

.x-wx-btn {
	background-color: #07c160;
	border-radius: 999px;
	padding: 13px;
	align-items: center;
	justify-content: center;
}

.x-wx-btn-text {
	font-size: 14px;
	font-weight: 600;
	color: #ffffff;
}
</style>
