<template>
	<!-- 空状态：x-icon + 文案 + 可选操作按钮 -->
	<view class="x-empty">
		<view class="x-empty-ico">
			<x-icon :name="icon" :size="40" color="#9a948a"></x-icon>
		</view>
		<text class="x-empty-text">{{ text }}</text>
		<view v-if="actionText.length > 0" class="x-empty-btn" @click="onAction">
			<text class="x-empty-btn-text">{{ actionText }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 空状态展示组件
 */
defineProps({
	/** Tabler 图标名 */
	icon: { type: String, default: 'mailbox' },
	text: { type: String, default: '暂无内容' },
	actionText: { type: String, default: '' },
})

const emit = defineEmits(['action'])

/**
 * 点击操作按钮
 */
function onAction(): void {
	emit('action')
}
</script>

<style>
.x-empty {
	align-items: center;
	padding: 48px 12px;
}

.x-empty-ico {
	margin-bottom: 10px;
	align-items: center;
	justify-content: center;
}

.x-empty-text {
	font-size: 13px;
	color: var(--x-ink-3, #9a948a);
	line-height: 1.55;
	text-align: center;
	margin-bottom: 16px;
}

.x-empty-btn {
	background-color: var(--x-accent, #3db89a);
	border-radius: 999px;
	padding: 10px 20px;
}

.x-empty-btn-text {
	font-size: 13px;
	color: var(--x-on-ink, #ffffff);
	font-weight: 600;
}
</style>
